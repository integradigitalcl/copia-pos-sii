    private async Task RegisterCashMovement(string type, string title)
    {
        var rawAmount = await JS.InvokeAsync<string?>("prompt", title, "Ingrese el monto:");
        if (string.IsNullOrWhiteSpace(rawAmount))
            return;
        var rawDescription = await JS.InvokeAsync<string?>("prompt", type == "INGRESO" ? "Comentarios:" : "Razón o proveedor:", title);
        var normalized = rawAmount.Trim().Replace("$", "").Replace(".", "").Replace(",", ".");
        if (!decimal.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out var amount) || amount <= 0)
        {
            Pos.ShowError("Monto inválido.");
            return;
        }
        await Pos.RegisterCashMovementAsync(type, amount, rawDescription ?? string.Empty);
    }
    private static string PaymentIcon(string method) => method switch
    {
        "Efectivo" => "▣", "Tarjeta" => "▤", "Mixto" => "◈", _ => "◇"
    };
    /// <summary>Enter cobra e imprime; ESC cancela; flechas cambian método de pago. Se ignora si ya hay un cobro en curso.</summary>
    private Task HandleCheckoutKey(KeyboardEventArgs args)
    {
        if (args.Repeat || Pos.IsCheckoutBusy)
            return Task.CompletedTask;

        if (args.Key is "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown")
        {
            NavigateCheckoutPaymentMethod(args.Key);
            return Task.CompletedTask;
        }

        if (args.Key == "Enter")
            return CompleteSale("print");

        if (args.Key == "Escape")
        {
            CancelCheckout();
            return Task.CompletedTask;
        }

        return Task.CompletedTask;
    }

    private void NavigateCheckoutPaymentMethod(string key)
    {
        var methods = AvailablePaymentMethods.ToList();
        if (methods.Count == 0)
            return;

        var idx = methods.FindIndex(m => string.Equals(m, Pos.SelectedPaymentMethod, StringComparison.OrdinalIgnoreCase));
        if (idx < 0)
            idx = 0;

        var delta = key is "ArrowRight" or "ArrowDown" ? 1 : -1;
        idx = (idx + delta + methods.Count) % methods.Count;
        Pos.SelectPaymentMethod(methods[idx]);
    }

    [JSInvokable]
    public Task NavigatePromoSuggestionsFromKeyboard(string key) =>
        NavigatePromoSuggestionsWithArrowsAsync(key);

    [JSInvokable]
    public Task NavigateInventorySuggestionsFromKeyboard(string key) =>
        NavigateInventorySuggestionsWithArrowsAsync(key);

    [JSInvokable]
    public Task NavigateProductCatalogFromKeyboard(string key) =>
        NavigateProductCatalogWithArrowsAsync(key);

    [JSInvokable]
    public Task HandleKeyboardShortcut(string key)
    {
        // Con un cobro en curso los atajos quedan inertes para no duplicar la venta.
        if (Pos.IsCheckoutBusy)
            return Task.CompletedTask;

        switch (key)
        {
            case "Enter":
                if (Pos.IsCheckoutOpen)
                    return CompleteSale("print");
                return Task.CompletedTask;
            case "F1":
                if (Pos.IsCheckoutOpen)
                    return CompleteSale("print");
                SelectSection("Ventas");
                return Task.CompletedTask;
            case "F2":
                if (Pos.IsCheckoutOpen)
                    return CompleteSale("no-print");
                return Task.CompletedTask;
            case "F3":
                if (Pos.IsCheckoutOpen)
                    return CompleteSale("personal");
                SelectSection("Productos");
                return Task.CompletedTask;
            case "F4":
                SelectSection("Inventario");
                return Task.CompletedTask;
            case "F7":
                return ShowEntries();
            case "F8":
                return ShowExits();
            case "F10":
                if (ProductEditorOverlayOpen)
                {
                    CloseProductEditorOverlay();
                    return Task.CompletedTask;
                }
                if (ProductSearchModalOpen)
                {
                    CloseProductSearchModal();
                    return Task.CompletedTask;
                }
                return OpenProductSearchModalAsync();
            case "F11":
                ToggleWholesale();
                return Task.CompletedTask;
            case "F12":
                Pos.OpenCheckout();
                return Task.CompletedTask;
            case "Escape":
                if (DiscountOpen)
                {
                    CloseDiscount();
                    return Task.CompletedTask;
                }
                if (CommonProductOpen)
                {
                    CloseCommonProduct();
                    return Task.CompletedTask;
                }
                if (ProductEditorOverlayOpen)
                {
                    CloseProductEditorOverlay();
                    return Task.CompletedTask;
                }
                if (ProductSearchModalOpen)
                {
                    CloseProductSearchModal();
                    return Task.CompletedTask;
                }
                CancelCheckout();
                return Task.CompletedTask;
            case "ArrowLeft":
            case "ArrowRight":
            case "ArrowUp":
            case "ArrowDown":
                if (Pos.IsCheckoutOpen)
                {
                    NavigateCheckoutPaymentMethod(key);
                    return Task.CompletedTask;
                }
                if (key is "ArrowUp" or "ArrowDown")
                {
                    if (ActiveSection == "Inventario")
                        return NavigateInventoryListWithArrowsAsync(key);
                    if (ActiveSection == "Productos" && !ProductSearchModalOpen)
                        return NavigateProductCatalogWithArrowsAsync(key);
                    if (ProductSearchModalOpen && !ProductEditorOverlayOpen && !ProductQuickEditOpen)
                        return HandleProductSearchModalKey(new KeyboardEventArgs { Key = key });
                    return NavigateSalesCartWithArrowsAsync(key);
                }
                return Task.CompletedTask;
            case "Delete":
                Pos.DeleteSelectedLine();
                return Task.CompletedTask;
            case "+":
            case "Add":
                Pos.ChangeSelectedQuantity(1);
                return Task.CompletedTask;
            case "-":
            case "Subtract":
                Pos.ChangeSelectedQuantity(-1);
                return Task.CompletedTask;
            default:
                return Task.CompletedTask;
        }
    }
    private void SetTimedNotice(Action<string> set, Func<string> get, ref CancellationTokenSource? cts, string? value, int seconds = 3)
    {
        set(value ?? string.Empty);
        try { cts?.Cancel(); }
        catch (ObjectDisposedException) { }
        try { cts?.Dispose(); }
        catch (ObjectDisposedException) { }
        cts = null;

        if (string.IsNullOrWhiteSpace(get()))
            return;

        var tokenSource = new CancellationTokenSource();
        cts = tokenSource;
        var snapshot = get();
        _ = DismissTimedNoticeAsync(tokenSource, () =>
        {
            if (get() == snapshot)
                set(string.Empty);
        }, seconds);
    }

    private async Task DismissTimedNoticeAsync(CancellationTokenSource tokenSource, Action clear, int seconds)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(seconds), tokenSource.Token);
            await InvokeAsync(() =>
            {
                clear();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            try { tokenSource.Dispose(); }
            catch (ObjectDisposedException) { }
        }
    }

    public void Dispose()
    {
        Pos.Changed -= OnStateChanged;
        _ = JS.InvokeVoidAsync("grunflexKeyboard.unregister");
        KeyboardReference?.Dispose();
        try { _quickEditNoticeCts?.Cancel(); _quickEditNoticeCts?.Dispose(); } catch { }
        try { _configurationNoticeCts?.Cancel(); _configurationNoticeCts?.Dispose(); } catch { }
        try { _inventoryNoticeCts?.Cancel(); _inventoryNoticeCts?.Dispose(); } catch { }
        try { _productNoticeCts?.Cancel(); _productNoticeCts?.Dispose(); } catch { }
        try { _reportNoticeCts?.Cancel(); _reportNoticeCts?.Dispose(); } catch { }
    }
}

@* Reusable tables are kept in this page so the local shell has no external UI dependency. *@
