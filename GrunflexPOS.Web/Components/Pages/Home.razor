    /// <summary>
    /// Flechas en ventas: cajón de código ↔ filas del carrito.
    /// </summary>
    private async Task NavigateSalesCartWithArrowsAsync(string key)
    {
        if (ActiveSection != "Ventas" || Pos.IsCheckoutOpen || ProductSearchModalOpen || ProductEditorOverlayOpen)
            return;

        var cart = Pos.Cart.ToList();
        if (cart.Count == 0)
        {
            await FocusSaleSearch();
            return;
        }

        var idx = cart.FindIndex(line => ReferenceEquals(line, Pos.SelectedLine));
        if (key == "ArrowDown")
        {
            if (idx < 0)
                Pos.SelectLine(cart[0]);
            else if (idx < cart.Count - 1)
                Pos.SelectLine(cart[idx + 1]);
            await BlurSaleSearch();
            return;
        }

        if (key == "ArrowUp")
        {
            if (idx <= 0)
            {
                await FocusSaleSearch();
                return;
            }

            Pos.SelectLine(cart[idx - 1]);
            await BlurSaleSearch();
        }
