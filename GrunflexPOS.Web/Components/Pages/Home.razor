    private async Task ExportInventoryAsync()
    {
        using var workbook = new XLWorkbook();
        var sheet = workbook.Worksheets.Add("Inventario");
        var headers = new[] { "ID", "Código", "Producto", "P. Costo", "P. Venta", "P. Mayoreo",
            "Departamento", "Existencia", "Inv. Mínimo", "Inv. Máximo", "Tipo de venta" };
        for (var column = 0; column < headers.Length; column++)
            sheet.Cell(1, column + 1).Value = headers[column];
        var row = 2;
        foreach (var product in InventoryFilteredProducts)
        {
            sheet.Cell(row, 1).Value = product.Id;
            sheet.Cell(row, 2).Value = product.Code;
            sheet.Cell(row, 3).Value = product.Name;
            sheet.Cell(row, 4).Value = product.Cost;
            sheet.Cell(row, 5).Value = product.Price;
            sheet.Cell(row, 6).Value = product.WholesalePrice;
            sheet.Cell(row, 7).Value = product.Department;
            sheet.Cell(row, 8).Value = product.Stock;
            sheet.Cell(row, 9).Value = product.MinStock;
            sheet.Cell(row, 10).Value = product.MaxStock;
            sheet.Cell(row, 11).Value = product.SaleType;
            row++;
        }
        sheet.Columns().AdjustToContents();
        using var output = new MemoryStream();
        workbook.SaveAs(output);
        await DownloadBytesAsync($"inventario_{DateTime.Now:yyyyMMdd_HHmm}.xlsx",
            output.ToArray(), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private async Task ImportInventoryAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
            return;
        try
        {
            var updated = 0;
            if (file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                await using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                using var workbook = new XLWorkbook(memory);
                var sheet = workbook.Worksheets.FirstOrDefault();
                if (sheet is not null)
                {
                    var lastColumn = Math.Min(sheet.LastColumnUsed()?.ColumnNumber() ?? 1, 40);
                    var hasHeader = InventoryRowLooksLikeHeader(sheet, lastColumn);
                    var columns = DetectInventoryColumns(sheet, hasHeader ? 1 : 0, lastColumn);
                    var firstDataRow = hasHeader ? 2 : 1;
                    var lastRow = sheet.LastRowUsed()?.RowNumber() ?? 0;
                    for (var rowNumber = firstDataRow; rowNumber <= lastRow; rowNumber++)
                    {
                        var row = sheet.Row(rowNumber);
                        var imported = new InventoryImportRow(
                            ExcelCellText(row.Cell(columns.Code + 1)),
                            ExcelCellText(row.Cell(columns.Quantity + 1)),
                            columns.Name is int name ? ExcelCellText(row.Cell(name + 1)) : null,
                            columns.Cost is int cost ? ParseInventoryDecimal(ExcelCellText(row.Cell(cost + 1))) : null,
                            columns.Price is int price ? ParseInventoryDecimal(ExcelCellText(row.Cell(price + 1))) : null,
                            columns.Wholesale is int wholesale ? ParseInventoryDecimal(ExcelCellText(row.Cell(wholesale + 1))) : null,
                            columns.MinStock is int min ? ParseInventoryDecimal(ExcelCellText(row.Cell(min + 1))) : null,
                            columns.MaxStock is int max ? ParseInventoryDecimal(ExcelCellText(row.Cell(max + 1))) : null,
                            columns.Department is int department ? ExcelCellText(row.Cell(department + 1)) : null,
                            columns.SaleType is int saleType ? ExcelCellText(row.Cell(saleType + 1)) : null);
                        if (await ApplyImportedRowAsync(imported))
                            updated++;
                    }
                }
            }
            else
            {
                await using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var reader = new StreamReader(stream);
                var lines = new List<string>();
                while (await reader.ReadLineAsync() is { } line)
                    lines.Add(line);
                var first = lines.FirstOrDefault();
                var hasHeader = first is not null && first.Contains("codigo", StringComparison.OrdinalIgnoreCase);
                var columns = DetectInventoryColumns((first ?? string.Empty).Split(';', ','), hasHeader);
                foreach (var line in lines.Skip(hasHeader ? 1 : 0))
                {
                    var cells = line.Split(';', ',');
                    if (cells.Length <= Math.Max(columns.Code, columns.Quantity))
                        continue;
                    var imported = new InventoryImportRow(
                        CsvColumn(cells, columns.Code), CsvColumn(cells, columns.Quantity),
                        CsvOptionalColumn(cells, columns.Name), CsvDecimalColumn(cells, columns.Cost),
                        CsvDecimalColumn(cells, columns.Price), CsvDecimalColumn(cells, columns.Wholesale),
                        CsvDecimalColumn(cells, columns.MinStock), CsvDecimalColumn(cells, columns.MaxStock),
                        CsvOptionalColumn(cells, columns.Department), CsvOptionalColumn(cells, columns.SaleType));
                    if (await ApplyImportedRowAsync(imported))
                        updated++;
                }
            }
            InventoryNotice = updated == 0
                ? $"No se actualizaron productos desde {file.Name}. Revisa que tenga las columnas Código y Existencia (o Cantidad)."
                : $"{updated} productos actualizados desde {file.Name}.";
            await LoadInventoryHistoryAsync();
        }
        catch (Exception ex)
        {
            InventoryNotice = $"No se pudo importar el archivo: {ex.Message}";
        }
    }

    private async Task<bool> ApplyImportedRowAsync(InventoryImportRow row)
    {
        var code = row.Code.Trim().Trim('"');
        if (!TryParseInventoryQuantity(row.Quantity, out var quantity) || quantity == 0)
            return false;
        var product = Pos.Products.FirstOrDefault(p => p.Code.Equals(code, StringComparison.OrdinalIgnoreCase));
        if (product is null && int.TryParse(code, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
            product = Pos.Products.FirstOrDefault(p => p.Id == id);
        if (product is null)
        {
            var created = await ConfigStore.CreateImportedInventoryProductAsync(code, quantity, row.Name,
                row.Cost, row.Price, row.Wholesale, row.MinStock, row.MaxStock, row.Department, row.SaleType);
            if (created)
                await Pos.RefreshAsync();
            return created;
        }
        await Pos.AdjustStockAsync(product, quantity);
        await ConfigStore.UpdateInventoryMetadataAsync(product.Id, row.Name, row.Cost, row.Price,
            row.Wholesale, row.MinStock, row.MaxStock, row.Department, row.SaleType);
        return true;
    }

    private static bool TryParseInventoryQuantity(string value, out decimal quantity)
    {
        value = value.Trim().Trim('"').Replace("$", "").Replace(" ", "").Replace(",", ".");
        return decimal.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out quantity) ||
               decimal.TryParse(value, NumberStyles.Any, new CultureInfo("es-CL"), out quantity);
    }

    private static decimal? ParseInventoryDecimal(string value) =>
        TryParseInventoryQuantity(value, out var quantity) ? quantity : null;

    private static string ExcelCellText(IXLCell cell)
    {
        var value = cell.Value;
        if (value.IsBlank || value.IsError || value.IsDateTime || value.IsTimeSpan)
            return string.Empty;
        if (value.IsNumber)
        {
            var number = value.GetNumber();
            return Math.Abs(number - Math.Round(number)) < 1e-9
                ? ((long)Math.Round(number)).ToString(CultureInfo.InvariantCulture)
                : number.ToString(CultureInfo.InvariantCulture);
        }
        return value.IsText ? value.GetText().Trim() : value.ToString().Trim();
    }

    private static bool InventoryRowLooksLikeHeader(IXLWorksheet sheet, int lastColumn) =>
        Enumerable.Range(1, lastColumn).Any(column => IsInventoryHeader(ExcelCellText(sheet.Cell(1, column))));

    private static bool IsInventoryHeader(string value)
    {
        var header = NormalizeInventoryHeader(value);
        return header.Contains("codigo") || header.Contains("barras") || header.Contains("sku") ||
               header.Contains("producto") || header.Contains("nombre") || header.Contains("exist") ||
               header.Contains("stock") || header.Contains("cant") || header.Contains("invent");
    }

    private static InventoryImportColumns DetectInventoryColumns(IXLWorksheet sheet, int headerRow, int lastColumn)
    {
        var headers = headerRow == 0
            ? Array.Empty<string>()
            : Enumerable.Range(1, lastColumn).Select(column => ExcelCellText(sheet.Cell(headerRow, column))).ToArray();
        return DetectInventoryColumns(headers, headerRow > 0);
    }

    private static InventoryImportColumns DetectInventoryColumns(string[] headers, bool hasHeader)
    {
        if (!hasHeader || headers.Length == 0)
            return new(0, 1, null, null, null, null, null, null, null, null);
        var normalized = headers.Select(NormalizeInventoryHeader).ToArray();
        var code = FindColumn(normalized, header => header.Contains("codigo") || header.Contains("barras") ||
            header == "sku" || header.Contains("ean") || header.Contains("upc") || header.Contains("referencia")) ?? 0;
        var quantity = FindColumn(normalized, header => header.Contains("exist") || header.Contains("stock") ||
            header.Contains("cant") || header.Contains("invent") || header.Contains("ajuste") || header.Contains("saldo")) ?? 1;
        return new(code, quantity,
            FindColumn(normalized, header => header.Contains("nombre") || header.Contains("producto")),
            FindColumn(normalized, header => header.Contains("costo") || header.Contains("coste")),
            FindColumn(normalized, header => header.Contains("venta") && !header.Contains("tipo") && !header.Contains("mayoreo")),
            FindColumn(normalized, header => header.Contains("mayoreo") || header.Contains("mayorista")),
            FindColumn(normalized, header => header.Contains("minimo") || (header.Contains("min") && header.Contains("inv"))),
            FindColumn(normalized, header => header.Contains("maximo") || (header.Contains("max") && header.Contains("inv"))),
            FindColumn(normalized, header => header.Contains("depart") || header.Contains("rubro") || header.Contains("familia")),
            FindColumn(normalized, header => header.Contains("tipo") && header.Contains("venta")));
    }

    private static int? FindColumn(string[] headers, Func<string, bool> predicate)
    {
        var index = Array.FindIndex(headers, header => !string.IsNullOrWhiteSpace(header) && predicate(header));
        return index >= 0 ? index : null;
    }

    private static string NormalizeInventoryHeader(string value) =>
        (value ?? string.Empty).Trim().ToLowerInvariant()
            .Replace("á", "a").Replace("é", "e").Replace("í", "i")
            .Replace("ó", "o").Replace("ú", "u").Replace("ñ", "n");

    private static string CsvColumn(string[] columns, int index) => columns[index].Trim().Trim('"');
    private static string? CsvOptionalColumn(string[] columns, int? index) =>
        index is int value && value < columns.Length ? CsvColumn(columns, value) : null;
    private static decimal? CsvDecimalColumn(string[] columns, int? index) =>
        index is int value && value < columns.Length ? ParseInventoryDecimal(CsvColumn(columns, value)) : null;

    private sealed record InventoryImportRow(string Code, string Quantity, string? Name,
        decimal? Cost, decimal? Price, decimal? Wholesale, decimal? MinStock, decimal? MaxStock,
        string? Department, string? SaleType);

    private sealed record InventoryImportColumns(int Code, int Quantity, int? Name,
        int? Cost, int? Price, int? Wholesale, int? MinStock, int? MaxStock,
        int? Department, int? SaleType);

    private async Task DownloadTextAsync(string filename, string content, string contentType)
    {
        var encoded = Convert.ToBase64String(Encoding.UTF8.GetBytes(content));
        await JS.InvokeVoidAsync("eval", $"const a=document.createElement('a');a.href='data:{contentType};base64,{encoded}';a.download='{filename}';a.click();");
    }

    private async Task DownloadBytesAsync(string filename, byte[] content, string contentType)
    {
        var encoded = Convert.ToBase64String(content);
        await JS.InvokeVoidAsync("eval", $"const a=document.createElement('a');a.href='data:{contentType};base64,{encoded}';a.download='{filename}';a.click();");
    }

    private static string Csv(string value) =>
        string.Concat("\"", (value ?? string.Empty).Replace("\"", "\"\""), "\"");

    private void HandleSearchInput(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString() ?? string.Empty;
        SuggestionIndex = -1;
    }
    private async Task HandleSaleKey(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowDown")
        {
            MoveSuggestion(1);
            return;
        }
        if (args.Key == "ArrowUp")
        {
            MoveSuggestion(-1);
            return;
        }
        if (args.Key == "Enter")
        {
            if (SuggestionIndex >= 0 && SuggestionIndex < CurrentSuggestions.Count)
            {
                await SelectSuggestedProduct(CurrentSuggestions[SuggestionIndex]);
                return;
            }
            await AddScannedProduct();
        }
    }
    private void MoveSuggestion(int direction)
    {
        if (CurrentSuggestions.Count == 0)
            return;
        SuggestionIndex = Math.Clamp(SuggestionIndex + direction, 0, CurrentSuggestions.Count - 1);
    }
    private async Task AddScannedProduct()
    {
        var value = SearchText.Trim();
        if (string.IsNullOrWhiteSpace(value))
            return;

        if (Pos.TryAddScaleLabelBarcode(value))
        {
            SearchText = string.Empty;
            SuggestionIndex = -1;
            await FocusSaleSearch();
            return;
        }

        var product = Pos.Products.FirstOrDefault(x => x.Code.Equals(value, StringComparison.OrdinalIgnoreCase))
            ?? Pos.Products.FirstOrDefault(x => x.Name.Equals(value, StringComparison.OrdinalIgnoreCase))
            ?? FilteredProducts.FirstOrDefault();
        if (product is null)
            Pos.ShowError($"No se encontró un producto para '{value}'.");
        else
        {
            Pos.AddProduct(product);
            SearchText = string.Empty;
            SuggestionIndex = -1;
        }
        await FocusSaleSearch();
    }
    private async Task SelectSuggestedProduct(PosProduct product)
    {
        Pos.AddProduct(product);
        SearchText = string.Empty;
        SuggestionIndex = -1;
        await FocusSaleSearch();
    }
    private async Task OpenServipag() => await JS.InvokeVoidAsync("open", string.IsNullOrWhiteSpace(ConfigServipagUrl) ? "https://portal.servipag.com/" : ConfigServipagUrl, "_blank");
    private async Task OpenSupport()
    {
        if (!Pos.LicenseOnlineSupport)
        {
            Pos.ShowError("Esta función requiere licencia con módulo Soporte en línea.");
            return;
        }
        SelectSection("Soporte");
        await JS.InvokeVoidAsync("open", "https://web.whatsapp.com/send?phone=56923999843", "_blank");
    }

    private async Task ActivateLicenseTokenAsync()
    {
        LicenseNotice = string.Empty;
        var token = LicenseTokenText.Trim();
        if (string.IsNullOrWhiteSpace(token))
        {
            LicenseNotice = "Pegue un token GFv2.";
            return;
        }

        var result = await LicensingCloud.ApplyTokenAsync(token, 0, CancellationToken.None);
        if (!result.Ok)
        {
            LicenseNotice = result.Message;
            return;
        }

        await License.RefreshAsync();
        await Pos.InitializeAsync();
        LicenseNotice = result.Message;
    }

    private async Task ActivateLicenseOnlineAsync()
    {
        LicenseNotice = string.Empty;
        var result = await LicensingCloud.ActivateAsync(LicenseActivationId);
        if (!result.Ok)
        {
            LicenseNotice = result.Message;
            return;
        }

        await License.RefreshAsync();
        await Pos.InitializeAsync();
        LicenseNotice = result.Message;
    }

    private async Task SyncLicenseAsync()
    {
        LicenseNotice = string.Empty;
        var result = await LicensingCloud.RefreshAsync(silent: false);
        if (!result.Ok)
        {
            LicenseNotice = result.Message;
            return;
        }

        await License.RefreshAsync();
        await Pos.InitializeAsync();
        LicenseNotice = result.Message;
    }

    private string LicenseModuleSummary()
    {
        var modules = new List<string>();
        if (License.Multicaja) modules.Add("Multicaja");
        if (License.OnlineSupport) modules.Add("Soporte");
        if (License.CloudBackup) modules.Add("Respaldo");
        if (License.PrioritySupport) modules.Add("Prioritario");
        return modules.Count == 0 ? "Ninguno" : string.Join(", ", modules);
    }

    private async Task UploadCloudBackupAsync()
    {
        LicenseNotice = string.Empty;
        var result = await CloudBackup.TryUploadOnceAsync();
        CloudBackupStatus = await CloudBackup.GetLastBackupStatusAsync();
        LicenseNotice = result.Message;
    }
    private void SetReceivedAmount(ChangeEventArgs args) => Pos.SetReceivedAmount(args.Value?.ToString() ?? string.Empty);
    private void SetMixedCash(ChangeEventArgs args) => Pos.SetMixedCash(args.Value?.ToString() ?? string.Empty);
    private void OnCheckoutEmitInvoice(ChangeEventArgs args) =>
        Pos.SetCheckoutEmitInvoice(args.Value is bool b && b || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase));
    private void OnCheckoutBuyerRut(ChangeEventArgs args) => Pos.SetCheckoutBuyerRut(args.Value?.ToString() ?? string.Empty);
    private void OnCheckoutBuyerName(ChangeEventArgs args) => Pos.SetCheckoutBuyerName(args.Value?.ToString() ?? string.Empty);
    private void OnCheckoutBuyerEmail(ChangeEventArgs args) => Pos.SetCheckoutBuyerEmail(args.Value?.ToString() ?? string.Empty);
    private void SetMixedCard(ChangeEventArgs args) => Pos.SetMixedCard(args.Value?.ToString() ?? string.Empty);
    private async Task RegisterCashMovement(string type, string title)
    {
        var rawAmount = await JS.InvokeAsync<string?>("prompt", title, "Ingrese el monto:");
        if (string.IsNullOrWhiteSpace(rawAmount))
            return;
        var rawDescription = await JS.InvokeAsync<string?>("prompt", type == "INGRESO" ? "Comentarios:" : "Razón o proveedor:", title);
        var normalized = rawAmount.Trim().Replace("$", "").Replace(".", "").Replace(",", ".");
        if (!decimal.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out var amount) || amount <= 0)
        {
            Pos.ShowError("Monto inválido.");
            return;
        }
        await Pos.RegisterCashMovementAsync(type, amount, rawDescription ?? string.Empty);
    }
    private static string PaymentIcon(string method) => method switch
    {
        "Efectivo" => "▣", "Tarjeta" => "▤", "Mixto" => "◈", _ => "◇"
    };
    [JSInvokable]
    public Task HandleKeyboardShortcut(string key)
    {
        switch (key)
        {
            case "F1":
                if (Pos.IsCheckoutOpen)
                    return CompleteSale("print");
                SelectSection("Ventas");
                return Task.CompletedTask;
            case "F2":
                if (Pos.IsCheckoutOpen)
                    return CompleteSale("no-print");
                return Task.CompletedTask;
            case "F3":
                if (Pos.IsCheckoutOpen)
                    return CompleteSale("personal");
                SelectSection("Productos");
                return Task.CompletedTask;
            case "F4":
                SelectSection("Inventario");
                return Task.CompletedTask;
            case "F7":
                return ShowEntries();
            case "F8":
                return ShowExits();
            case "F10":
                if (ProductEditorOverlayOpen)
                {
                    CloseProductEditorOverlay();
                    return Task.CompletedTask;
                }
                if (ProductSearchModalOpen)
                {
                    CloseProductSearchModal();
                    return Task.CompletedTask;
                }
                return OpenProductSearchModalAsync();
            case "F11":
                ToggleWholesale();
                return Task.CompletedTask;
            case "F12":
                Pos.OpenCheckout();
                return Task.CompletedTask;
            case "Escape":
                if (ProductEditorOverlayOpen)
                {
                    CloseProductEditorOverlay();
                    return Task.CompletedTask;
                }
                if (ProductSearchModalOpen)
                {
                    CloseProductSearchModal();
                    return Task.CompletedTask;
                }
                Pos.CloseCheckout();
                return Task.CompletedTask;
            case "Delete":
                Pos.DeleteSelectedLine();
                return Task.CompletedTask;
            case "+":
            case "Add":
                Pos.ChangeSelectedQuantity(1);
                return Task.CompletedTask;
            case "-":
            case "Subtract":
                Pos.ChangeSelectedQuantity(-1);
                return Task.CompletedTask;
            default:
                return Task.CompletedTask;
        }
    }
    public void Dispose()
    {
        Pos.Changed -= OnStateChanged;
        _ = JS.InvokeVoidAsync("grunflexKeyboard.unregister");
        KeyboardReference?.Dispose();
    }
}

@* Reusable tables are kept in this page so the local shell has no external UI dependency. *@
@code {
