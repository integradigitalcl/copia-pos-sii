    private async Task ChangePasswordAsync()
    {
        if (Pos.IsAuthenticated)
        {
            if (!await Pos.ChangePasswordAsync(CurrentPasswordText, NewPasswordText))
            {
                ChangePasswordNotice = Pos.ErrorMessage ?? "No se pudo actualizar la contraseña.";
                return;
            }
            ChangePasswordNotice = string.Empty;
            ChangePasswordOpen = false;
            CurrentPasswordText = string.Empty;
            NewPasswordText = string.Empty;
            return;
        }

        var user = await ConfigStore.AuthenticateUserAsync(UserName, CurrentPasswordText);
        if (user is null)
        {
            ChangePasswordNotice = "Usuario o contraseña actual incorrectos.";
            return;
        }
        if (string.IsNullOrWhiteSpace(NewPasswordText) || NewPasswordText.Length < 4)
        {
            ChangePasswordNotice = "La nueva contraseña debe tener al menos 4 caracteres.";
            return;
        }
        if (!await ConfigStore.UpdateUserPasswordAsync(user.Id, NewPasswordText))
        {
            ChangePasswordNotice = "No se pudo actualizar la contraseña.";
            return;
        }
        ChangePasswordNotice = string.Empty;
        ChangePasswordOpen = false;
        CurrentPasswordText = string.Empty;
        NewPasswordText = string.Empty;
    }

    private async Task ForceChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(NewPasswordText) || NewPasswordText.Length < 4)
        {
            ChangePasswordNotice = "La nueva contraseña debe tener al menos 4 caracteres.";
            return;
        }
        if (!await Pos.ChangePasswordAsync(CurrentPasswordText, NewPasswordText))
        {
            ChangePasswordNotice = Pos.ErrorMessage ?? "No se pudo actualizar la contraseña.";
            return;
        }
        ChangePasswordNotice = string.Empty;
        CurrentPasswordText = string.Empty;
        NewPasswordText = string.Empty;
    }
