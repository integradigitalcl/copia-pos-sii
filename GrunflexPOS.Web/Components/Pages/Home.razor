    private (DateTime From, DateTime To) GetReportRange()
    {
        DateTime from;
        DateTime to;
        if (ReportPeriod == "Mes")
        {
            from = new DateTime(ReportYear, ReportMonth, 1);
            to = from.AddMonths(1);
        }
        else if (ReportPeriod == "7Dias")
        {
            from = DateTime.Today.AddDays(-6);
            to = DateTime.Today.AddDays(1);
        }
        else
        {
            from = DateTime.Today;
            to = from.AddDays(1);
        }
        return (DateTime.SpecifyKind(from, DateTimeKind.Unspecified),
            DateTime.SpecifyKind(to, DateTimeKind.Unspecified));
    }

    private async Task LoadReportsAsync()
    {
        try
        {
            var range = GetReportRange();
            ReportData = await Reports.GetDashboardAsync(range.From, range.To);
            ReportCashData = await Reports.GetCashSummaryAsync(range.From, range.To);
            ReportCashiers = await Reports.GetCashiersAsync();
            ReportNotice = string.Empty;
            if (ReportView == "Ventas")
                await LoadSalesReportAsync();
        }
        catch (Exception ex)
        {
            ReportNotice = $"No fue posible cargar los reportes: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSalesReportAsync()
    {
        var (from, to) = ReportView == "Ventas" && ReportPeriod == "Hoy"
            ? (DateTime.ParseExact(ReportDateText, "yyyy-MM-dd", CultureInfo.InvariantCulture),
                DateTime.ParseExact(ReportDateText, "yyyy-MM-dd", CultureInfo.InvariantCulture).AddDays(1))
            : GetReportRange();
        SalesReport = await Reports.GetSalesAsync(DateTime.SpecifyKind(from, DateTimeKind.Unspecified),
            DateTime.SpecifyKind(to, DateTimeKind.Unspecified), ReportSearch, ReportCashier,
            ReportCreditOnly, ReportSalesPage, ReportSalesPageSize);
        await InvokeAsync(StateHasChanged);
    }

