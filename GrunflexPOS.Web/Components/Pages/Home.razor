                    </div>
                    <button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar boleta</button>
                </div>
            </div>
        }
        else if (ConfigurationModule == "Cajon")
        {
            <div class="config-form-grid"><label class="config-check"><input type="checkbox" @bind="ConfigDrawerEnabled" /><span><strong>Abrir cajón automáticamente</strong><small>Se activa después de un cobro en efectivo.</small></span></label><label>Modo<select @bind="ConfigDrawerMode"><option value="printer">Impresora ESC/POS</option><option value="serial">Puerto COM</option><option value="raw">Impresora RAW</option></select></label><label>Impresora o dispositivo<input @bind="ConfigDrawerDevice" placeholder="Nombre o COM3" /></label></div>
            <div class="config-info-card"><strong>Prueba de apertura</strong><p>El bridge local ejecutará el pulso ESC/POS configurado.</p><button class="outline-button" @onclick="TestDrawerConfigurationAsync">Abrir cajón de prueba</button></div><button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar cajón</button>
        }
        else if (ConfigurationModule == "Scanner")
        {
            <div class="config-form-grid">
                <label class="config-check"><input type="checkbox" @bind="ConfigScannerEnabled" /><span><strong>Activar lector serial</strong><small>Los lectores USB tipo teclado funcionan directamente en Ventas sin bridge.</small></span></label>
                <label>Puerto COM
                    <select @bind="ConfigScannerPort">
                        @if (!string.IsNullOrWhiteSpace(ConfigScannerPort) && !ConfigScannerPorts.Contains(ConfigScannerPort, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@ConfigScannerPort">@ConfigScannerPort (guardado)</option>
                        }
                        @if (ConfigScannerPorts.Count == 0 && string.IsNullOrWhiteSpace(ConfigScannerPort))
                        {
                            <option value="">— sin puertos —</option>
                        }
                        @foreach (var port in ConfigScannerPorts)
                        {
                            <option value="@port">@port</option>
                        }
                    </select>
                </label>
                <label>Baudios<select @bind="ConfigScannerBaud"><option>1200</option><option>2400</option><option>4800</option><option>9600</option><option>19200</option><option>38400</option><option>57600</option><option>115200</option></select></label>
                <label>Bits de datos<select @bind="ConfigScannerDataBits"><option>5</option><option>6</option><option>7</option><option>8</option></select></label>
                <label>Paridad<select @bind="ConfigScannerParity"><option>None</option><option>Even</option><option>Odd</option><option>Mark</option><option>Space</option></select></label>
                <label>Bits de parada<select @bind="ConfigScannerStopBits"><option>One</option><option>Two</option><option>OnePointFive</option></select></label>
                <label>Handshake<select @bind="ConfigScannerHandshake"><option>None</option><option>XOnXOff</option><option>RequestToSend</option><option>RequestToSendXOnXOff</option></select></label>
            </div>
            <div class="config-info-card">
                <strong>Estado</strong>
                <p>Sesión: @Pos.ScannerStatus</p>
                @if (!string.IsNullOrWhiteSpace(ScannerConfigStatus)) { <p class="config-muted">@ScannerConfigStatus</p> }
                <p class="config-muted">@(ConfigScannerPorts.Count > 0 ? $"Puertos detectados: {string.Join(", ", ConfigScannerPorts)}" : "No se detectaron puertos COM. Si el bridge no está en :7390, inícialo; si tu pistola es USB teclado, déjala desactivada y escanea en Ventas.")</p>
                <div class="config-actions">
                    <button class="outline-button" @onclick="RefreshScannerPortsAsync">Actualizar puertos</button>
                    <button class="outline-button" @onclick="TestScannerConfigurationAsync">Probar / conectar</button>
                </div>
            </div>
            <button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar lector</button>
        }
        else if (ConfigurationModule == "Corte")
        {
            <div class="config-form-grid"><label>Tipo de cierre<select @bind="ConfigCorteMode"><option>Ajuste</option><option>Simple</option></select></label><label>Límite de efectivo<input @bind="ConfigCorteLimit" inputmode="decimal" /></label><label class="config-wide">Mensaje al cajero<textarea @bind="ConfigCorteMessage"></textarea></label></div>
            <button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar corte</button>
        }
        else if (ConfigurationModule == "Unidades")
        {
            <div class="config-form-grid"><label>Unidad predeterminada<select @bind="ConfigDefaultUnit"><option>H/MIN</option><option>KG/G</option><option>L/ML</option><option>M/CM</option><option>PZA</option><option>No aplica</option></select></label></div>
            <div class="config-info-card"><strong>Unidades disponibles</strong><p>H/MIN, KG/G, L/ML, M/CM, PZA y No aplica. La unidad del producto se conserva en el catálogo local.</p></div><button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar unidades</button>
        }
        else if (ConfigurationModule == "Bascula")
        {
            <div class="config-form-grid">
                <label class="config-check"><input type="checkbox" @bind="ConfigScaleEnabled" /><span><strong>Tengo conectada una báscula</strong><small>Habilita lectura serial y etiquetas de báscula en Ventas.</small></span></label>
                <label>Puerto COM
                    <select @bind="ConfigScalePort">
                        @if (!string.IsNullOrWhiteSpace(ConfigScalePort) && !ConfigScalePorts.Contains(ConfigScalePort, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@ConfigScalePort">@ConfigScalePort (guardado)</option>
                        }
                        @if (ConfigScalePorts.Count == 0 && string.IsNullOrWhiteSpace(ConfigScalePort))
                        {
                            <option value="">— sin puertos —</option>
                        }
                        @foreach (var port in ConfigScalePorts)
                        {
                            <option value="@port">@port</option>
                        }
                    </select>
                </label>
                <label>Driver<select @bind="ConfigScaleDriver"><option>GENERICA</option><option>TORREY</option><option>TOLEDO</option></select></label>
                <label>Código inicial (prefijo etiqueta)<input @bind="ConfigScalePrefix" placeholder="2000" inputmode="numeric" /></label>
                <label class="config-check"><input type="checkbox" @bind="ConfigScalePriceLabels" /><span><strong>Etiquetas con el precio</strong></span></label>
                <label class="config-check"><input type="checkbox" @bind="ConfigScaleWeightLabels" /><span><strong>Etiquetas con el peso</strong></span></label>
            </div>
            <div class="config-info-card">
                <strong>Estado</strong>
                <p>Sesión: @Pos.ScaleStatus</p>
                @if (!string.IsNullOrWhiteSpace(ScaleConfigStatus)) { <p class="config-muted">@ScaleConfigStatus</p> }
                <p class="config-muted">Las básculas impresoras de etiquetas embeben precio o peso en el código de barras. El prefijo debe coincidir con el PLU configurado en la báscula.</p>
                <div class="config-actions">
                    <button class="outline-button" @onclick="RefreshScalePortsAsync">Actualizar puertos</button>
                    <button class="outline-button" @onclick="TestScaleConfigurationAsync">Probar lectura de peso</button>
                </div>
            </div>
            <button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar báscula</button>
        }
        else if (ConfigurationModule == "Correo")
        {
            <div class="config-form-grid"><label class="config-check"><input type="checkbox" @bind="ConfigEmailEnabled" /><span><strong>Activar notificaciones por correo</strong><small>Tras cada venta se envía un resumen con PDF adjunto.</small></span></label><label>Correo electrónico<input type="email" @bind="ConfigEmail" /></label><label>Contraseña o clave de aplicación<input type="password" @bind="ConfigEmailPassword" /></label><label>Servidor SMTP<input @bind="ConfigSmtpHost" /></label><label>Puerto<input @bind="ConfigSmtpPort" inputmode="numeric" /></label><label class="config-check"><input type="checkbox" @bind="ConfigSmtpSsl" /><span><strong>Usar SSL/TLS</strong></span></label></div>
            <div class="config-info-card"><strong>Prueba SMTP</strong><p>Use una clave de aplicación para Gmail. El correo de prueba se envía a la misma cuenta configurada.</p><div class="config-actions"><button class="outline-button" @onclick="ApplyGmailPreset">Preset Gmail</button><button class="outline-button" @onclick="TestEmailConfigurationAsync">Probar correo</button></div>@if (!string.IsNullOrWhiteSpace(EmailStatus)) { <p class="config-muted">@EmailStatus</p> }</div>
            <button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar correo</button>
        }
        else if (ConfigurationModule == "Diagnostico")
        {
            <div class="diagnostic-results"><div><span class="status-dot"></span><strong>Aplicación web local</strong><small>Operativa</small></div><div><span class="status-dot"></span><strong>Base SQLite</strong><small>Disponible</small></div><div><span class="status-dot"></span><strong>Licencia</strong><small>@License.StatusText</small></div><div><span class="status-dot"></span><strong>Hardware Bridge</strong><small>@Pos.HardwareStatus</small></div><div><span class="status-dot"></span><strong>Lector serial</strong><small>@Pos.ScannerStatus</small></div><div><span class="status-dot"></span><strong>Báscula</strong><small>@Pos.ScaleStatus</small></div><div><span class="status-dot"></span><strong>Multicaja</strong><small>@Pos.MulticajaStatus</small></div><div><span class="status-dot"></span><strong>Ventas y caja</strong><small>Disponibles</small></div></div><button class="outline-button" @onclick="RunConfigurationDiagnosticsAsync">Reintentar comprobaciones</button>
        }
        else if (ConfigurationModule == "Licencia")
        {
            <div class="license-status-card"><span class="config-license-icon">♛</span><div><strong>@License.StatusText</strong><p>Vencimiento: @(string.IsNullOrWhiteSpace(License.ExpiryText) ? "—" : License.ExpiryText)</p><small>ActivationId: @(License.ActivationId ?? "—") · Módulos: @(LicenseModuleSummary())</small></div></div>
            <div class="config-form-grid"><label class="config-wide">Activation ID<input @bind="LicenseActivationId" placeholder="GF-XXXX-XXXX" /></label><label class="config-wide">Token GFv2<textarea class="config-export" rows="4" @bind="LicenseTokenText"></textarea></label></div>
            <div class="config-actions"><button class="primary-button" @onclick="ActivateLicenseOnlineAsync">Obtener desde servidor</button><button class="outline-button" @onclick="ActivateLicenseTokenAsync">Activar token</button><button class="outline-button" @onclick="SyncLicenseAsync">Sincronizar</button></div>
            @if (License.CloudBackup)
            {
                <div class="config-info-card"><strong>Respaldo en nube</strong><p>@CloudBackupStatus</p><button class="outline-button" @onclick="UploadCloudBackupAsync">Subir respaldo ahora</button></div>
            }
            <div class="config-info-card"><strong>Estado operativo</strong><p>@(License.IsPosAccessAllowed ? "Licencia válida para operar." : License.BlockReason)</p><p class="config-muted">Última sync: @(License.LastCloudOkUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca") · Gracia offline: @License.OfflineGraceDays día(s)@(License.NumberOfBoxes > 0 ? $" · Cajas: {License.NumberOfBoxes}" : string.Empty)</p></div>
        }
        else if (ConfigurationModule == "Servipag")
        {
            <div class="config-form-grid"><label class="config-wide">Portal Servipag<input @bind="ConfigServipagUrl" /></label></div>
            <div class="config-info-card"><strong>Integración de pagos</strong><p>El portal se abrirá en una pestaña independiente de Chrome.</p><button class="primary-button" @onclick="OpenServipag">Abrir Servipag ↗</button></div><button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar integración</button>
        }
        @if (!string.IsNullOrWhiteSpace(ConfigurationNotice)) { <div class="config-notice">@ConfigurationNotice</div> }
    </section>;

    private async Task LoadConfigurationModuleAsync(string action)
    {
        ConfigurationModule = action;
        ConfigurationNotice = string.Empty;
        switch (action)
        {
            case "Opciones":
                ConfigUseInventory = await GetBoolAsync("opt_usar_inventario", true);
                ConfigCostMethod = await ConfigStore.GetSettingAsync("opt_metodo_costo", "Costo promedio ponderado");
                ConfigOfferCredit = await GetBoolAsync("opt_ofrecer_credito", true);
                ConfigCommonProduct = await GetBoolAsync("opt_venta_producto_comun", true);
                ConfigAutoMargin = await GetBoolAsync("opt_calcular_margen_auto", true);
                ConfigMargin = await ConfigStore.GetSettingAsync("opt_margen_porcentaje", "20");
                ConfigRounding = await GetBoolAsync("opt_redondeo_habilitado", false);
                ConfigRoundingMode = await ConfigStore.GetSettingAsync("opt_modo_redondeo", "A décimas");
                ConfigOccasionalNotice = await ConfigStore.GetSettingAsync("opt_aviso_ocasional", "Por favor, recuerda lavarte las manos");
                ConfigNoticeEvery = await ConfigStore.GetSettingAsync("opt_aviso_cada_n_ventas", "0");
                break;
            case "Pagos":
                ConfigCashMinimum = await GetBoolAsync("pago_efectivo_no_menor", true);
                ConfigDollars = await GetBoolAsync("pago_dolar_habilitado", false);
                ConfigExchangeRate = await ConfigStore.GetSettingAsync("pago_dolar_tipo_cambio", "1");
                ConfigCardPayments = await GetBoolAsync("pago_tarjeta_habilitada", true);
                ConfigCardCommission = await GetBoolAsync("pago_tarjeta_comision_habilitada", false);
                ConfigCardCommissionPercent = await ConfigStore.GetSettingAsync("pago_tarjeta_comision_pct", "0");
                ConfigTransfers = await GetBoolAsync("pago_transferencia_habilitada", false);
                ConfigTransferAlias = await ConfigStore.GetSettingAsync("pago_transferencia_alias", "Transferencia");
                ConfigChecks = await GetBoolAsync("pago_cheque_habilitado", false);
                ConfigVouchers = await GetBoolAsync("pago_vales_habilitado", false);
                ConfigMixedPayments = await GetBoolAsync("pago_mixto_habilitado", true);
                break;
            case "Cajero":
                ConfigUsers = await ConfigStore.GetUsersAsync();
                break;
            case "Cajas":
                ConfigRegisterName = await ConfigStore.GetSettingAsync("caja_nombre", "Caja 1");
                ConfigMultiCaja = await GetBoolAsync("multicaja_habilitada", false);
                ConfigTerminalRole = await ConfigStore.GetSettingAsync("terminal_role", "server");
                ConfigApiUrl = await ConfigStore.GetSettingAsync("multicaja_api_url", "http://127.0.0.1:7279/");
                break;
            case "Folio":
                ConfigFolio = await ConfigStore.GetSettingAsync("folio_actual", "1");
                break;
            case "Facturacion":
                ConfigInvoiceEnabled = await GetBoolAsync("facturacion_activa", false);
                ConfigInvoiceEndpoint = await ConfigStore.GetSettingAsync("facturacion_endpoint", "http://127.0.0.1:7373/api/invoice/receive");
                ConfigInvoiceApiKey = await ConfigStore.GetSettingAsync("facturacion_api_key", string.Empty);
                ConfigInvoiceDocType = await ConfigStore.GetSettingAsync("facturacion_tipo_documento", "boleta");
                ConfigInvoiceSellerRut = await ConfigStore.GetSettingAsync("facturacion_emisor_rut", string.Empty);
                ConfigInvoiceSellerName = await ConfigStore.GetSettingAsync("facturacion_emisor_razon", string.Empty);
                ConfigInvoiceSellerAddress = await ConfigStore.GetSettingAsync("facturacion_emisor_direccion", string.Empty);
                ConfigInvoiceSellerEmail = await ConfigStore.GetSettingAsync("facturacion_emisor_email", string.Empty);
                ConfigInvoiceIva = await ConfigStore.GetSettingAsync("facturacion_iva_porcentaje", "19");
                ConfigInvoicePricesIncludeTax = await GetBoolAsync("facturacion_precios_con_iva", true);
                InvoiceProbeStatus = string.Empty;
                InvoiceHistory = await ConfigStore.GetRecentInvoiceEmissionsAsync(12);
                break;
            case "Logo":
                ConfigLogoData = await ConfigStore.GetSettingAsync("logo_data", string.Empty);
                await RefreshLogoDisplayAsync();
                break;
            case "Impresora":
                ConfigPrinterName = await ConfigStore.GetSettingAsync("impresora_nombre", string.Empty);
                ConfigPrinterMode = await ConfigStore.GetSettingAsync("impresora_modo", "windows");
                ConfigPrinterPaper = await ConfigStore.GetSettingAsync("ticket_ancho", "80");
                ConfigPrinterColumns = await ConfigStore.GetSettingAsync("ticket_columnas", "42");
                ConfigPrinterBold = await GetBoolAsync("ticket_negrita", true);
                ConfigPrinterUnitPrice = await GetBoolAsync("ticket_precio_unitario", true);
                await RefreshPrinterListAsync();
                break;
            case "Boleta":
                ConfigTicket = await TicketTemplate.LoadAsync();
                ConfigLogoData = await ConfigStore.GetSettingAsync("logo_data", string.Empty);
                await RefreshLogoDisplayAsync();
                break;
            case "Cajon":
                ConfigDrawerEnabled = await GetBoolAsync("cajon_habilitado", false);
                ConfigDrawerMode = await ConfigStore.GetSettingAsync("cajon_modo", "printer");
                ConfigDrawerDevice = await ConfigStore.GetSettingAsync("cajon_dispositivo", string.Empty);
                if (string.IsNullOrWhiteSpace(ConfigDrawerDevice))
                {
                    var linkedPrinter = await ConfigStore.GetSettingAsync("impresora_nombre", string.Empty);
                    SyncDrawerConfigFromPrinter(linkedPrinter);
                }
                break;
            case "Scanner":
                ConfigScannerEnabled = await GetBoolAsync("lector_serial_habilitado", false);
                ConfigScannerPort = await ConfigStore.GetSettingAsync("lector_serial_puerto", string.Empty);
                ConfigScannerBaud = await ConfigStore.GetSettingAsync("lector_serial_baud", "9600");
                ConfigScannerDataBits = await ConfigStore.GetSettingAsync("lector_serial_databits", string.Empty);
                if (string.IsNullOrWhiteSpace(ConfigScannerDataBits))
                    ConfigScannerDataBits = await ConfigStore.GetSettingAsync("lector_serial_data_bits", "8");
                ConfigScannerParity = await ConfigStore.GetSettingAsync("lector_serial_parity", string.Empty);
                if (string.IsNullOrWhiteSpace(ConfigScannerParity))
                    ConfigScannerParity = await ConfigStore.GetSettingAsync("lector_serial_paridad", "None");
                ConfigScannerStopBits = await ConfigStore.GetSettingAsync("lector_serial_stopbits", string.Empty);
                if (string.IsNullOrWhiteSpace(ConfigScannerStopBits))
                    ConfigScannerStopBits = await ConfigStore.GetSettingAsync("lector_serial_stop_bits", "One");
                ConfigScannerHandshake = await ConfigStore.GetSettingAsync("lector_serial_handshake", "None");
                ScannerConfigStatus = string.Empty;
                await RefreshScannerPortsAsync();
                break;
            case "Corte":
                ConfigCorteMode = await ConfigStore.GetSettingAsync("corte_modo", "Ajuste");
                ConfigCorteLimit = await ConfigStore.GetSettingAsync("corte_limite_efectivo", "0");
                ConfigCorteMessage = await ConfigStore.GetSettingAsync("corte_mensaje", string.Empty);
                break;
            case "Unidades":
                ConfigDefaultUnit = await ConfigStore.GetSettingAsync("unidad_defecto", "PZA");
                break;
            case "Bascula":
                ConfigScaleEnabled = await GetBoolAsync("bascula_activa", await GetBoolAsync("bascula_habilitada", false));
                ConfigScalePort = await ConfigStore.GetSettingAsync("bascula_puerto", string.Empty);
                if (string.IsNullOrWhiteSpace(ConfigScalePort))
                {
                    var driverPort = await ConfigStore.GetSettingAsync("bascula_driver_puerto", string.Empty);
                    var match = System.Text.RegularExpressions.Regex.Match(driverPort, @"COM\d+", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                    if (match.Success)
                        ConfigScalePort = match.Value.ToUpperInvariant();
                }
                ConfigScaleDriver = await ConfigStore.GetSettingAsync("bascula_driver", "GENERICA");
                if (ConfigScaleDriver.Equals("GENÉRICA", StringComparison.OrdinalIgnoreCase))
                    ConfigScaleDriver = "GENERICA";
                ConfigScalePrefix = await ConfigStore.GetSettingAsync("bascula_codigo_inicial", "2000");
                ConfigScalePriceLabels = await GetBoolAsync("bascula_etiqueta_precio", false);
                ConfigScaleWeightLabels = await GetBoolAsync("bascula_etiqueta_peso", await GetBoolAsync("bascula_etiquetas", false));
                ConfigScaleLabels = ConfigScalePriceLabels || ConfigScaleWeightLabels;
                ScaleConfigStatus = string.Empty;
                await RefreshScalePortsAsync();
                break;
            case "Correo":
                ConfigEmailEnabled = await GetBoolAsync("correo_activo", false);
                ConfigEmail = await ConfigStore.GetSettingAsync("correo_email", string.Empty);
                ConfigEmailPassword = await ConfigStore.GetSettingAsync("correo_clave", string.Empty);
                ConfigSmtpHost = await ConfigStore.GetSettingAsync("correo_smtp_host", string.Empty);
                if (string.IsNullOrWhiteSpace(ConfigSmtpHost))
                    ConfigSmtpHost = await ConfigStore.GetSettingAsync("correo_host", "smtp.gmail.com");
                ConfigSmtpPort = await ConfigStore.GetSettingAsync("correo_smtp_puerto", string.Empty);
                if (string.IsNullOrWhiteSpace(ConfigSmtpPort))
                    ConfigSmtpPort = await ConfigStore.GetSettingAsync("correo_puerto", "587");
                ConfigSmtpSsl = await GetBoolAsync("correo_smtp_ssl", await GetBoolAsync("correo_ssl", true));
                EmailStatus = string.Empty;
                break;
            case "Servipag":
                ConfigServipagUrl = await ConfigStore.GetSettingAsync("servipag_url", "https://portal.servipag.com/");
                break;
            case "Licencia":
                await License.RefreshAsync();
                LicenseActivationId = License.ActivationId ?? string.Empty;
                CloudBackupStatus = await CloudBackup.GetLastBackupStatusAsync();
                break;
            case "BaseDatos":
                ConfigDatabaseExport = string.Empty;
                break;
        }
    }

    private async Task<bool> GetBoolAsync(string key, bool defaultValue) =>
        string.Equals(await ConfigStore.GetSettingAsync(key, defaultValue ? "true" : "false"), "true", StringComparison.OrdinalIgnoreCase);

    private async Task SaveConfigurationAsync()
    {
        var values = new Dictionary<string, string>();
        switch (ConfigurationModule)
        {
            case "Opciones":
                values = new()
                {
                    ["opt_usar_inventario"] = ConfigUseInventory.ToString().ToLowerInvariant(),
                    ["opt_metodo_costo"] = ConfigCostMethod,
                    ["opt_ofrecer_credito"] = ConfigOfferCredit.ToString().ToLowerInvariant(),
                    ["opt_venta_producto_comun"] = ConfigCommonProduct.ToString().ToLowerInvariant(),
                    ["opt_calcular_margen_auto"] = ConfigAutoMargin.ToString().ToLowerInvariant(),
                    ["opt_margen_porcentaje"] = NormalizeNumber(ConfigMargin, "20"),
                    ["opt_redondeo_habilitado"] = ConfigRounding.ToString().ToLowerInvariant(),
                    ["opt_modo_redondeo"] = ConfigRoundingMode,
                    ["opt_aviso_ocasional"] = ConfigOccasionalNotice.Trim(),
                    ["opt_aviso_cada_n_ventas"] = NormalizeNumber(ConfigNoticeEvery, "0")
                };
                break;
            case "Pagos":
                values = new()
                {
                    ["pago_efectivo_no_menor"] = ConfigCashMinimum.ToString().ToLowerInvariant(),
                    ["pago_dolar_habilitado"] = ConfigDollars.ToString().ToLowerInvariant(),
                    ["pago_dolar_tipo_cambio"] = NormalizeNumber(ConfigExchangeRate, "1"),
                    ["pago_tarjeta_habilitada"] = ConfigCardPayments.ToString().ToLowerInvariant(),
                    ["pago_tarjeta_comision_habilitada"] = ConfigCardCommission.ToString().ToLowerInvariant(),
                    ["pago_tarjeta_comision_pct"] = NormalizeNumber(ConfigCardCommissionPercent, "0"),
                    ["pago_transferencia_habilitada"] = ConfigTransfers.ToString().ToLowerInvariant(),
                    ["pago_transferencia_alias"] = string.IsNullOrWhiteSpace(ConfigTransferAlias) ? "Transferencia" : ConfigTransferAlias.Trim(),
                    ["pago_cheque_habilitado"] = ConfigChecks.ToString().ToLowerInvariant(),
                    ["pago_vales_habilitado"] = ConfigVouchers.ToString().ToLowerInvariant(),
                    ["pago_mixto_habilitado"] = ConfigMixedPayments.ToString().ToLowerInvariant()
                };
                break;
            case "Folio":
                values["folio_actual"] = NormalizeNumber(ConfigFolio, "1");
                break;
            case "Cajas":
                if (ConfigMultiCaja && !CajaSlotGate.CanEnableMulticaja(License, License.RequireLicense))
                {
                    ConfigurationNotice = "Esta función requiere licencia Multicaja activa.";
                    return;
                }
                values = new()
                {
                    ["caja_nombre"] = string.IsNullOrWhiteSpace(ConfigRegisterName) ? "Caja 1" : ConfigRegisterName.Trim(),
                    ["multicaja_habilitada"] = ConfigMultiCaja.ToString().ToLowerInvariant(),
                    ["terminal_role"] = ConfigTerminalRole,
                    ["multicaja_api_url"] = ConfigApiUrl.Trim()
                };
                break;
            case "Impresora":
                values = new()
                {
                    ["impresora_nombre"] = ConfigPrinterName.Trim(),
                    ["impresora_modo"] = ConfigPrinterMode,
                    ["ticket_ancho"] = ConfigPrinterPaper,
                    ["ticket_columnas"] = NormalizeNumber(ConfigPrinterColumns, "42"),
                    ["ticket_negrita"] = ConfigPrinterBold.ToString().ToLowerInvariant(),
                    ["ticket_precio_unitario"] = ConfigPrinterUnitPrice.ToString().ToLowerInvariant()
                };
                if (!string.IsNullOrWhiteSpace(ConfigPrinterName))
                {
                    SyncDrawerConfigFromPrinter(ConfigPrinterName);
                    values["cajon_habilitado"] = "true";
                    values["cajon_modo"] = "printer";
                    values["cajon_dispositivo"] = ConfigPrinterName.Trim();
                }
                break;
            case "Cajon":
                values = new()
                {
                    ["cajon_habilitado"] = ConfigDrawerEnabled.ToString().ToLowerInvariant(),
                    ["cajon_modo"] = ConfigDrawerMode,
                    ["cajon_dispositivo"] = ConfigDrawerDevice.Trim()
                };
                break;
            case "Scanner":
                values = new()
                {
                    ["lector_serial_habilitado"] = ConfigScannerEnabled.ToString().ToLowerInvariant(),
                    ["lector_serial_puerto"] = ConfigScannerPort.Trim(),
                    ["lector_serial_baud"] = NormalizeNumber(ConfigScannerBaud, "9600"),
                    ["lector_serial_databits"] = NormalizeNumber(ConfigScannerDataBits, "8"),
                    ["lector_serial_data_bits"] = NormalizeNumber(ConfigScannerDataBits, "8"),
                    ["lector_serial_parity"] = ConfigScannerParity,
                    ["lector_serial_paridad"] = ConfigScannerParity,
                    ["lector_serial_stopbits"] = ConfigScannerStopBits,
                    ["lector_serial_stop_bits"] = ConfigScannerStopBits,
                    ["lector_serial_handshake"] = ConfigScannerHandshake
                };
                break;
            case "Corte":
                values = new()
                {
                    ["corte_modo"] = ConfigCorteMode,
                    ["corte_limite_efectivo"] = NormalizeNumber(ConfigCorteLimit, "0"),
                    ["corte_mensaje"] = ConfigCorteMessage.Trim()
                };
                break;
            case "Unidades":
                values["unidad_defecto"] = ConfigDefaultUnit;
                break;
            case "Bascula":
                values = new()
                {
                    ["bascula_activa"] = ConfigScaleEnabled.ToString().ToLowerInvariant(),
                    ["bascula_habilitada"] = ConfigScaleEnabled.ToString().ToLowerInvariant(),
                    ["bascula_puerto"] = ConfigScalePort.Trim(),
                    ["bascula_driver"] = ConfigScaleDriver,
                    ["bascula_driver_puerto"] = string.IsNullOrWhiteSpace(ConfigScalePort)
                        ? string.Empty
                        : $"Serial {ConfigScalePort.Trim()} (driver OK)",
                    ["bascula_codigo_inicial"] = string.IsNullOrWhiteSpace(ConfigScalePrefix) ? "2000" : ConfigScalePrefix.Trim(),
                    ["bascula_etiqueta_precio"] = ConfigScalePriceLabels.ToString().ToLowerInvariant(),
                    ["bascula_etiqueta_peso"] = ConfigScaleWeightLabels.ToString().ToLowerInvariant(),
                    ["bascula_etiquetas"] = (ConfigScalePriceLabels || ConfigScaleWeightLabels).ToString().ToLowerInvariant()
                };
                break;
            case "Correo":
                values = new()
                {
                    ["correo_activo"] = ConfigEmailEnabled.ToString().ToLowerInvariant(),
                    ["correo_email"] = ConfigEmail.Trim(),
                    ["correo_clave"] = ConfigEmailPassword,
                    ["correo_smtp_host"] = ConfigSmtpHost.Trim(),
                    ["correo_smtp_puerto"] = NormalizeNumber(ConfigSmtpPort, "587"),
                    ["correo_smtp_ssl"] = ConfigSmtpSsl.ToString().ToLowerInvariant(),
                    ["correo_host"] = ConfigSmtpHost.Trim(),
                    ["correo_puerto"] = NormalizeNumber(ConfigSmtpPort, "587"),
                    ["correo_ssl"] = ConfigSmtpSsl.ToString().ToLowerInvariant()
                };
                break;
            case "Servipag":
                values["servipag_url"] = string.IsNullOrWhiteSpace(ConfigServipagUrl)
                    ? "https://portal.servipag.com/"
                    : ConfigServipagUrl.Trim();
                break;
            case "Facturacion":
                values = new()
                {
                    ["facturacion_activa"] = ConfigInvoiceEnabled.ToString().ToLowerInvariant(),
                    ["facturacion_endpoint"] = string.IsNullOrWhiteSpace(ConfigInvoiceEndpoint)
                        ? "http://127.0.0.1:7373/api/invoice/receive"
                        : ConfigInvoiceEndpoint.Trim(),
                    ["facturacion_api_key"] = ConfigInvoiceApiKey,
                    ["facturacion_tipo_documento"] = ConfigInvoiceDocType,
                    ["facturacion_emisor_rut"] = ConfigInvoiceSellerRut.Trim(),
                    ["facturacion_emisor_razon"] = ConfigInvoiceSellerName.Trim(),
                    ["facturacion_emisor_direccion"] = ConfigInvoiceSellerAddress.Trim(),
                    ["facturacion_emisor_email"] = ConfigInvoiceSellerEmail.Trim(),
                    ["facturacion_iva_porcentaje"] = NormalizeNumber(ConfigInvoiceIva, "19"),
                    ["facturacion_precios_con_iva"] = ConfigInvoicePricesIncludeTax.ToString().ToLowerInvariant()
                };
                break;
            case "Boleta":
                ClampBoletaSettings();
                await TicketTemplate.SaveAsync(ConfigTicket);
                await Pos.ReloadSettingsAsync();
                ConfigurationNotice = "Personalización de boleta guardada correctamente.";
                return;
            default:
                ConfigurationNotice = "Este módulo se ejecuta mediante el servicio local o una integración externa.";
                return;
        }

        await ConfigStore.SetSettingsAsync(values);
        await Pos.ReloadSettingsAsync();
        if (ConfigurationModule == "Scanner")
            await Pos.SyncScannerAsync();
        ConfigOfferCredit = Pos.OfferCredit;
        ConfigUseInventory = Pos.UseInventory;
        ConfigRegisterName = Pos.CashRegister;
        ConfigurationNotice = ConfigurationModule == "Impresora" && !string.IsNullOrWhiteSpace(ConfigPrinterName)
            ? "Impresora guardada y cajón vinculado automáticamente."
            : "Configuración guardada correctamente.";
        if (ConfigurationModule == "Bascula")
            ScaleConfigStatus = Pos.ScaleStatus;
    }

    private decimal ApplyProductRounding(decimal value) => ConfigRoundingMode switch
    {
        "A unidades" => Math.Round(value, 0, MidpointRounding.AwayFromZero),
        "A 50" => Math.Round(value / 50m, 0, MidpointRounding.AwayFromZero) * 50m,
        "A 100" => Math.Round(value / 100m, 0, MidpointRounding.AwayFromZero) * 100m,
        _ => Math.Round(value, 1, MidpointRounding.AwayFromZero)
    };

    private async Task BackupDatabaseAsync()
    {
        var path = await ConfigStore.BackupDatabaseAsync();
        ConfigurationNotice = path is null
            ? "No se encontró la base de datos local."
            : $"Respaldo creado en {path}";
    }

    private static string NormalizeNumber(string? value, string fallback)
    {
        var normalized = (value ?? string.Empty).Trim().Replace(",", ".");
        return decimal.TryParse(normalized, NumberStyles.Any, CultureInfo.InvariantCulture, out var number)
            ? number.ToString(CultureInfo.InvariantCulture)
            : fallback;
    }

    private async Task CreateConfiguredUserAsync()
    {
