                        {
                            <option value="@ConfigPrinterName">@ConfigPrinterName (guardada)</option>
                        }
                        @foreach (var printer in ConfigPrinterOptions)
                        {
                            <option value="@printer">@printer</option>
                        }
                    </select>
                </label>
                <label>Tipo de impresora
                    <select @bind="ConfigPrinterMode">
                        <option value="windows">Normal (Windows)</option>
                        <option value="termica">Térmica ESC/POS</option>
                    </select>
                </label>
                <label>Ancho de papel (mm)<select @bind="ConfigPrinterPaper"><option>58</option><option>80</option></select></label>
                <label>Columnas<input @bind="ConfigPrinterColumns" inputmode="numeric" /></label>
                <label class="config-check"><input type="checkbox" @bind="ConfigPrinterBold" /><span><strong>Texto en negrita</strong></span></label>
                <label class="config-check"><input type="checkbox" @bind="ConfigPrinterUnitPrice" /><span><strong>Mostrar precio unitario</strong></span></label>
            </div>
            <div class="config-info-card"><strong>Estado del bridge</strong><p>@Pos.HardwareStatus</p><p class="config-muted">@(ConfigPrinterOptions.Count > 0 ? $"Impresoras detectadas: {string.Join(", ", ConfigPrinterOptions)}" : "No se detectaron impresoras. Verifica que el Hardware Bridge esté activo en 127.0.0.1:7390.")</p>@if (!string.IsNullOrWhiteSpace(ConfigPrinterName)) { <p class="config-muted">El cajón de dinero se vincula automáticamente a esta impresora.</p> }<div class="config-inline-actions"><button class="outline-button" @onclick="RefreshPrinterListAsync">Actualizar impresoras</button><button class="outline-button" @onclick="TestPrinterConfigurationAsync" disabled="@string.IsNullOrWhiteSpace(ConfigPrinterName)">Enviar prueba de impresión</button></div></div><button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar impresora</button>
        }
        else if (ConfigurationModule == "Boleta")
        {
            <div class="boleta-customizer">
                <div class="boleta-preview-pane">
                    <h3 class="boleta-preview-title">Personalización del ticket de venta</h3>
                    <div class="boleta-margin-row">
                        <span>Líneas arriba</span>
                        <input type="number" min="0" max="20" @bind="ConfigTicket.TopBlankLines" />
                        <span>líneas</span>
                    </div>
                    <div class="boleta-paper" style="@GetBoletaPreviewStyle()">
                        <div class="boleta-logo-box">
                            <img src="@BoletaLogoSource" alt="Logotipo GrünFlex" class="@(ConfigTicket.PrintLogoMonochrome ? "boleta-logo-bw" : null)" onerror="this.onerror=null;this.src='assets/logo_custom.png';" />
                            <p class="boleta-hint">Logo del POS. Si no hay uno personalizado, se usa el de GrünFlex.</p>
                        </div>
                        <input class="boleta-line-input boleta-line-bold" @bind="ConfigTicket.Line1" />
                        <input class="boleta-line-input" @bind="ConfigTicket.Line2" />
                        <input class="boleta-line-input" @bind="ConfigTicket.Line3" />
                        <input class="boleta-line-input" @bind="ConfigTicket.Line4" />
                        <div class="boleta-preview-meta">Ticket N° 1024</div>
                        <div class="boleta-preview-meta">Fecha: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                        <input class="boleta-line-input boleta-line-muted" @bind="ConfigTicket.Line5" />
                        <input class="boleta-line-input boleta-line-separator" @bind="ConfigTicket.Line6" />
                        <input class="boleta-line-input boleta-line-sample" @bind="ConfigTicket.Line7" />
                        <input class="boleta-line-input boleta-line-sample" @bind="ConfigTicket.Line8" />
                        <input class="boleta-line-input boleta-line-sample" @bind="ConfigTicket.Line9" />
                        <div class="boleta-preview-separator">@(new string('-', Math.Min(ConfigTicket.Columns, 48)))</div>
                        <div class="boleta-preview-meta">TOTAL: $33</div>
                        <input class="boleta-line-input" @bind="ConfigTicket.Line10" placeholder="No. de Articulos: {ARTICULOS}" />
                        <input class="boleta-line-input @(ConfigTicket.NormalTotalsFont ? "" : "boleta-line-bold")" @bind="ConfigTicket.Line11" placeholder="Total: {TOTAL}" />
