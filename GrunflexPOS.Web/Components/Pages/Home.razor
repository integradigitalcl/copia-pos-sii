    private void OnStateChanged() =>
        _ = InvokeAsync(() =>
        {
            try
            {
                StateHasChanged();
            }
            catch (ObjectDisposedException)
            {
                // Component already disposed.
            }
            catch (InvalidOperationException)
            {
                // Render already in progress.
            }
            catch (Exception)
            {
                // Keep the circuit alive; ErrorBoundary handles render faults.
            }
        });

