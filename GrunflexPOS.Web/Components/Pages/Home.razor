    private IEnumerable<string> AvailablePaymentMethods
    {
        get
        {
            var methods = new List<string> { "Efectivo" };
            if (ConfigCardPayments) methods.Add("Tarjeta");
            if (ConfigMixedPayments) methods.Add("Mixto");
            if (Pos.OfferCredit) methods.Add("Transferencia");
            if (ConfigTransfers)
            {
                var alias = string.IsNullOrWhiteSpace(ConfigTransferAlias) ? "Transferencia" : ConfigTransferAlias.Trim();
                if (!methods.Contains(alias, StringComparer.OrdinalIgnoreCase))
                    methods.Add(alias);
            }
            if (ConfigChecks) methods.Add("Cheque");
            if (ConfigVouchers) methods.Add("Vales");
            if (ConfigDollars) methods.Add("Dólares");
            return methods;
        }
    }
