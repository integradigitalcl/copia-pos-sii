                                <span class="checkout-modal-icon">$</span>
                                <div><h2 id="checkout-title">COBRAR</h2><p>Ingrese el monto recibido</p></div>
                            </div>
                            <div class="checkout-modal-total"><span>TOTAL A COBRAR</span><strong>@Pos.FormatCurrency(Pos.Total)</strong></div>
                            <label class="checkout-modal-label">MÉTODO DE PAGO</label>
                            <div class="payment-methods">
                                @foreach (var method in AvailablePaymentMethods)
                                {
                                    <button class="payment-method @(Pos.SelectedPaymentMethod == method ? "selected" : "")" @onclick="() => Pos.SelectPaymentMethod(method)">@PaymentIcon(method) @method</button>
                                }
                            </div>
                            <label class="checkout-modal-label">@(Pos.SelectedPaymentMethod is "Efectivo" or "Mixto" ? "MONTO RECIBIDO" : "REFERENCIA (OPCIONAL)")</label>
                            @if (Pos.SelectedPaymentMethod == "Mixto")
                            {
                                <div class="mixed-payment-fields">
                                    <input class="checkout-money-input" placeholder="Efectivo" value="@Pos.MixedCashText" @oninput="SetMixedCash" />
                                    <input class="checkout-money-input" placeholder="Tarjeta / transferencia" value="@Pos.MixedCardText" @oninput="SetMixedCard" />
                                </div>
                            }
                            else
                            {
                                <input class="checkout-money-input" placeholder="@(Pos.SelectedPaymentMethod == "Efectivo" ? "Dejar vacío para cobrar el total" : "Opcional")" value="@Pos.ReceivedAmountText" @oninput="SetReceivedAmount" />
                            }
                            <div class="checkout-change"><span>CAMBIO</span><strong>@Pos.FormatCurrency(Pos.Change)</strong><small>Se calculará automáticamente</small></div>
                            @if (Pos.InvoiceEnabled)
                            {
                                <label class="checkout-modal-label config-check" style="display:flex;gap:.5rem;align-items:center;margin-top:.75rem">
                                    <input type="checkbox" checked="@Pos.CheckoutEmitInvoice" @onchange="OnCheckoutEmitInvoice" />
                                    <span>Emitir documento electrónico (@Pos.InvoiceDocumentType)</span>
                                </label>
                                @if (Pos.CheckoutEmitInvoice)
                                {
                                    <div class="mixed-payment-fields" style="margin-top:.5rem">
                                        <input class="checkout-money-input" placeholder="RUT receptor (requerido si factura)" value="@Pos.CheckoutBuyerRut" @oninput="OnCheckoutBuyerRut" />
                                        <input class="checkout-money-input" placeholder="Razón social" value="@Pos.CheckoutBuyerName" @oninput="OnCheckoutBuyerName" />
                                        <input class="checkout-money-input" placeholder="Email receptor (opc.)" value="@Pos.CheckoutBuyerEmail" @oninput="OnCheckoutBuyerEmail" />
                                    </div>
                                }
                            }
                        </div>
                        <aside class="checkout-modal-actions">
                            <button class="modal-action green" @onclick='() => CompleteSale("print")'>▣ <span>F1 - Cobrar e imprimir</span></button>
                            <button class="modal-action blue" @onclick='() => CompleteSale("no-print")'>▣ <span>F2 - Cobrar sin imprimir</span></button>
                            <button class="modal-action dark" @onclick='() => CompleteSale("personal")'>▣ <span>F3 - Marcar como consumo personal</span></button>
                            <button class="modal-action red" @onclick="Pos.CloseCheckout">× <span>ESC - Cancelar</span></button>
                            <div class="secure-payment"><strong>◈ Registro de cobro</strong><span>Tarjeta y mixto se registran en reportes sin pasarela de pago.</span></div>
                        </aside>
                        <footer class="checkout-modal-footer">
                            <span><b>@Pos.ItemCount</b> TOTAL DE ARTÍCULOS</span>
                            <span><b>@Pos.FormatCurrency(Pos.DiscountAmount)</b> DESCUENTOS APLICADOS</span>
                            <span><b>@Pos.FormatCurrency(Pos.Total)</b> TOTAL A COBRAR</span>
