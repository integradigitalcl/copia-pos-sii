    private void AddPromoComponentFromQuery()
    {
        var query = (PromoProductQuery ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            ProductNotice = "Indica el código o nombre del producto a agregar.";
            return;
        }

        var product = Pos.Products.FirstOrDefault(p => p.Code.Equals(query, StringComparison.OrdinalIgnoreCase))
            ?? Pos.Products.FirstOrDefault(p => p.Name.Equals(query, StringComparison.OrdinalIgnoreCase))
            ?? Pos.Products.FirstOrDefault(p => !PromotionCatalog.IsPromotion(p) && MatchesProductText(p, query));
        if (product is null)
        {
            ProductNotice = $"No se encontró el producto '{query}'.";
            return;
        }
        if (PromotionCatalog.IsPromotion(product))
        {
            ProductNotice = "No se puede incluir otra promoción dentro de una promoción.";
            return;
        }

        AddPromoComponent(product);
    }

    private void SelectPromoProductSuggestion(PosProduct product) =>
        AddPromoComponent(product);

    private void AddPromoComponent(PosProduct product)
    {
        var existing = PromoComponents.FirstOrDefault(x => x.ProductId == product.Id);
        if (existing is null)
            PromoComponents.Add(new PromoComponentRow(product.Id, product.Code, product.Name, 1m, product.Price, product.Stock));
        else
        {
            PromoComponents.Remove(existing);
            PromoComponents.Add(existing with { Quantity = existing.Quantity + 1m, Stock = product.Stock, Price = product.Price });
        }

        PromoProductQuery = string.Empty;
        PromoSuggestionIndex = -1;
        ProductNotice = string.Empty;
    }

    private void ChangePromoComponentQuantity(int productId, decimal delta)
    {
        var existing = PromoComponents.FirstOrDefault(x => x.ProductId == productId);
        if (existing is null)
            return;
        var next = existing.Quantity + delta;
        if (next <= 0)
        {
            RemovePromoComponent(productId);
            return;
        }

        PromoComponents.Remove(existing);
        PromoComponents.Add(existing with { Quantity = next });
        ProductNotice = string.Empty;
    }

    private void RemovePromoComponent(int productId) =>
        PromoComponents.RemoveAll(x => x.ProductId == productId);

