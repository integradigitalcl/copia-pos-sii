    private async Task SaveProductAsync()
    {
        if (!TryParseProductDecimal(ProductCost, out var cost) ||
            !TryParseProductDecimal(ProductPrice, out var price) ||
            !TryParseProductDecimal(ProductWholesale, out var wholesale) ||
            !TryParseProductDecimal(ProductStock, out var stock) ||
            !TryParseProductDecimal(ProductMinStock, out var minStock) ||
            !TryParseProductDecimal(ProductMaxStock, out var maxStock))
        {
            ProductNotice = "Costo, precios y existencias deben ser valores numéricos válidos.";
            return;
        }

        // Margen automático solo si el precio de venta quedó en 0 (no pisar el precio digitado).
        if (ConfigAutoMargin && cost > 0 && price <= 0 &&
            decimal.TryParse(ConfigMargin.Replace(",", "."), NumberStyles.Any, CultureInfo.InvariantCulture, out var marginPct))
        {
            price = ApplyProductRounding(cost * (1m + marginPct / 100m));
            if (wholesale <= 0)
                wholesale = price;
        }
        else if (ConfigRounding)
        {
            price = ApplyProductRounding(price);
            if (wholesale > 0)
                wholesale = ApplyProductRounding(wholesale);
        }

        ProductWriteResult result;
        var category = string.IsNullOrWhiteSpace(ProductDepartment) ? "General" : ProductDepartment.Trim();
        if (ProductMode == "Nuevo")
        {
            result = await ConfigStore.CreateProductAsync(
                ProductCode, ProductName, category, cost, price, wholesale, stock,
                minStock, maxStock, ProductUnit, ProductSaleType, ProductDepartment, Pos.UserName);
        }
        else
        {
            if (SelectedProduct is null)
            {
                ProductNotice = "Selecciona un producto de la tabla para modificarlo.";
                return;
            }
            result = await ConfigStore.UpdateProductAsync(
                SelectedProduct.Id, ProductCode, ProductName, category, cost, price, wholesale,
                stock, minStock, maxStock, ProductUnit, ProductSaleType, ProductDepartment, Pos.UserName);
        }

        ProductNotice = result.Message;
        if (!result.Success)
            return;

        if (Pos.MulticajaEnabled && ProductMode != "Nuevo" && SelectedProduct?.CentralProductId is int centralId and > 0 &&
            Pos.TryGetMulticajaContext(out var cajaId, out var sessionId, out var userId))
        {
            var previousStock = SelectedProduct!.Stock;
            var sync = await Multicaja.SyncProductStockAsync(
                cajaId, sessionId, userId, centralId, previousStock, stock, ProductName);
            if (sync.Queued)
                ProductNotice += $" {sync.Message}";
            else if (!sync.Success)
                ProductNotice += $" Aviso multicaja: {sync.Message}";
        }

        // Publica nombre/precios/departamento a central para que el sync periódico no revierta la edición.
        if (Pos.MulticajaEnabled)
            await Multicaja.PushCatalogAsync();

        await Pos.ReloadProductsAfterMutationAsync();
        if (ProductMode == "Nuevo")
        {
            ClearProductForm();
            ProductSearchText = string.Empty;
        }
        else
        {
            SelectedProduct = Pos.Products.FirstOrDefault(product => product.Id == result.ProductId);
            if (SelectedProduct is not null)
            {
                FillProductForm(SelectedProduct);
                ProductSearchText = SelectedProduct.Name;
                ProductPage = 1;
            }
        }
    }

    private async Task DeactivateProductAsync()
    {
        if (SelectedProduct is null)
        {
            ProductNotice = "Selecciona un producto de la tabla para eliminarlo.";
            return;
        }
        if (Interlocked.CompareExchange(ref _productDeleteBusy, 1, 0) != 0)
            return;
        try
        {
            if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar {SelectedProduct.Name} del catálogo?"))
                return;

            var productId = SelectedProduct.Id;
            var result = await ConfigStore.DeactivateProductAsync(productId);
            ProductNotice = result.Message;
            if (!result.Success)
                return;

            Pos.RemoveDeactivatedProductLocally(productId);
            ClearProductForm();
            ProductMode = "Eliminar";
            ProductPage = Math.Min(ProductPage, ProductTotalPages);
        }
        finally
        {
            Interlocked.Exchange(ref _productDeleteBusy, 0);
        }
    }

    private async Task DeleteCatalogProductAsync(PosProduct product)
    {
        if (Volatile.Read(ref _productDeleteBusy) != 0)
            return;
        SelectProductForMode(product, "Eliminar");
        await DeactivateProductAsync();
    }

