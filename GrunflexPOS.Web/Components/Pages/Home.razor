    private static string BuildDepartmentDonutGradient(ReportDashboard data)
    {
        if (data.Departments.Count == 0 || data.Total <= 0)
            return "#e2e8f0";
        var parts = new List<string>();
        var cursor = 0m;
        for (var i = 0; i < data.Departments.Count; i++)
        {
            var share = data.Departments[i].SharePercent;
            var next = cursor + share;
            parts.Add($"{DepartmentColor(i)} {cursor.ToString("0.###", CultureInfo.InvariantCulture)}% {next.ToString("0.###", CultureInfo.InvariantCulture)}%");
            cursor = next;
        }

        if (cursor < 100)
            parts.Add($"#e2e8f0 {cursor.ToString("0.###", CultureInfo.InvariantCulture)}% 100%");
        return $"conic-gradient({string.Join(", ", parts)})";
    }

