    private async Task AddScannedProduct()
    {
        // Si hay sugerencia marcada, agregar ese producto (no el texto parcial).
        try
        {
            var selectedId = await JS.InvokeAsync<int>("grunflexKeyboard.getSelectedSaleSuggestionProductId");
            if (selectedId > 0)
            {
                await SubmitSaleProductId(selectedId);
                try { await JS.InvokeAsync<string>("grunflexKeyboard.takeAndClearSaleSearch"); }
                catch (JSException) { }
                return;
            }
        }
        catch (JSException)
        {
        }

        string value;
        try
        {
            value = (await JS.InvokeAsync<string>("grunflexKeyboard.takeAndClearSaleSearch"))?.Trim() ?? string.Empty;
        }
        catch (JSException)
        {
            value = SearchText.Trim();
        }

        SearchText = string.Empty;
        SuggestionIndex = -1;
        if (string.IsNullOrWhiteSpace(value))
            return;

        await EnqueueSaleScanAsync(value);
    }

    private async Task EnqueueSaleScanAsync(string? code)
    {
        if (!string.IsNullOrWhiteSpace(code))
        {
            foreach (var part in ExpandScanPayload(code.Trim()))
                _saleScanQueue.Enqueue(part);
        }

        if (Interlocked.CompareExchange(ref _saleScanDraining, 1, 0) != 0)
            return;

        try
        {
            while (_saleScanQueue.TryDequeue(out var next))
            {
                await ProcessScannedCodeAsync(next);
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            Interlocked.Exchange(ref _saleScanDraining, 0);
            if (!_saleScanQueue.IsEmpty)
                await EnqueueSaleScanAsync(null);
        }
    }

    /// <summary>
    /// Si varios códigos se concatenaron en el input, intenta separarlos por códigos conocidos.
    /// </summary>
    private List<string> ExpandScanPayload(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return [];

        if (Pos.FindProductByBarcode(value) is not null)
            return [value];

        // Un solo pistoleo típico (EAN/UPC ~8–14). Más largo suele ser concatenación.
        if (value.Length <= 18 && IsMostlyDigits(value))
            return [value];

        var results = new List<string>();
        var rest = value;
        while (rest.Length > 0)
        {
            string? matched = null;
            var max = Math.Min(rest.Length, 18);
            for (var len = max; len >= 4; len--)
            {
                var part = rest[..len];
                if (Pos.FindProductByBarcode(part) is not null)
                {
                    matched = part;
                    break;
                }
            }

            if (matched is null)
            {
                if (results.Count == 0)
                    results.Add(value);
                break;
            }

            results.Add(matched);
            rest = rest[matched.Length..];
        }

        return results;
    }

    private static bool IsMostlyDigits(string value)
    {
        var digits = 0;
        foreach (var ch in value)
        {
            if (char.IsDigit(ch))
                digits++;
        }
        return digits >= value.Length - 2;
    }

    private async Task ProcessScannedCodeAsync(string value)
    {
        value = value.Trim();
        if (string.IsNullOrWhiteSpace(value))
            return;

        if (Pos.TryAddScaleLabelBarcode(value))
        {
            SearchText = string.Empty;
            SuggestionIndex = -1;
            await FocusSaleSearch();
            return;
        }

        var product = Pos.FindProductByBarcode(value)
            ?? Pos.Products.FirstOrDefault(x => x.Name.Equals(value, StringComparison.OrdinalIgnoreCase));
        if (product is null && value.Length <= 40)
            product = Pos.Products.FirstOrDefault(x =>
                !string.IsNullOrWhiteSpace(x.Name) &&
                x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        if (product is null)
            Pos.ShowError($"No se encontró un producto para '{value}'.");
        else
            Pos.AddProduct(product);

        SearchText = string.Empty;
        SuggestionIndex = -1;
        await FocusSaleSearch();
    }

    private async Task SelectSuggestedProduct(PosProduct product)
    {
        Pos.AddProduct(product);
        SearchText = string.Empty;
        SuggestionIndex = -1;
        try { await JS.InvokeAsync<string>("grunflexKeyboard.takeAndClearSaleSearch"); }
        catch (JSException) { }
        await FocusSaleSearch();
    }
