    private async Task HandleProductSearchModalKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            if (ProductQuickEditOpen) { ProductQuickEditOpen = false; QuickEditNotice = string.Empty; return; }
            if (ProductEditorOverlayOpen) CloseProductEditorOverlay();
            else CloseProductSearchModal();
            return;
        }
        if (ProductQuickEditOpen || ProductEditorOverlayOpen)
            return;

        var items = ProductPageItems.ToList();
        if (args.Key == "ArrowDown")
        {
            if (ProductSearchSelectedIndex >= items.Count - 1 && ProductPage < ProductTotalPages)
            {
                ChangeProductPage(ProductPage + 1);
                ProductSearchSelectedIndex = 0;
            }
            else
                ProductSearchSelectedIndex = Math.Min(ProductSearchSelectedIndex + 1, Math.Max(items.Count - 1, 0));
            await ScrollProductSearchSelectionAsync();
            return;
        }
        if (args.Key == "ArrowUp")
        {
            if (ProductSearchSelectedIndex <= 0 && ProductPage > 1)
            {
                ChangeProductPage(ProductPage - 1);
                ProductSearchSelectedIndex = Math.Max(0, ProductPageItems.Count() - 1);
            }
            else
                ProductSearchSelectedIndex = Math.Max(ProductSearchSelectedIndex - 1, 0);
            await ScrollProductSearchSelectionAsync();
            return;
        }
        if (args.Key == "Enter")
        {
            var selected = ProductSearchSelectedIndex >= 0 && ProductSearchSelectedIndex < items.Count
                ? items[ProductSearchSelectedIndex]
                : items.FirstOrDefault();
            if (selected is not null)
                await PickProductFromSearchModalAsync(selected);
        }
    }

