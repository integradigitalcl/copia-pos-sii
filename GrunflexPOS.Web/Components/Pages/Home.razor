    }

    private async Task RefreshPrinterListAsync()
    {
        var printers = await Bridge.ListPrintersAsync();
        ConfigPrinterOptions = printers;
        if (!string.IsNullOrWhiteSpace(ConfigPrinterName)
            && printers.Count > 0
            && !printers.Contains(ConfigPrinterName, StringComparer.OrdinalIgnoreCase))
        {
            // Keep saved printer visible via the "(guardada)" option.
        }
        else if (string.IsNullOrWhiteSpace(ConfigPrinterName) && printers.Count == 1)
        {
            ConfigPrinterName = printers[0];
            SyncDrawerConfigFromPrinter(ConfigPrinterName);
            await ConfigStore.LinkDrawerToPrinterAsync(ConfigPrinterName);
            await Pos.ReloadSettingsAsync();
        }
        else if (!string.IsNullOrWhiteSpace(ConfigPrinterName)
                 && printers.Contains(ConfigPrinterName, StringComparer.OrdinalIgnoreCase))
        {
            SyncDrawerConfigFromPrinter(ConfigPrinterName);
            await ConfigStore.LinkDrawerToPrinterAsync(ConfigPrinterName);
            await Pos.ReloadSettingsAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshScannerPortsAsync()
    {
        var ports = await Bridge.ListSerialPortsAsync();
        ConfigScannerPorts = ports;
        if (!string.IsNullOrWhiteSpace(ConfigScannerPort)
            && ports.Count > 0
            && !ports.Contains(ConfigScannerPort, StringComparer.OrdinalIgnoreCase))
        {
            ConfigScannerPort = ports[0];
        }
        else if (string.IsNullOrWhiteSpace(ConfigScannerPort) && ports.Count > 0)
        {
            ConfigScannerPort = ports[0];
        }

        ScannerConfigStatus = ports.Count > 0
            ? $"Puertos: {string.Join(", ", ports)}"
            : "Sin puertos COM (¿bridge en :7390?).";
    }

    private async Task TestScannerConfigurationAsync()
    {
        if (!ConfigScannerEnabled)
        {
            ScannerConfigStatus = "Active el lector serial antes de probar.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ConfigScannerPort))
        {
            ScannerConfigStatus = "Seleccione un puerto COM.";
            return;
        }

        await ConfigStore.SetSettingsAsync(new Dictionary<string, string>
        {
            ["lector_serial_habilitado"] = "true",
            ["lector_serial_puerto"] = ConfigScannerPort.Trim(),
            ["lector_serial_baud"] = NormalizeNumber(ConfigScannerBaud, "9600"),
            ["lector_serial_databits"] = NormalizeNumber(ConfigScannerDataBits, "8"),
            ["lector_serial_data_bits"] = NormalizeNumber(ConfigScannerDataBits, "8"),
            ["lector_serial_parity"] = ConfigScannerParity,
            ["lector_serial_paridad"] = ConfigScannerParity,
            ["lector_serial_stopbits"] = ConfigScannerStopBits,
            ["lector_serial_stop_bits"] = ConfigScannerStopBits,
            ["lector_serial_handshake"] = ConfigScannerHandshake
        });

        var baud = int.TryParse(NormalizeNumber(ConfigScannerBaud, "9600"), out var b) ? b : 9600;
        var data = int.TryParse(NormalizeNumber(ConfigScannerDataBits, "8"), out var d) ? d : 8;
        var result = await Pos.TestScannerConnectionAsync(
            ConfigScannerPort.Trim(), baud, data, ConfigScannerParity, ConfigScannerStopBits, ConfigScannerHandshake);
        ScannerConfigStatus = result.Message;
        ConfigurationNotice = result.Message;
    }

    private async Task RefreshScalePortsAsync()
