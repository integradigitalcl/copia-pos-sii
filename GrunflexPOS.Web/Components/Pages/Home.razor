    /// <summary>
    /// Coincide por código/nombre completo o por cualquier(es) palabra(s) del producto (no solo el inicio).
    /// </summary>
    private static bool MatchesProductText(PosProduct product, string? query, bool includeId = false) =>
        MatchesCodeNameText(product.Code, product.Name, query, includeId ? product.Id.ToString(CultureInfo.InvariantCulture) : null);

    private static bool MatchesCodeNameText(string? code, string? name, string? query, string? idText = null)
    {
        if (string.IsNullOrWhiteSpace(query))
            return true;

        var nameText = name ?? string.Empty;
        var codeText = code ?? string.Empty;
        var q = query.Trim();

        bool Hit(string token) =>
            nameText.Contains(token, StringComparison.OrdinalIgnoreCase) ||
            codeText.Contains(token, StringComparison.OrdinalIgnoreCase) ||
            (!string.IsNullOrEmpty(idText) && idText.Contains(token, StringComparison.OrdinalIgnoreCase));

        if (Hit(q))
            return true;

        var tokens = q.Split([' ', '\t', '/', '-'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return tokens.Length > 1 && tokens.All(Hit);
    }
