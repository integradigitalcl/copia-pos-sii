                            <label>Tamaño (pt)
                                <input type="number" min="6" max="24" @bind="ConfigTicket.FontSize" />
                            </label>
                            <label>Columnas
                                <input type="number" min="20" max="64" @bind="ConfigTicket.Columns" />
                            </label>
                            <label>Ancho de papel (mm)
                                <select @bind="ConfigTicket.PaperWidthMm">
                                    <option value="58">58</option>
                                    <option value="80">80</option>
                                </select>
                            </label>
                            <label class="config-check"><input type="checkbox" @bind="ConfigTicket.BoldText" /><span><strong>Texto en negrita</strong></span></label>
                            <label class="config-check"><input type="checkbox" @bind="ConfigTicket.NormalTotalsFont" /><span><strong>Totales en fuente normal</strong></span></label>
