        await JS.InvokeVoidAsync("eval", $"const a=document.createElement('a');a.href='data:{contentType};base64,{encoded}';a.download='{filename}';a.click();");
    }

    private async Task DownloadBytesAsync(string filename, byte[] content, string contentType)
    {
        var encoded = Convert.ToBase64String(content);
        await JS.InvokeVoidAsync("eval", $"const a=document.createElement('a');a.href='data:{contentType};base64,{encoded}';a.download='{filename}';a.click();");
    }

    private static string Csv(string value) =>
        string.Concat("\"", (value ?? string.Empty).Replace("\"", "\"\""), "\"");

    private readonly System.Collections.Concurrent.ConcurrentQueue<string> _saleScanQueue = new();
    private int _saleScanDraining;
    private int _productDeleteBusy;

    private void HandleSearchInput(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString() ?? string.Empty;
        SuggestionIndex = -1;
    }
    private async Task HandleSaleKey(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowDown")
        {
            if (CurrentSuggestions.Count > 0)
            {
                await MoveSuggestionAsync(1);
                return;
            }

            await NavigateSalesCartWithArrowsAsync("ArrowDown");
            return;
        }
        if (args.Key == "ArrowUp")
        {
            if (CurrentSuggestions.Count > 0)
            {
                await MoveSuggestionAsync(-1);
                return;
            }

            await NavigateSalesCartWithArrowsAsync("ArrowUp");
            return;
        }
        // Enter lo captura keyboard-shortcuts.js (limpia el input al instante).
        // Fallback por si el script no está cargado.
        if (args.Key == "Enter")
            await AddScannedProduct();
    }
    private async Task MoveSuggestionAsync(int direction)
    {
        if (CurrentSuggestions.Count == 0)
            return;
        SuggestionIndex = Math.Clamp(SuggestionIndex + direction, 0, CurrentSuggestions.Count - 1);
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("grunflexKeyboard.scrollSalesSuggestion", SuggestionIndex);
        }
        catch (JSException)
        {
        }
    }

    [JSInvokable]
