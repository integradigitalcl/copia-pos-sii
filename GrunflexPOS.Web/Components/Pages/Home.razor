                            </div>
                            <svg class="products-pixel-deco" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                                <rect x="2" y="2" width="14" height="14" rx="2" fill="#2dd4bf"/>
                                <rect x="20" y="2" width="14" height="14" rx="2" fill="#60a5fa"/>
                                <rect x="2" y="20" width="14" height="14" rx="2" fill="#fb923c"/>
                                <rect x="20" y="20" width="14" height="14" rx="2" fill="#fbbf24"/>
                            </svg>
                        </div>
                        @if (ProductMode != "Nuevo" && SelectedProduct is null)
                        {
                            <div class="products-selection-hint">Selecciona un producto de la tabla para continuar.</div>
                        }
                        <div class="products-form-grid">
                            <label>Código
                                <input id="product-code-input-overlay" list="product-code-suggestions-overlay" value="@ProductCode" @oninput="HandleProductCodeInput" @onkeydown="HandleProductEditorKey" placeholder="Código de barras" autocomplete="off" />
                            </label>
                            <label>Descripción
                                <input id="product-name-input-overlay" list="product-name-suggestions-overlay" value="@ProductName" @oninput="HandleProductNameInput" @onkeydown="HandleProductEditorKey" placeholder="Nombre o descripción del producto" autocomplete="off" />
                            </label>
                            <label>Costo<input value="@ProductCost" @oninput="SetProductCost" inputmode="decimal" placeholder="0" disabled="@(ProductMode == "Eliminar")" /></label>
                            <label>Venta<input value="@ProductPrice" @oninput="SetProductPrice" inputmode="decimal" placeholder="0" disabled="@(ProductMode == "Eliminar")" /></label>
                            <label>Mayoreo<input value="@ProductWholesale" @oninput="SetProductWholesale" inputmode="decimal" placeholder="0" disabled="@(ProductMode == "Eliminar")" /></label>
                            <label>Stock<input value="@ProductStock" @oninput="SetProductStock" inputmode="decimal" placeholder="0" disabled="@(ProductMode == "Eliminar")" /></label>
                            <label>Mínimo<input value="@ProductMinStock" @oninput="SetProductMinStock" inputmode="decimal" placeholder="0" disabled="@(ProductMode == "Eliminar")" /></label>
                            <label>Máximo<input value="@ProductMaxStock" @oninput="SetProductMaxStock" inputmode="decimal" placeholder="0" disabled="@(ProductMode == "Eliminar")" /></label>
                            <label class="products-field-span">Departamento<select value="@ProductDepartment" @onchange="SetProductDepartment" disabled="@(ProductMode == "Eliminar")">@foreach (var dept in ProductDepartments) { <option value="@dept">@dept</option> }</select></label>
                            <label>Tipo de venta<input value="@ProductSaleType" @oninput="SetProductSaleType" placeholder="Unidad" disabled="@(ProductMode == "Eliminar")" /></label>
                            <label>Unidad<input value="@ProductUnit" @oninput="SetProductUnit" placeholder="un." disabled="@(ProductMode == "Eliminar")" /></label>
                        </div>
                        <datalist id="product-code-suggestions-overlay">@foreach (var product in ProductCodeSuggestions) { <option value="@product.Code">@product.Name</option> }</datalist>
                        <datalist id="product-name-suggestions-overlay">@foreach (var product in ProductNameSuggestions) { <option value="@product.Name">@product.Code</option> }</datalist>
                        @if (!string.IsNullOrWhiteSpace(ProductNotice)) { <div class="config-notice">@ProductNotice</div> }
                        <div class="products-editor-actions">
                            @if (ProductMode == "Eliminar")
                            {
                                <button class="danger-button" @onclick="DeactivateProductAsync" disabled="@(SelectedProduct is null)">Eliminar producto</button>
                            }
                            else
                            {
                                <button class="primary-button products-save-button" @onclick="SaveProductAsync">
                                    <span>@(ProductMode == "Nuevo" ? "Guardar producto" : "Actualizar producto")</span>
                                    <svg class="products-pixel-deco products-pixel-deco--btn" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                                        <rect x="2" y="2" width="14" height="14" rx="2" fill="#2dd4bf"/>
                                        <rect x="20" y="2" width="14" height="14" rx="2" fill="#fb923c"/>
                                        <rect x="2" y="20" width="14" height="14" rx="2" fill="#fbbf24"/>
                                        <rect x="20" y="20" width="14" height="14" rx="2" fill="#60a5fa"/>
                                    </svg>
                                </button>
                                <button class="outline-button" @onclick="ClearProductForm">Limpiar</button>
                            }
                        </div>
                    </section>
                </div>
            }
        </main>
    </div>
        </ChildContent>
        <ErrorContent>
            <main class="loading-page">
                <div class="form-error">Ocurrió un error temporal al actualizar la pantalla.</div>
                <button class="primary-button" type="button" @onclick="RecoverFromPosError">Continuar</button>
            </main>
        </ErrorContent>
    </ErrorBoundary>
}

