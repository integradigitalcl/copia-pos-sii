    private void BeginReportSaleEdit()
    {
        if (SelectedReportSaleDetail is null || SelectedReportSaleDetail.Cancelled || !Pos.CanCancelSales)
            return;
        ReportSaleEditQuantities.Clear();
        foreach (var line in SelectedReportSaleDetail.Lines)
            ReportSaleEditQuantities[line.Id] = line.Quantity;
        ReportSaleEditMode = true;
    }

    private void CancelReportSaleEdit()
    {
        ReportSaleEditMode = false;
        ReportSaleEditQuantities.Clear();
    }

    private decimal GetReportEditQty(long lineId) =>
        ReportSaleEditQuantities.TryGetValue(lineId, out var qty) ? qty : 0;

    private void ChangeReportEditQty(long lineId, int delta)
    {
        if (SelectedReportSaleDetail is null)
            return;
        var line = SelectedReportSaleDetail.Lines.FirstOrDefault(x => x.Id == lineId);
        if (line is null)
            return;
        var current = GetReportEditQty(lineId);
        ReportSaleEditQuantities[lineId] = Math.Max(0, Math.Min(line.Quantity, current + delta));
    }

    private decimal GetReportEditTotal()
    {
        if (SelectedReportSaleDetail is null)
            return 0;
        return SelectedReportSaleDetail.Lines.Sum(line =>
        {
            var qty = GetReportEditQty(line.Id);
            if (qty <= 0 || line.Quantity <= 0)
                return 0;
            return Math.Round(line.Total * qty / line.Quantity, 2, MidpointRounding.AwayFromZero);
        });
    }

    private decimal GetReportEditSubtotal()
    {
        if (SelectedReportSaleDetail is null)
            return 0;
        return SelectedReportSaleDetail.Lines.Sum(line =>
        {
            var qty = GetReportEditQty(line.Id);
            if (qty <= 0)
                return 0;
            return Math.Round(line.ListUnitPrice * qty, 2, MidpointRounding.AwayFromZero);
        });
    }

    private decimal GetReportEditDiscount() =>
        Math.Max(0, GetReportEditSubtotal() - GetReportEditTotal());

    private decimal GetReportEditRefundAmount()
    {
        if (SelectedReportSaleDetail is null)
            return 0;
        return Math.Max(0, SelectedReportSaleDetail.Total - GetReportEditTotal());
    }

    private decimal GetReportEditRemovedUnits()
    {
        if (SelectedReportSaleDetail is null)
            return 0;
        return SelectedReportSaleDetail.Lines.Sum(line =>
            Math.Max(0, line.Quantity - GetReportEditQty(line.Id)));
    }

    private decimal GetReportEditLineRefund(ReportSaleLine line)
    {
        var removed = line.Quantity - GetReportEditQty(line.Id);
        if (removed <= 0 || line.Quantity <= 0)
            return 0;
        return Math.Round(line.Total * removed / line.Quantity, 2, MidpointRounding.AwayFromZero);
    }

