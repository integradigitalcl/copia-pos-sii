    private void SelectSection(string section, string? reportView = null)
    {
        if (section == "Configuración" && !Pos.CanManageConfiguration)
        {
            Pos.ShowError("No tienes permiso para acceder a configuración.");
            return;
        }
        if (section == "Productos" && !Pos.CanAccessProducts)
        {
            Pos.ShowError("No tienes permiso para acceder a productos.");
            return;
        }
        if (section == "Inventario" && !Pos.CanAccessInventory)
        {
            Pos.ShowError("No tienes permiso para acceder a inventario.");
            return;
        }
        if (section == "Reportes" && !Pos.CanAccessReports)
        {
            Pos.ShowError("No tienes permiso para acceder a reportes.");
            return;
        }
        if (section != "Reportes" && ActiveSection == "Reportes")
            CancelReportSaleEdit();
        if (section == "Reportes")
        {
            ReportView = reportView ?? "Dashboard";
            if (reportView is null)
            {
                CancelReportSaleEdit();
                SelectedReportSale = null;
                SelectedReportSaleDetail = null;
            }
        }
        ActiveSection = section;
        SearchText = string.Empty;
        ShowReceipts = false;
        ProductSearchModalOpen = false;
        ProductEditorOverlayOpen = false;
        FocusSalesSearchPending = section == "Ventas";
        if (section == "Reportes" || section == "Corte")
            _ = LoadReportsAsync();
        if (section == "Corte")
        {
            ShiftStartTime = Pos.ShiftStartTimeText;
            ShiftEndTime = Pos.ShiftEndTimeText;
        }
    }
