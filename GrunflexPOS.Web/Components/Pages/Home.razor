    private async Task SaveReportSaleEditAsync()
    {
        if (SelectedReportSaleDetail is null || !ReportSaleEditMode)
            return;
        if (!Pos.CanCancelSales)
        {
            ReportNotice = "No tienes permiso para editar tickets.";
            return;
        }

        var edits = SelectedReportSaleDetail.Lines
            .Select(line => new EditSaleLineRequest(line.Id, GetReportEditQty(line.Id)))
            .Where(edit =>
            {
                var original = SelectedReportSaleDetail.Lines.First(x => x.Id == edit.LineId).Quantity;
                return edit.NewQuantity < original;
            })
            .ToArray();
        if (edits.Length == 0)
        {
            ReportNotice = "No hay cambios para guardar.";
            CancelReportSaleEdit();
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"¿Guardar los cambios del ticket #{SelectedReportSaleDetail.TicketNumber}? El stock devuelto se restaurará automáticamente.");
        if (!confirmed)
            return;

        var syncToCentral = ShouldSyncReportSaleToMulticaja();
        if (syncToCentral && Pos.TryGetMulticajaContext(out var cajaId, out var sessionId, out var userId))
        {
            foreach (var edit in edits)
            {
                var line = SelectedReportSaleDetail.Lines.First(x => x.Id == edit.LineId);
                var removed = (int)Math.Round(line.Quantity - edit.NewQuantity, MidpointRounding.AwayFromZero);
                if (removed <= 0)
                    continue;
                var central = await Multicaja.RefundLineAsync(
                    cajaId, sessionId, userId, (int)SelectedReportSaleDetail.TicketNumber,
                    line.Code, line.ProductName, line.UnitPrice, removed);
                if (!central.Success && !central.Queued)
                {
                    if (IsMulticajaScopeError(central.Message))
                    {
                        syncToCentral = false;
                        break;
                    }
                    ReportNotice = central.Message;
                    return;
                }
                if (central.Queued)
                    ReportNotice = central.Message;
            }
        }

        var result = await Reports.EditSaleAsync(SelectedReportSaleDetail.Id, edits, Pos.UserName);
        ReportNotice = result.Message + (syncToCentral ? string.Empty : LocalOnlyCentralNotice);
        if (!result.Success)
            return;

        CancelReportSaleEdit();
        await LoadReportsAsync();
        await Pos.RefreshAsync();
        await SelectReportSaleAsync(SelectedReportSale!);
    }

