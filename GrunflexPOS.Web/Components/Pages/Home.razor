    private async Task TestScaleConfigurationAsync()
    {
        if (!ConfigScaleEnabled)
        {
            ScaleConfigStatus = "Active la báscula antes de probar.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ConfigScalePort))
        {
            ScaleConfigStatus = "Seleccione un puerto COM.";
            return;
        }

        await ConfigStore.SetSettingsAsync(new Dictionary<string, string>
        {
            ["bascula_activa"] = "true",
            ["bascula_habilitada"] = "true",
            ["bascula_puerto"] = ConfigScalePort.Trim(),
            ["bascula_driver"] = ConfigScaleDriver,
            ["bascula_driver_puerto"] = $"Serial {ConfigScalePort.Trim()} (driver OK)",
            ["bascula_codigo_inicial"] = string.IsNullOrWhiteSpace(ConfigScalePrefix) ? "2000" : ConfigScalePrefix.Trim(),
            ["bascula_etiqueta_precio"] = ConfigScalePriceLabels.ToString().ToLowerInvariant(),
            ["bascula_etiqueta_peso"] = ConfigScaleWeightLabels.ToString().ToLowerInvariant()
        });
        await Pos.ReloadSettingsAsync();
        var (ok, message, _) = await Pos.TestScaleAsync();
        ScaleConfigStatus = ok ? message : "Error: " + message;
        ConfigurationNotice = ScaleConfigStatus;
    }

