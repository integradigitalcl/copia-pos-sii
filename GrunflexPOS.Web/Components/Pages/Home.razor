                                <rect x="4" y="12" width="10" height="10" rx="2" fill="#a78bfa"/><rect x="16" y="12" width="10" height="10" rx="2" fill="#818cf8"/><rect x="28" y="12" width="10" height="10" rx="2" fill="#60a5fa"/>
