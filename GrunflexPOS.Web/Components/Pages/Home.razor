    private decimal GetReportEditQty(long lineId) =>
        ReportSaleEditQuantities.TryGetValue(lineId, out var qty) ? qty : 0;

    private void ChangeReportEditQty(long lineId, int delta)
    {
        if (SelectedReportSaleDetail is null)
            return;
        var line = SelectedReportSaleDetail.Lines.FirstOrDefault(x => x.Id == lineId);
        if (line is null)
            return;
        var current = GetReportEditQty(lineId);
        ReportSaleEditQuantities[lineId] = Math.Max(0, Math.Min(line.Quantity, current + delta));
    }

    private decimal GetReportEditTotal()
    {
        if (SelectedReportSaleDetail is null)
            return 0;
        return SelectedReportSaleDetail.Lines.Sum(line =>
        {
            var qty = GetReportEditQty(line.Id);
            if (qty <= 0 || line.Quantity <= 0)
                return 0;
            return Math.Round(line.Total * qty / line.Quantity, 2, MidpointRounding.AwayFromZero);
        });
    }

    private decimal GetReportEditSubtotal()
    {
        if (SelectedReportSaleDetail is null)
            return 0;
        return SelectedReportSaleDetail.Lines.Sum(line =>
        {
            var qty = GetReportEditQty(line.Id);
            if (qty <= 0)
                return 0;
            return Math.Round(line.ListUnitPrice * qty, 2, MidpointRounding.AwayFromZero);
        });
    }

    private decimal GetReportEditDiscount() =>
        Math.Max(0, GetReportEditSubtotal() - GetReportEditTotal());

    private decimal GetReportEditRefundAmount()
    {
        if (SelectedReportSaleDetail is null)
            return 0;
        return Math.Max(0, SelectedReportSaleDetail.Total - GetReportEditTotal());
    }

    private decimal GetReportEditRemovedUnits()
    {
        if (SelectedReportSaleDetail is null)
            return 0;
        return SelectedReportSaleDetail.Lines.Sum(line =>
            Math.Max(0, line.Quantity - GetReportEditQty(line.Id)));
    }

    private decimal GetReportEditLineRefund(ReportSaleLine line)
    {
        var removed = line.Quantity - GetReportEditQty(line.Id);
        if (removed <= 0 || line.Quantity <= 0)
            return 0;
        return Math.Round(line.Total * removed / line.Quantity, 2, MidpointRounding.AwayFromZero);
    }

    private bool ShouldSyncReportSaleToMulticaja() =>
        SelectedReportSaleDetail is not null &&
        Pos.IsCurrentCashSessionSale(SelectedReportSaleDetail.CashSessionId) &&
        Pos.TryGetMulticajaContext(out _, out _, out _);

    private static bool IsMulticajaScopeError(string message) =>
        message.Contains("sesión/caja", StringComparison.OrdinalIgnoreCase) ||
        message.Contains("sesion/caja", StringComparison.OrdinalIgnoreCase);

    private string LocalOnlyCentralNotice =>
        Pos.MulticajaEnabled ? " · Solo turno local (venta de otro turno de caja)" : string.Empty;

    private async Task SaveReportSaleEditAsync()
    {
        if (SelectedReportSaleDetail is null || !ReportSaleEditMode)
            return;
        if (!Pos.CanCancelSales)
        {
            ReportNotice = "No tienes permiso para editar tickets.";
            return;
        }

        var edits = SelectedReportSaleDetail.Lines
            .Select(line => new EditSaleLineRequest(line.Id, GetReportEditQty(line.Id)))
            .Where(edit =>
            {
                var original = SelectedReportSaleDetail.Lines.First(x => x.Id == edit.LineId).Quantity;
                return edit.NewQuantity < original;
            })
            .ToArray();
        if (edits.Length == 0)
        {
            ReportNotice = "No hay cambios para guardar.";
            CancelReportSaleEdit();
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"¿Guardar los cambios del ticket #{SelectedReportSaleDetail.TicketNumber}? El stock devuelto se restaurará automáticamente.");
        if (!confirmed)
            return;

        var syncToCentral = ShouldSyncReportSaleToMulticaja();
        if (syncToCentral && Pos.TryGetMulticajaContext(out var cajaId, out var sessionId, out var userId))
        {
            foreach (var edit in edits)
            {
                var line = SelectedReportSaleDetail.Lines.First(x => x.Id == edit.LineId);
                var removed = (int)Math.Round(line.Quantity - edit.NewQuantity, MidpointRounding.AwayFromZero);
                if (removed <= 0)
                    continue;
                var central = await Multicaja.RefundLineAsync(
                    cajaId, sessionId, userId, (int)SelectedReportSaleDetail.TicketNumber,
                    line.Code, line.ProductName, line.UnitPrice, removed);
                if (!central.Success && !central.Queued)
                {
                    if (IsMulticajaScopeError(central.Message))
                    {
                        syncToCentral = false;
                        break;
                    }
                    ReportNotice = central.Message;
                    return;
                }
                if (central.Queued)
                    ReportNotice = central.Message;
            }
        }

        var result = await Reports.EditSaleAsync(SelectedReportSaleDetail.Id, edits, Pos.UserName);
        ReportNotice = result.Message + (syncToCentral ? string.Empty : LocalOnlyCentralNotice);
        if (!result.Success)
            return;

        // Si hay devolución en efectivo, abrir el cajón para entregar el cambio.
        var refund = GetReportEditRefundAmount();
        if (refund > 0 && Pos.DrawerEnabled)
            await Bridge.OpenDrawerAsync();

        CancelReportSaleEdit();
        await LoadReportsAsync();
        await Pos.RefreshAsync();
        await SelectReportSaleAsync(SelectedReportSale!);
    }

