    private void SyncReportRangeTextsFromPeriod()
    {
        var (from, to) = ComputeReportRange(ReportPeriod);
        ReportFromText = from.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        ReportToText = to.AddDays(-1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private (DateTime From, DateTime To) ComputeReportRange(string period)
    {
        var today = DateTime.Today;
        DateTime from;
        DateTime to;
        switch (period)
        {
            case "Mes":
                from = new DateTime(today.Year, today.Month, 1);
                to = from.AddMonths(1);
                break;
            case "MesAnterior":
                from = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
                to = new DateTime(today.Year, today.Month, 1);
                break;
            case "Anio":
                from = new DateTime(today.Year, 1, 1);
                to = from.AddYears(1);
                break;
            case "Personalizado":
                if (!DateTime.TryParseExact(ReportFromText, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                        DateTimeStyles.None, out from))
                    from = today;
                if (!DateTime.TryParseExact(ReportToText, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                        DateTimeStyles.None, out var toInclusive))
                    toInclusive = today;
                if (toInclusive < from)
                    (from, toInclusive) = (toInclusive, from);
                to = toInclusive.AddDays(1);
                break;
            case "Hoy":
                from = today;
                to = today.AddDays(1);
                break;
            case "7Dias":
                from = today.AddDays(-6);
                to = today.AddDays(1);
                break;
            default: // Semana actual (lunes–domingo)
            {
                var diff = ((int)today.DayOfWeek + 6) % 7; // Monday=0
                from = today.AddDays(-diff);
                to = from.AddDays(7);
                break;
            }
        }

        return (DateTime.SpecifyKind(from, DateTimeKind.Unspecified),
            DateTime.SpecifyKind(to, DateTimeKind.Unspecified));
    }

    private (DateTime From, DateTime To) GetReportRange() => ComputeReportRange(ReportPeriod);

