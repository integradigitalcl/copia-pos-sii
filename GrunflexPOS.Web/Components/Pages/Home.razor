                                <svg class="products-tab-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm1 15h-3v3h-2v-3H7v-2h3v-3h2v3h3v2zm-2-9V3.5L18.5 8H13z"/></svg>
                                Nuevo
                            </button>
                            <button type="button" class="products-tab products-tab-modificar @(ProductMode == "Modificar" ? "active" : "")" @onclick='() => SetProductMode("Modificar")'>
                                <svg class="products-tab-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                Modificar
                            </button>
