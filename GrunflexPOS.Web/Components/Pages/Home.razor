                                {
                                    var product = catalogItems[i];
                                    var idx = i;
                                    <tr data-catalog-index="@idx" class="@(SelectedProduct?.Id == product.Id ? "selected" : "")" @onclick="() => SelectProduct(product)">
                                        <td class="muted">#@product.Id</td>
                                        <td>@product.Code</td>
                                        <td><strong>@product.Name</strong><small>@product.Department</small></td>
                                        <td>@Pos.FormatCurrency(product.Cost)</td>
                                        <td>@Pos.FormatCurrency(product.Price)</td>
                                        <td>@Pos.FormatCurrency(product.WholesalePrice)</td>
                                        <td><span class="stock-value @(product.Stock <= 0 ? "empty" : IsLowStock(product) ? "low" : "ok")">@product.Stock.ToString("0.##") @product.Unit</span></td>
                                        <td><span class="products-dept-badge">@product.Department</span></td>
                                        <td class="products-row-actions">
                                            <button type="button" class="small-action products-action-edit" title="Modificar" @onclick:stopPropagation="true" @onclick='() => SelectProductForMode(product, "Modificar")'>
                                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                            </button>
                                            <button type="button" class="small-action products-action-delete" title="Eliminar" @onclick:stopPropagation="true" @onclick="() => DeleteCatalogProductAsync(product)">
                                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody></table></div>
                            <div class="products-pagination">
                                <span>Página @ProductPage de @ProductTotalPages · @ProductFiltered.Count() productos</span>
                                <span>
                                    <button type="button" @onclick="() => ChangeProductPage(ProductPage - 1)" disabled="@(ProductPage <= 1)">‹</button>
                                    <button type="button" @onclick="() => ChangeProductPage(ProductPage + 1)" disabled="@(ProductPage >= ProductTotalPages)">›</button>
                                    <select value="@ProductPageSize" @onchange="ChangeProductPageSize"><option value="10">10 por página</option><option value="20">20 por página</option><option value="50">50 por página</option><option value="100">100 por página</option></select>
                                </span>
                            </div>
                            <svg class="products-catalog-pixel products-catalog-pixel--bl" viewBox="0 0 48 28" aria-hidden="true" focusable="false">
                                <rect x="0" y="16" width="10" height="10" rx="1.5" fill="#2dd4bf"/><rect x="12" y="16" width="10" height="10" rx="1.5" fill="#60a5fa"/><rect x="6" y="4" width="10" height="10" rx="1.5" fill="#fb923c"/><rect x="24" y="10" width="10" height="10" rx="1.5" fill="#fbbf24"/><rect x="36" y="16" width="10" height="10" rx="1.5" fill="#a78bfa"/>
                            </svg>
                            <svg class="products-catalog-pixel products-catalog-pixel--br" viewBox="0 0 48 28" aria-hidden="true" focusable="false">
                                <rect x="26" y="16" width="10" height="10" rx="1.5" fill="#60a5fa"/><rect x="38" y="16" width="10" height="10" rx="1.5" fill="#2dd4bf"/><rect x="32" y="4" width="10" height="10" rx="1.5" fill="#fb923c"/><rect x="14" y="10" width="10" height="10" rx="1.5" fill="#fbbf24"/><rect x="2" y="16" width="10" height="10" rx="1.5" fill="#a78bfa"/>
                            </svg>
                        </section>
                    </div>
                </div>
                <div class="pos-section inventory-workspace" data-section="Inventario" hidden="@(ActiveSection != "Inventario")">
                    <div class="inventory-page-heading">
                        @ModuleHeading("OPERACIÓN", "Inventario", "Administra existencias, movimientos y reportes del inventario.")
                        <svg class="inventory-pixel-deco" viewBox="0 0 56 40" aria-hidden="true" focusable="false">
                            <rect x="28" y="0" width="12" height="12" rx="2" fill="#a78bfa"/>
                            <rect x="42" y="0" width="12" height="12" rx="2" fill="#60a5fa"/>
                            <rect x="14" y="14" width="12" height="12" rx="2" fill="#818cf8"/>
                            <rect x="28" y="14" width="12" height="12" rx="2" fill="#fbbf24"/>
                            <rect x="42" y="14" width="12" height="12" rx="2" fill="#2dd4bf"/>
                            <rect x="42" y="28" width="12" height="12" rx="2" fill="#c4b5fd"/>
                        </svg>
                    </div>
                    <div class="inventory-toolbar">
                        <button type="button" class="inventory-tool @(InventoryMode == "Agregar" ? "active" : "")" @onclick='() => SetInventoryMode("Agregar")'><span aria-hidden="true">＋</span> Agregar</button>
                        <button type="button" class="inventory-tool @(InventoryMode == "Ajustes" ? "active" : "")" @onclick="OpenInventoryAjustesProductEditor"><span aria-hidden="true">⚙</span> Ajustes</button>
                        <button type="button" class="inventory-tool @(InventoryMode == "Bajos" ? "active" : "")" @onclick='() => SetInventoryMode("Bajos")'><span aria-hidden="true">⚠</span> Productos bajos</button>
                        <button type="button" class="inventory-tool @(InventoryMode == "Reporte" ? "active" : "")" @onclick='() => SetInventoryMode("Reporte")'><span aria-hidden="true">▤</span> Reporte inventario</button>
                        <button type="button" class="inventory-tool @(InventoryMode == "Movimientos" ? "active" : "")" @onclick='() => SetInventoryMode("Movimientos")'><span aria-hidden="true">↕</span> Movimientos</button>
                        <button type="button" class="inventory-tool @(InventoryMode == "Kardex" ? "active" : "")" @onclick='() => SetInventoryMode("Kardex")'><span aria-hidden="true">▥</span> Kardex</button>
                        <button type="button" class="inventory-tool" @onclick="ExportInventoryAsync"><span aria-hidden="true">⇩</span> Exportar Excel</button>
                        <label class="inventory-import-button inventory-tool"><span aria-hidden="true">⇧</span> Importar Excel/CSV<InputFile accept=".xlsx,.csv,.txt" OnChange="ImportInventoryAsync" /></label>
                    </div>
                    @if (InventoryMode == "Bajos")
                    {
                        <section class="data-card inventory-action-card">
                            <div class="inventory-action-heading">
                                <span class="inventory-card-ico" aria-hidden="true">⚠</span>
                                <div><span class="eyebrow">ALERTAS</span><h2>Productos bajos de stock</h2><p>Se listan productos con existencia igual o menor al mínimo del producto o al umbral global del POS.</p></div>
                            </div>
                            <div class="inventory-adjust-grid">
                                <label>Umbral global del POS<input value="@InventoryLowStockThresholdText" @oninput="SetInventoryLowStockThresholdText" inputmode="decimal" placeholder="5" /></label>
                                <button class="primary-button inventory-save-button" @onclick="SaveInventoryLowStockThresholdAsync">Guardar umbral</button>
                                <div class="inventory-selected"><span>Productos bajos ahora</span><strong>@InventoryLowStockCount</strong><small>Mín. por producto en Productos · si está en 0, se usa el umbral global (@InventoryLowStockThreshold.ToString("0.##"))</small></div>
                            </div>
                        </section>
                    }
                    @if (InventoryMode == "Agregar" || InventoryMode == "Ajustes")
                    {
                        <section class="data-card inventory-action-card">
                            <div class="inventory-action-heading">
                                <span class="inventory-card-ico" aria-hidden="true">▣</span>
                                <div><span class="eyebrow">INVENTARIO</span><h2>@(InventoryMode == "Ajustes" ? "Ajustar inventario" : "Agregar inventario")</h2><p>Selecciona un producto e indica una cantidad positiva o negativa.</p></div>
                                <svg class="inventory-pixel-deco inventory-pixel-deco--card" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                                    <rect x="2" y="2" width="14" height="14" rx="2" fill="#2dd4bf"/>
                                    <rect x="20" y="2" width="14" height="14" rx="2" fill="#60a5fa"/>
                                    <rect x="2" y="20" width="14" height="14" rx="2" fill="#fb923c"/>
                                    <rect x="20" y="20" width="14" height="14" rx="2" fill="#fbbf24"/>
                                </svg>
                            </div>
                            <div class="inventory-adjust-grid">
                                <label>Buscar por código o nombre
                                    <input id="inventory-product-search" value="@InventoryProductQuery" @oninput="HandleInventoryProductInput" @onkeydown="HandleInventorySearchKey" placeholder="Código o nombre" autocomplete="off" />
                                    @if (!string.IsNullOrWhiteSpace(InventoryProductQuery) && InventoryProductSuggestions.Any())
                                    {
                                        <div class="sales-suggestions inventory-product-suggestions" role="listbox">
                                            @{ var invSuggestionIndex = 0; }
                                            @foreach (var product in InventoryProductSuggestions)
                                            {
                                                <button type="button" role="option" data-inventory-suggestion-index="@invSuggestionIndex" aria-selected="@(InventorySuggestionIndex == invSuggestionIndex)" class="@(InventorySuggestionIndex == invSuggestionIndex ? "selected" : "")" @onclick="() => SelectInventoryProductFromList(product)">
                                                    <span>@product.Code - @product.Name</span>
                                                </button>
                                                invSuggestionIndex++;
                                            }
                                        </div>
                                    }
                                </label>
                                <div class="inventory-selected">
                                    <span>Producto seleccionado</span>
                                    <strong>@(InventorySelectedProduct?.Name ?? "Ninguno")</strong>
                                    @if (InventorySelectedProduct is not null && InventoryInlineStockEdit)
                                    {
                                        <div class="inventory-inline-edit">
                                            <small>Nuevo stock:</small>
                                            <input class="inventory-inline-input" value="@InventoryInlineStockText" @oninput="e => InventoryInlineStockText = e.Value?.ToString() ?? string.Empty" inputmode="decimal" @onkeydown="HandleInventoryInlineStockKey" />
                                            <button class="small-action" title="Guardar" @onclick="SaveInventoryInlineStockAsync">✔</button>
                                            <button class="small-action" title="Cancelar" @onclick="() => InventoryInlineStockEdit = false">✕</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="inventory-stock-badge @(InventorySelectedProduct is null ? "" : InventorySelectedProduct.Stock <= 0 ? "empty" : IsLowStock(InventorySelectedProduct) ? "low" : "ok")" @ondblclick="BeginInventoryInlineStockEdit" title="@(InventorySelectedProduct is not null ? "Doble clic para editar stock" : "")">Stock actual: @(InventorySelectedProduct?.Stock.ToString("0.##") ?? "—")</span>
                                    }
                                </div>
                                <label>Cantidad (+/-)
                                    <div class="inventory-qty">
                                        <button type="button" class="inventory-qty-btn" @onclick="() => NudgeInventoryQuantity(-1)" aria-label="Restar">−</button>
                                        <input value="@InventoryQuantityText" @oninput="e => InventoryQuantityText = e.Value?.ToString() ?? string.Empty" inputmode="numeric" @onkeydown="HandleInventoryAdjustKey" />
                                        <button type="button" class="inventory-qty-btn" @onclick="() => NudgeInventoryQuantity(1)" aria-label="Sumar">＋</button>
                                    </div>
                                </label>
                                <button type="button" class="primary-button inventory-save-button" @onclick="SaveInventoryAdjustmentAsync">
                                    <span>Guardar movimiento</span>
                                    <svg class="inventory-pixel-deco inventory-pixel-deco--btn" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                                        <rect x="2" y="2" width="14" height="14" rx="2" fill="#2dd4bf"/>
                                        <rect x="20" y="2" width="14" height="14" rx="2" fill="#fb923c"/>
                                        <rect x="2" y="20" width="14" height="14" rx="2" fill="#fbbf24"/>
                                        <rect x="20" y="20" width="14" height="14" rx="2" fill="#60a5fa"/>
                                    </svg>
                                </button>
                            </div>
                        </section>
                    }
                    @if (InventoryMode == "Reporte")
                    {
                        <section class="data-card inventory-report-card"><div class="inventory-report-header"><div><span class="eyebrow">REPORTE</span><h2>Reporte de inventario</h2><p>@InventoryFilteredProducts.Count() productos en el filtro actual.</p></div><label>Departamento<select @bind="InventoryDepartment">
                            @foreach (var department in InventoryDepartments)
                            {
                                <option>@department</option>
                            }
                        </select></label></div><div class="inventory-stats"><div><span>Costo total</span><strong>@Pos.FormatCurrency(InventoryFilteredProducts.Sum(x => x.Cost * x.Stock))</strong></div><div><span>Unidades</span><strong>@InventoryFilteredProducts.Sum(x => x.Stock).ToString("0.##")</strong></div><div><span>Productos</span><strong>@InventoryFilteredProducts.Count()</strong></div></div></section>
                    }
                    @if (InventoryMode == "Movimientos" || InventoryMode == "Kardex")
                    {
                        @InventoryHistoryTable()
                    }
                    @if (InventoryMode != "Movimientos" && InventoryMode != "Kardex")
                    {
                        @InventoryListTable()
                    }
                    @if (!string.IsNullOrWhiteSpace(InventoryNotice)) { <div class="config-notice">@InventoryNotice</div> }
                </div>
                <div class="pos-section" data-section="Other" hidden="@(ActiveSection is "Ventas" or "Productos" or "Inventario")">
                @if (ActiveSection == "Reportes")
                {
                    <section class="page-heading reports-page-heading">
                        <div>
                            <span class="eyebrow">GESTIÓN</span>
                            <h1>Reportes de ventas</h1>
                            <p>Analiza el rendimiento, la rentabilidad y la composición de tus ventas.</p>
                        </div>
                        <div class="reports-export-wrap">
                            <button type="button" class="primary-button reports-export-btn" @onclick="ToggleReportExportMenu">Exportar reporte ▾</button>
                            @if (ReportExportMenuOpen)
                            {
                                <div class="reports-export-menu">
                                    <button type="button" @onclick="ExportReportPdfAsync">Exportar PDF</button>
                                    <button type="button" @onclick="ExportSalesCsvAsync">Exportar CSV</button>
                                </div>
                            }
                        </div>
                    </section>
                    <div class="reports-toolbar reports-analytics-toolbar">
                        <div class="reports-tabs"><button class="@(ReportView == "Dashboard" ? "active" : "")" @onclick='() => SetReportView("Dashboard")'>Resumen</button><button class="@(ReportView == "Ventas" ? "active" : "")" @onclick='() => SetReportView("Ventas")'>Ventas del día</button></div>
                        <div class="reports-period-presets">
                            @foreach (var preset in ReportPeriodPresets)
                            {
                                <button type="button" class="@(ReportPeriod == preset.Key ? "active" : "")" @onclick="() => SetReportPeriodPreset(preset.Key)">@preset.Label</button>
                            }
                        </div>
                        <label>Desde<input type="date" value="@ReportFromText" @onchange="ChangeReportFrom" disabled="@(ReportPeriod != "Personalizado")" /></label>
                        <label>Hasta<input type="date" value="@ReportToText" @onchange="ChangeReportTo" disabled="@(ReportPeriod != "Personalizado")" /></label>
                        <button class="primary-button" @onclick="LoadReportsAsync">Aplicar filtros</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ReportNotice))
                    {
                        <div class="reports-notice">@ReportNotice</div>
                    }
                    @if (ReportView == "Dashboard" && ReportData is not null)
                    {
                        <div class="reports-kpi-grid reports-kpi-analytics">
                            <div class="report-kpi">
                                <span class="report-kpi-icon">▣</span>
                                <span>Ventas totales</span>
                                <strong>@Pos.FormatCurrency(ReportData.Total)</strong>
                                <small class="@(ReportData.Variation >= 0 ? "positive" : "negative")">@(ReportData.Variation >= 0 ? "↑" : "↓") @Math.Abs(ReportData.Variation).ToString("0.##")% @ReportComparisonLabel</small>
                            </div>
                            <div class="report-kpi">
                                <span class="report-kpi-icon">◈</span>
                                <span>Ganancia</span>
                                <strong>@Pos.FormatCurrency(ReportData.Profit)</strong>
                                <small class="@(ReportData.ProfitVariation >= 0 ? "positive" : "negative")">@(ReportData.ProfitVariation >= 0 ? "↑" : "↓") @Math.Abs(ReportData.ProfitVariation).ToString("0.##")% @ReportComparisonLabel</small>
                            </div>
                            <div class="report-kpi">
                                <span class="report-kpi-icon">▤</span>
                                <span>Número de ventas</span>
                                <strong>@ReportData.Transactions</strong>
                                <small class="@(ReportData.TxnVariation >= 0 ? "positive" : "negative")">@(ReportData.TxnVariation >= 0 ? "↑" : "↓") @Math.Abs(ReportData.TxnVariation).ToString("0.##")% @ReportComparisonLabel</small>
                            </div>
                            <div class="report-kpi">
                                <span class="report-kpi-icon">%</span>
                                <span>Margen promedio</span>
                                <strong>@ReportData.AvgMargin.ToString("0.##")%</strong>
                                <small class="@(ReportData.MarginVariation >= 0 ? "positive" : "negative")">@(ReportData.MarginVariation >= 0 ? "↑" : "↓") @Math.Abs(ReportData.MarginVariation).ToString("0.##")% @ReportComparisonLabel</small>
                            </div>
                        </div>
                        <div class="reports-chart-grid reports-analytics-charts">
                            <section class="data-card report-chart-card">
                                <div class="report-card-heading"><div><h2>Ventas y ganancias</h2></div>
                                    <div class="report-chart-legend"><span class="leg-sales">Ventas</span><span class="leg-profit">Ganancia</span></div>
                                </div>
                                @{
                                    var maxSales = ReportData.DaySeries.Count == 0 ? 1m : Math.Max(1m, ReportData.DaySeries.Max(x => x.Sales));
                                    var maxProfitAbs = ReportData.DaySeries.Count == 0 ? 1m : Math.Max(1m, ReportData.DaySeries.Max(x => Math.Abs(x.Profit)));
                                    var chartMax = Math.Max(maxSales, maxProfitAbs);
                                    var payMax = ReportData.Payments.Count == 0 ? 1m : Math.Max(1m, ReportData.Payments.Max(x => x.Total));
                                }
                                <div class="report-combo-chart">
                                    @foreach (var point in ReportData.DaySeries)
                                    {
                                        var salesH = Math.Max(4m, point.Sales / chartMax * 100m);
                                        var profitH = Math.Max(0m, Math.Abs(point.Profit) / chartMax * 100m);
                                        <div class="report-combo-col">
                                            <div class="report-combo-plot">
                                                <i class="sales-bar" style="height:@($"{salesH:0.#}%")" title="@Pos.FormatCurrency(point.Sales)"></i>
                                                <span class="profit-dot" style="bottom:@($"{profitH:0.#}%")" title="@Pos.FormatCurrency(point.Profit)"></span>
                                            </div>
                                            <small>@point.Label</small>
                                        </div>
                                    }
                                </div>
                            </section>
                            <section class="data-card report-chart-card">
                                <div class="report-card-heading"><div><h2>Ventas por departamento</h2></div></div>
                                <div class="report-donut-layout">
                                    <div class="report-donut" style="background:@BuildDepartmentDonutGradient(ReportData)"></div>
                                    <div class="report-donut-legend">
                                        @for (var i = 0; i < ReportData.Departments.Count; i++)
                                        {
                                            var dept = ReportData.Departments[i];
                                            <div>
                                                <span><i style="background:@DepartmentColor(i)"></i>@dept.Department</span>
                                                <strong>@Pos.FormatCurrency(dept.Revenue) <small>@dept.SharePercent.ToString("0.0")%</small></strong>
                                            </div>
                                        }
                                        @if (ReportData.Departments.Count == 0)
                                        {
                                            <p class="report-empty">Sin ventas por departamento en el periodo.</p>
                                        }
                                    </div>
                                </div>
                            </section>
                        </div>
                        <div class="reports-detail-grid reports-analytics-detail">
                            <section class="data-card">
                                <div class="report-card-heading"><div><h2>Ventas por forma de pago</h2></div></div>
                                <div class="report-payment-bars">
                                    @if (ReportData.Payments.Count == 0)
                                    {
                                        <p class="report-empty">Sin pagos en el periodo.</p>
                                    }
                                    else
                                    {
                                        @for (var i = 0; i < ReportData.Payments.Count; i++)
                                        {
                                            var payment = ReportData.Payments[i];
                                            var width = Math.Max(4m, payment.Total / payMax * 100m);
                                            <div class="report-payment-row">
                                                <div class="report-payment-meta"><span>@payment.Method</span><strong>@Pos.FormatCurrency(payment.Total)</strong></div>
                                                <div class="report-payment-track"><i style="width:@($"{width:0.#}%");background:@PaymentBarColor(i)"></i></div>
                                            </div>
                                        }
                                    }
                                </div>
                            </section>
                            <section class="data-card">
                                <div class="report-card-heading"><div><h2>Ventas por día</h2></div></div>
                                <div class="report-day-table">
                                    @foreach (var point in ReportData.DaySeries)
                                    {
                                        <div><span>@point.Label</span><strong>@Pos.FormatCurrency(point.Sales)</strong></div>
                                    }
                                </div>
                            </section>
                            <section class="data-card">
                                <div class="report-card-heading"><div><h2>Ganancia por departamento</h2></div></div>
                                <div class="report-day-table">
                                    @if (ReportData.Departments.Count == 0)
                                    {
                                        <p class="report-empty">Sin datos.</p>
                                    }
                                    else
                                    {
                                        @foreach (var dept in ReportData.Departments.OrderByDescending(x => x.Profit))
                                        {
                                            <div><span>@dept.Department</span><strong class="@(dept.Profit >= 0 ? "positive" : "negative")">@Pos.FormatCurrency(dept.Profit)</strong></div>
                                        }
                                    }
                                </div>
                            </section>
                        </div>
                        <section class="data-card report-tax-card">
                            <div class="report-card-heading"><div><h2>Impuestos</h2></div></div>
                            <div class="report-tax-grid">
                                <div><span>IVA (@ReportData.TaxRate.ToString("0.####")%) · Cobrado</span><strong>@Pos.FormatCurrency(ReportData.TaxCollected)</strong></div>
                                <div><span>IVA (@ReportData.TaxRate.ToString("0.####")%) · Ventas gravadas</span><strong>@Pos.FormatCurrency(ReportData.TaxableSales)</strong></div>
                            </div>
                        </section>
                        <section class="data-card report-personal-consumption-card">
                            <div class="report-card-heading">
                                <div><span class="eyebrow">INTERNO</span><h2>Consumo personal</h2></div>
                                @if (ReportData.PersonalConsumption.Count > 0)
                                {
                                    <span>@Pos.FormatCurrency(ReportData.PersonalConsumption.Sum(x => x.Total))</span>
                                }
                            </div>
                            <div class="report-list">
                                @if (ReportData.PersonalConsumption.Count == 0)
                                {
                                    <p class="report-empty">Sin consumo personal en el periodo.</p>
                                }
                                else
                                {
                                    @foreach (var item in ReportData.PersonalConsumption)
                                    {
                                        <div>
                                            <span>
                                                <b>@item.ProductName</b>
                                                <small>@item.Quantity.ToString("0.##") uds · Cajero: @item.Cashier · Ticket #@item.TicketNumber · @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                            </span>
                                            <strong>@Pos.FormatCurrency(item.Total)</strong>
                                        </div>
                                    }
                                }
                            </div>
                        </section>
                    }
                    else if (ReportView == "Ventas" && SalesReport is not null)
                    {
                        <section class="data-card reports-sales-filters"><div class="reports-filter-row"><label>Fecha<input type="date" value="@ReportDateText" @onchange="ChangeReportDate" /></label><label>Cajero<select value="@ReportCashier" @onchange="ChangeReportCashier"><option>Todos</option>@foreach (var cashier in ReportCashiers) { <option value="@cashier">@cashier</option> }</select></label><label class="report-search-field">Buscar<input value="@ReportSearch" @oninput="ChangeReportSearch" placeholder="Folio, cliente o cajero" /></label><label class="report-check"><input type="checkbox" checked="@ReportCreditOnly" @onchange="ChangeReportCredit" /> Solo transferencia</label><button class="outline-button" @onclick="LoadSalesReportAsync">Aplicar filtros</button></div></section>
