    private async Task HandleProductEditorKey(KeyboardEventArgs args)
    {
        if (args.Key is "ArrowDown" or "ArrowUp")
        {
            await NavigateProductCatalogWithArrowsAsync(args.Key);
            return;
        }
        if (args.Key != "Enter")
            return;

        var byCode = FindProductForEditor(ProductCode, preferCode: true);
        var byName = FindProductForEditor(ProductName, preferCode: false);
        var match = byCode ?? byName;
        if (match is null)
        {
            if (ProductMode != "Nuevo")
                ProductNotice = "No se encontró un producto con ese código o descripción.";
            return;
        }

        if (ProductMode == "Nuevo")
            ProductMode = "Modificar";
        SelectProduct(match);
        ProductNotice = $"Producto cargado: {match.Name}";
        await ScrollProductCatalogSelectionAsync();
    }
    private PosProduct? FindProductForEditor(string query, bool preferCode)
    {
        var trimmed = (query ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
            return null;
        if (preferCode)
        {
            return Pos.Products.FirstOrDefault(p => p.Code.Equals(trimmed, StringComparison.OrdinalIgnoreCase))
                   ?? Pos.Products.FirstOrDefault(p => MatchesProductText(p, trimmed));
        }
        return Pos.Products.FirstOrDefault(p => p.Name.Equals(trimmed, StringComparison.OrdinalIgnoreCase))
               ?? Pos.Products.FirstOrDefault(p => MatchesProductText(p, trimmed));
    }
    private async Task HandleProductCatalogKey(KeyboardEventArgs args)
    {
        if (args.Key is "ArrowDown" or "ArrowUp")
        {
            await NavigateProductCatalogWithArrowsAsync(args.Key);
            return;
        }
        if (args.Key == "Enter")
        {
            var items = ProductPageItems.ToList();
            if (SelectedProduct is not null)
            {
                if (ProductMode == "Nuevo")
                    ProductMode = "Modificar";
                FillProductForm(SelectedProduct);
                return;
            }
            if (items.Count > 0)
                SelectProduct(items[0]);
        }
    }
    private async Task NavigateProductCatalogWithArrowsAsync(string key)
    {
        if (ActiveSection != "Productos" || ProductSearchModalOpen)
            return;

        var items = ProductPageItems.ToList();
        if (items.Count == 0)
            return;

        var currentIndex = SelectedProduct is null
            ? -1
            : items.FindIndex(p => p.Id == SelectedProduct.Id);

        if (key == "ArrowDown")
        {
            if (currentIndex >= items.Count - 1)
            {
                if (ProductPage >= ProductTotalPages)
                    return;
                ChangeProductPage(ProductPage + 1);
                items = ProductPageItems.ToList();
                if (items.Count == 0)
                    return;
                SelectProduct(items[0]);
            }
            else
            {
                SelectProduct(items[Math.Max(currentIndex + 1, 0)]);
            }
        }
        else if (key == "ArrowUp")
        {
            if (currentIndex <= 0)
            {
                if (ProductPage <= 1)
                {
                    if (currentIndex < 0 && items.Count > 0)
                        SelectProduct(items[0]);
                    return;
                }
                ChangeProductPage(ProductPage - 1);
                items = ProductPageItems.ToList();
                if (items.Count == 0)
                    return;
                SelectProduct(items[^1]);
            }
            else
            {
                SelectProduct(items[currentIndex - 1]);
            }
        }

        if (ProductMode == "Nuevo" && SelectedProduct is not null)
            ProductMode = "Modificar";

        await ScrollProductCatalogSelectionAsync();
    }
    private async Task ScrollProductCatalogSelectionAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        var items = ProductPageItems.ToList();
        var index = SelectedProduct is null ? -1 : items.FindIndex(p => p.Id == SelectedProduct.Id);
        if (index < 0)
            return;
        try
        {
            await JS.InvokeVoidAsync("grunflexKeyboard.scrollProductsCatalogRow", index);
        }
        catch (JSException)
        {
        }
    }

