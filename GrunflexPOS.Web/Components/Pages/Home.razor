    private static bool TryParseProductDecimal(string value, out decimal result)
    {
        var raw = value.Trim().Replace("$", string.Empty).Replace(" ", string.Empty);
        raw = raw.Contains(',')
            ? raw.Replace(".", string.Empty).Replace(',', '.')
            : raw.Count(character => character == '.') > 1
                ? raw.Replace(".", string.Empty)
                : raw;
        return decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out result) &&
               result >= 0;
    }

