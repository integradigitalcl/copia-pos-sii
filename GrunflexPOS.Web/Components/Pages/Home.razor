    private async Task HandlePromoProductKey(KeyboardEventArgs args)
    {
        if (args.Key is "ArrowDown" or "ArrowUp")
        {
            await NavigatePromoSuggestionsWithArrowsAsync(args.Key);
            return;
        }

        if (args.Key is not ("Enter" or "NumpadEnter"))
            return;

        var suggestions = PromoProductSuggestions.ToList();
        if (PromoSuggestionIndex >= 0 && PromoSuggestionIndex < suggestions.Count)
            AddPromoComponent(suggestions[PromoSuggestionIndex]);
        else
            AddPromoComponentFromQuery();
