                            <button class="@(ProductMode == "Nuevo" ? "active" : "")" @onclick='() => SetProductMode("Nuevo")'>Nuevo</button>
                            <button class="@(ProductMode == "Modificar" ? "active" : "")" @onclick='() => SetProductMode("Modificar")'>Modificar</button>
                            <button class="@(ProductMode == "Eliminar" ? "active" : "")" @onclick='() => SetProductMode("Eliminar")'>Eliminar</button>
                            <button type="button" class="product-search-close product-editor-overlay-close" aria-label="Cerrar" @onclick="CloseProductEditorOverlay">×</button>
                        </div>
                        <div class="products-editor-heading"><div><span class="eyebrow">@(ProductMode == "Nuevo" ? "ALTA" : ProductMode == "Modificar" ? "EDICIÓN" : "BAJA")</span><h2 id="product-editor-overlay-title">@ProductMode.ToUpperInvariant() PRODUCTO</h2></div><span class="products-editor-icon">▣</span></div>
                        @if (ProductMode != "Nuevo" && SelectedProduct is null)
                        {
                            <div class="products-selection-hint">Selecciona un producto de la tabla para continuar.</div>
                        }
                        <div class="products-form-grid">
                            <label>Código<input value="@ProductCode" @oninput="SetProductCode" placeholder="Código de barras" /></label>
                            <label>Descripción<input value="@ProductName" @oninput="SetProductName" placeholder="Nombre o descripción del producto" /></label>
                            <label>Costo<input value="@ProductCost" @oninput="SetProductCost" inputmode="decimal" placeholder="0" /></label>
                            <label>Venta<input value="@ProductPrice" @oninput="SetProductPrice" inputmode="decimal" placeholder="0" /></label>
                            <label>Mayoreo<input value="@ProductWholesale" @oninput="SetProductWholesale" inputmode="decimal" placeholder="Opcional" /></label>
                            <label>Stock<input value="@ProductStock" @oninput="SetProductStock" inputmode="decimal" placeholder="0" /></label>
                            <label>Mínimo<input value="@ProductMinStock" @oninput="SetProductMinStock" inputmode="decimal" placeholder="0" /></label>
                            <label>Máximo<input value="@ProductMaxStock" @oninput="SetProductMaxStock" inputmode="decimal" placeholder="0" /></label>
                            <label>Categoría<input value="@ProductCategory" @oninput="SetProductCategory" list="product-categories-overlay" placeholder="General" /></label>
                            <label>Departamento<input value="@ProductDepartment" @oninput="SetProductDepartment" list="product-departments-overlay" placeholder="General" /></label>
                            <label>Tipo de venta<input value="@ProductSaleType" @oninput="SetProductSaleType" placeholder="Unidad" /></label>
                            <label>Unidad<input value="@ProductUnit" @oninput="SetProductUnit" placeholder="un." /></label>
                        </div>
                        <datalist id="product-categories-overlay">@foreach (var category in ProductCategories) { <option value="@category"></option> }</datalist>
                        <datalist id="product-departments-overlay">@foreach (var department in ProductDepartments) { <option value="@department"></option> }</datalist>
                        @if (!string.IsNullOrWhiteSpace(ProductNotice)) { <div class="config-notice">@ProductNotice</div> }
                        <div class="products-editor-actions">
                            @if (ProductMode == "Eliminar")
                            {
                                <button class="danger-button" @onclick="DeactivateProductAsync" disabled="@(SelectedProduct is null)">Eliminar producto</button>
                            }
                            else
                            {
                                <button class="primary-button" @onclick="SaveProductAsync">@(ProductMode == "Nuevo" ? "Guardar producto" : "Actualizar producto")</button>
                                <button class="outline-button" @onclick="ClearProductForm">Limpiar</button>
                            }
                        </div>
                    </section>
                </div>
            }
        </main>
    </div>
        </ChildContent>
        <ErrorContent>
            <main class="loading-page">
                <div class="form-error">Ocurrió un error temporal al actualizar la pantalla.</div>
                <button class="primary-button" type="button" @onclick="RecoverFromPosError">Continuar</button>
            </main>
        </ErrorContent>
    </ErrorBoundary>
}

