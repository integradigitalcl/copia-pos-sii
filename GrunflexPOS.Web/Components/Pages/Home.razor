    private async Task UploadLogoAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null || !file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            ConfigurationNotice = "Selecciona un archivo PNG o JPG.";
            return;
        }
        await using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        ConfigLogoData = $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
        await ConfigStore.SetSettingAsync("logo_data", ConfigLogoData);
        await RefreshLogoDisplayAsync();
        ConfigurationNotice = "Logotipo guardado en la configuración local.";
    }

    private async Task RemoveLogoAsync()
    {
        ConfigLogoData = string.Empty;
        await ConfigStore.SetSettingAsync("logo_data", string.Empty);
        await RefreshLogoDisplayAsync();
        ConfigurationNotice = "Logotipo eliminado.";
    }

    private async Task RefreshLogoDisplayAsync()
    {
        LogoDisplayUrl = await PosLogo.GetDisplayUrlAsync();
    }

    private string GetBoletaPreviewStyle() =>
        $"font-family:{ConfigTicket.FontFamily};font-size:{ConfigTicket.FontSize}px;font-weight:{(ConfigTicket.BoldText ? "700" : "400")};max-width:{ConfigTicket.PaperWidthMm}mm";

    private void ClampBoletaSettings()
    {
        ConfigTicket.FontSize = Math.Clamp(ConfigTicket.FontSize, 6, 24);
        ConfigTicket.Columns = Math.Clamp(ConfigTicket.Columns, 20, 64);
        ConfigTicket.PaperWidthMm = ConfigTicket.PaperWidthMm == 58 ? 58 : 80;
        ConfigTicket.TopBlankLines = Math.Clamp(ConfigTicket.TopBlankLines, 0, 20);
        ConfigTicket.BottomBlankLines = Math.Clamp(ConfigTicket.BottomBlankLines, 0, 20);
    }

    private async Task<string?> GetConfiguredPrinterForBoletaAsync()
    {
        var printer = (await ConfigStore.GetSettingAsync("impresora_nombre", string.Empty)).Trim();
        if (!string.IsNullOrWhiteSpace(printer))
            return printer;
        ConfigurationNotice = "Configura una impresora en Impresora de ticket antes de probar.";
        return null;
    }

    private async Task TestBoletaPreviewPrintAsync()
    {
        var printer = await GetConfiguredPrinterForBoletaAsync();
        if (printer is null)
            return;
        ClampBoletaSettings();
        var ticket = TicketTemplate.BuildPreviewTicket(ConfigTicket);
        var result = await Bridge.TestPrinterAsync(printer, ticket, logoMonochrome: ConfigTicket.PrintLogoMonochrome);
        ConfigurationNotice = result.Message;
    }

    private async Task TestBoletaLastSalePrintAsync()
    {
        var printer = await GetConfiguredPrinterForBoletaAsync();
        if (printer is null)
            return;
        if (!Pos.TryGetLastTicket(out var ticketNumber, out var items, out var total))
        {
            ConfigurationNotice = "Aún no hay un ticket de venta para probar.";
            return;
        }
        ClampBoletaSettings();
        var ticket = TicketTemplate.BuildSaleTicket(ConfigTicket, ticketNumber, items, total);
        var result = await Bridge.TestPrinterAsync(printer, ticket, logoMonochrome: ConfigTicket.PrintLogoMonochrome);
        ConfigurationNotice = result.Message;
    }

    private async Task ConfigCardClicked(string action)
    {
        await LoadConfigurationModuleAsync(action);
    }
