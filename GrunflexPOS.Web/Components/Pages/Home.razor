            <div class="config-info-card"><strong>Estado de conexión</strong><p>@Pos.MulticajaStatus</p><p class="config-muted">La operación local continúa aunque la API central no esté disponible; las operaciones pendientes se sincronizan al reconectar.</p></div><button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar caja</button>
        }
        else if (ConfigurationModule == "BaseDatos")
        {
            <div class="config-info-card"><strong>Base de datos local SQLite</strong><p>Administra un respaldo de las preferencias y usuarios de esta instalación. Las ventas permanecen en el equipo y no se envían a terceros.</p><div class="config-actions"><button class="primary-button" @onclick="ExportConfigurationAsync">Preparar respaldo</button><button class="outline-button" @onclick="DownloadConfigurationAsync">Descargar JSON</button><button class="outline-button" @onclick="BackupDatabaseAsync">Respaldar base SQLite</button></div></div>
            @if (!string.IsNullOrWhiteSpace(ConfigDatabaseExport)) { <textarea class="config-export" readonly value="@ConfigDatabaseExport"></textarea> }
        }
        else if (ConfigurationModule == "Facturacion")
        {
            <div class="config-info-card"><strong>Facturación electrónica</strong><p>Al cobrar, el POS envía un JSON firmado por requestId al endpoint del proveedor. Para pruebas locales use el receptor mock incluido.</p></div>
            <div class="config-form-grid">
                <label class="config-check"><input type="checkbox" @bind="ConfigInvoiceEnabled" /><span><strong>Habilitar facturación</strong></span></label>
                <label>Tipo de documento<select @bind="ConfigInvoiceDocType"><option value="boleta">Boleta</option><option value="factura">Factura</option></select></label>
                <label class="config-wide">Endpoint POST<input @bind="ConfigInvoiceEndpoint" placeholder="http://127.0.0.1:7373/api/invoice/receive" /></label>
                <label class="config-wide">API key (Bearer, opcional)<input type="password" @bind="ConfigInvoiceApiKey" /></label>
                <label>RUT emisor<input @bind="ConfigInvoiceSellerRut" placeholder="76.XXX.XXX-X" /></label>
                <label>Razón social<input @bind="ConfigInvoiceSellerName" /></label>
                <label class="config-wide">Dirección emisor<input @bind="ConfigInvoiceSellerAddress" /></label>
                <label>Email emisor<input type="email" @bind="ConfigInvoiceSellerEmail" /></label>
                <label>IVA %<input @bind="ConfigInvoiceIva" inputmode="decimal" /></label>
                <label class="config-check"><input type="checkbox" @bind="ConfigInvoicePricesIncludeTax" /><span><strong>Precios incluyen IVA</strong></span></label>
            </div>
            <div class="config-info-card">
                <strong>Pruebas</strong>
                <p class="config-muted">Mock local: <code>http://127.0.0.1:7373/api/invoice/receive</code></p>
                <div class="config-actions">
                    <button class="outline-button" @onclick="TestInvoiceEndpointAsync">Probar conectividad</button>
                    <button class="outline-button" @onclick="EmitTestInvoiceAsync">Emitir documento de prueba</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(InvoiceProbeStatus)) { <p class="config-muted">@InvoiceProbeStatus</p> }
                @if (!string.IsNullOrWhiteSpace(Pos.InvoiceStatus)) { <p class="config-muted">Última emisión: @Pos.InvoiceStatus</p> }
            </div>
            @if (InvoiceHistory.Count > 0)
            {
                <div class="config-info-card">
                    <strong>Historial reciente</strong>
                    @foreach (var row in InvoiceHistory.Take(8))
                    {
                        <p class="config-muted">Ticket #@row.TicketNumber · @row.DocumentType · @row.Status · @row.Message</p>
                    }
                </div>
            }
            <button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar facturación</button>
        }
        else if (ConfigurationModule == "Folio")
        {
            <div class="config-form-grid"><label>Próximo folio<input @bind="ConfigFolio" inputmode="numeric" /></label></div>
            <button class="primary-button config-save-button" @onclick="SaveConfigurationAsync">Guardar folio</button>
        }
        else if (ConfigurationModule == "Logo")
        {
            <div class="logo-config-layout"><div class="logo-preview"><img src="@LogoDisplayUrl" alt="Vista previa del logotipo" /></div><div><label class="file-picker">Seleccionar PNG o JPG<InputFile accept="image/png,image/jpeg" OnChange="UploadLogoAsync" /></label><p class="config-muted">El logotipo se guarda localmente y se usará en el encabezado.</p><button class="outline-button" @onclick="RemoveLogoAsync">Quitar logotipo</button></div></div>
        }
        else if (ConfigurationModule == "Impresora")
        {
            <div class="config-form-grid">
                <label>Impresora instalada
                    <select @bind="ConfigPrinterName" @bind:after="OnPrinterSelectionChanged">
                        <option value="">Sin impresora (solo PDF)</option>
