    private async Task SaveQuickEditAsync()
    {
        var items = ProductPageItems.ToList();
        if (ProductSearchSelectedIndex < 0 || ProductSearchSelectedIndex >= items.Count) return;
        var product = items[ProductSearchSelectedIndex];
        if (!decimal.TryParse(QuickEditPrice.Trim().Replace(",", "."), NumberStyles.Any, CultureInfo.InvariantCulture, out var price) || price < 0)
        { QuickEditNotice = "Precio inválido."; return; }
        if (!decimal.TryParse(QuickEditStock.Trim().Replace(",", "."), NumberStyles.Any, CultureInfo.InvariantCulture, out var stock) || stock < 0)
        { QuickEditNotice = "Stock inválido."; return; }
        var name = QuickEditName.Trim();
        if (string.IsNullOrWhiteSpace(name))
        { QuickEditNotice = "El nombre no puede estar vacío."; return; }

        var previousStock = Pos.GetEffectiveStock(product);
        var result = await ConfigStore.UpdateProductAsync(product.Id, product.Code, name, product.Category,
            product.Cost, price, product.WholesalePrice, stock, product.MinStock, product.MaxStock,
            product.Unit, product.SaleType, product.Department, Pos.UserName);
        if (!result.Success) { QuickEditNotice = result.Message; return; }

        if (Pos.MulticajaEnabled && product.CentralProductId is int centralId and > 0 &&
            Pos.TryGetMulticajaContext(out var cajaId, out var sessionId, out var userId) &&
            previousStock != stock)
        {
            var sync = await Multicaja.SyncProductStockAsync(
                cajaId, sessionId, userId, centralId, previousStock, stock, name);
            if (!sync.Success && !sync.Queued)
                Pos.ShowError($"Stock local actualizado. Aviso multicaja: {sync.Message}");
        }

        if (Pos.MulticajaEnabled)
            await Multicaja.PushCatalogAsync();

        ProductQuickEditOpen = false;
        QuickEditNotice = string.Empty;
        // Evitar RefreshAsync: SyncCatalog reescribe stock desde central y anula el cambio.
        await Pos.ReloadProductsAfterMutationAsync();
    }

