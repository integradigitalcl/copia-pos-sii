    private void TryAutoSelectProductByCode(string query)
    {
        var trimmed = query.Trim();
        if (string.IsNullOrWhiteSpace(trimmed) || ProductMode == "Nuevo")
            return;
        var match = Pos.Products.FirstOrDefault(p => p.Code.Equals(trimmed, StringComparison.OrdinalIgnoreCase));
        if (match is null)
            return;
        SelectProduct(match);
    }
    private void TryAutoSelectProductByName(string query)
    {
        var trimmed = query.Trim();
        if (string.IsNullOrWhiteSpace(trimmed) || ProductMode == "Nuevo")
