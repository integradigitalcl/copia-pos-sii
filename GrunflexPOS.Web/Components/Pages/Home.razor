                    <section class="small-modal opening-cash-modal" role="dialog" aria-modal="true" aria-labelledby="closing-cash-title">
                        <button class="opening-cash-close" aria-label="Cerrar" @onclick="Pos.CancelClosingCash">×</button>
                        <span class="opening-cash-caption">Cierre de caja</span>
                        <h2 id="closing-cash-title">¿ Cuánto efectivo hay en caja ?</h2>
                        <p class="config-muted">Esperado: @Pos.FormatCurrency(Pos.CashBalance)</p>
                        <input class="opening-cash-input" inputmode="decimal" aria-label="Efectivo contado" value="@Pos.ClosingAmountText" @oninput="SetClosingAmount" autofocus @onkeydown="HandleClosingCashKey" />
                        <button class="opening-cash-button" @onclick="ConfirmClosingCashAsync">💵 Registrar cierre de caja</button>
                    </section>
                </div>
            }
            @if (CommonProductOpen)
            {
                <div class="checkout-modal-backdrop">
                    <section class="small-modal" role="dialog" aria-modal="true">
                        <h2>Producto común</h2>
                        <label class="field-label">Descripción</label>
                        <input class="text-input" @bind="CommonProductName" />
                        <label class="field-label">Precio</label>
                        <input class="text-input" inputmode="decimal" @bind="CommonProductPrice" @onkeydown="HandleCommonProductKey" />
                        <div class="small-modal-actions">
                            <button class="checkout-outline-button" @onclick="CloseCommonProduct">Cancelar</button>
                            <button class="primary-button" @onclick="SaveCommonProduct">Agregar</button>
                        </div>
                    </section>
                </div>
            }
            @if (ProductSearchModalOpen)
            {
                <div class="checkout-modal-backdrop product-search-backdrop" @onclick="CloseProductSearchModal">
                    <section class="product-search-modal" role="dialog" aria-modal="true" aria-labelledby="product-search-title" @onclick:stopPropagation="true">
                        <header class="product-search-modal-header">
                            <div>
                                <span class="eyebrow">CATÁLOGO</span>
                                <h2 id="product-search-title">Buscar productos</h2>
                                <p>Selecciona un producto para agregarlo a la venta.</p>
                            </div>
                            <div class="product-search-header-actions">
                                <button type="button" class="primary-button product-search-add-btn" @onclick="OpenProductEditorOverlay" disabled="@(!Pos.CanAccessProducts)">＋ Agregar productos</button>
                                <button type="button" class="product-search-close" aria-label="Cerrar" @onclick="CloseProductSearchModal">×</button>
                            </div>
                        </header>
                        <div class="products-catalog product-search-catalog">
                            <div class="products-catalog-toolbar">
                                <div class="products-search"><span>⌕</span><input id="product-search-modal-input" value="@ProductSearchText" @oninput="HandleProductSearch" @onkeydown="HandleProductSearchModalKey" placeholder="Buscar por código, nombre o ID" /></div>
                                <button class="outline-button" @onclick="() => ProductFiltersOpen = !ProductFiltersOpen">⚙ Filtros</button>
                            </div>
                            @if (ProductFiltersOpen)
                            {
                                <div class="products-filters">
                                    <label>Departamento<select value="@ProductDepartmentFilter" @onchange="SetProductDepartmentFilter"><option>Todos</option>@foreach (var department in ProductDepartments) { <option value="@department">@department</option> }</select></label>
                                    <label>Stock<select value="@ProductStockFilter" @onchange="SetProductStockFilter"><option value="Todos">Todos</option><option value="Con stock">Con stock</option><option value="Sin stock">Sin stock</option><option value="Bajo mínimo">Bajo mínimo</option></select></label>
                                    <button class="outline-button" @onclick="ClearProductFilters">Limpiar filtros</button>
                                </div>
                            }
                            <div class="products-catalog-summary"><div><span>Productos activos</span><strong>@Pos.Dashboard.ActiveProducts</strong></div><div><span>Unidades en stock</span><strong>@Pos.Dashboard.UnitsInStock.ToString("0.##")</strong></div><div><span>Mostrando</span><strong>@ProductFiltered.Count()</strong></div></div>
                            <div class="table-wrap products-table-wrap"><table class="products-table"><thead><tr><th>ID</th><th>Código</th><th>Nombre</th><th>Costo</th><th>Precio</th><th>Mayoreo</th><th>Stock</th><th>Departamento</th></tr></thead><tbody>
                                @{ var searchItems = ProductPageItems.ToList(); }
                                @for (var i = 0; i < searchItems.Count; i++)
                                {
                                    var product = searchItems[i];
                                    var idx = i;
                                    <tr data-search-index="@idx" class="@(idx == ProductSearchSelectedIndex ? "selected" : "") @(product.IsFavorite ? "favorite-row" : "")" @onclick="async () => { ProductSearchSelectedIndex = idx; await HandleProductSearchRowClickAsync(product); }"><td class="muted">#@product.Id</td><td>@product.Code</td><td><strong>@(product.IsFavorite ? "★ " : "")@product.Name</strong><small>@product.Department</small></td><td>@Pos.FormatCurrency(product.Cost)</td><td>@Pos.FormatCurrency(product.Price)</td><td>@Pos.FormatCurrency(product.WholesalePrice)</td><td><span class="stock-value @(product.Stock <= 0 ? "empty" : IsLowStock(product) ? "low" : "")">@product.Stock @product.Unit</span></td><td>@product.Department</td></tr>
                                }
                            </tbody></table></div>
                            @if (ProductSearchSelectedIndex >= 0 && ProductSearchSelectedIndex < searchItems.Count && !ProductEditorOverlayOpen)
                            {
                                var sel = searchItems[ProductSearchSelectedIndex];
                                <div class="product-search-actions">
                                    <button class="outline-button" disabled="@(!Pos.CanAccessProducts)" @onclick="() => OpenQuickEdit(sel)">✎ Modificar Producto</button>
                                    <button class="outline-button" @onclick="() => ToggleSearchFavoriteAsync(sel)">@(sel.IsFavorite ? "★ Quitar Favorito" : "☆ Marcar como Favorito")</button>
                                    <button class="danger-button" disabled="@(!Pos.CanAccessProducts)" @onclick="() => DeleteSearchProductAsync(sel)">🗑 Eliminar Producto</button>
                                </div>
                            }
                            @if (ProductQuickEditOpen)
                            {
                                <div class="product-quick-edit">
                                    <span class="eyebrow">MODIFICAR PRODUCTO</span>
