                                {
                                    <tr class="@(SelectedProduct?.Id == product.Id ? "selected" : "")" @onclick="() => HandleProductSearchRowClickAsync(product)"><td class="muted">#@product.Id</td><td>@product.Code</td><td><strong>@product.Name</strong><small>@product.Category</small></td><td>@Pos.FormatCurrency(product.Cost)</td><td>@Pos.FormatCurrency(product.Price)</td><td>@Pos.FormatCurrency(product.WholesalePrice)</td><td><span class="stock-value @(product.Stock <= 0 ? "empty" : IsLowStock(product) ? "low" : "")">@product.Stock @product.Unit</span></td><td>@product.Department</td></tr>
                                }
