                                        <label>Nombre<input value="@QuickEditName" @oninput="e => QuickEditName = e.Value?.ToString() ?? string.Empty" /></label>
                                        <label>Precio<input value="@QuickEditPrice" @oninput="e => QuickEditPrice = e.Value?.ToString() ?? string.Empty" inputmode="decimal" /></label>
                                        <label>Stock<input value="@QuickEditStock" @oninput="e => QuickEditStock = e.Value?.ToString() ?? string.Empty" inputmode="decimal" @onkeydown="HandleQuickEditKey" /></label>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(QuickEditNotice)) { <div class="config-notice">@QuickEditNotice</div> }
                                    <div class="product-quick-edit-actions">
                                        <button class="primary-button" @onclick="SaveQuickEditAsync">Guardar cambios</button>
                                        <button class="outline-button" @onclick="() => { ProductQuickEditOpen = false; QuickEditNotice = string.Empty; }">Cancelar</button>
                                    </div>
                                </div>
                            }
                            <div class="products-pagination"><span>Página @ProductPage de @ProductTotalPages · @ProductFiltered.Count() productos</span><span><button @onclick="() => ChangeProductPage(ProductPage - 1)" disabled="@(ProductPage <= 1)">‹</button><button @onclick="() => ChangeProductPage(ProductPage + 1)" disabled="@(ProductPage >= ProductTotalPages)">›</button><select value="@ProductPageSize" @onchange="ChangeProductPageSize"><option value="10">10 por página</option><option value="20">20 por página</option><option value="50">50 por página</option><option value="100">100 por página</option></select></span></div>
                            <div class="product-search-keyboard-hints">
                                <span>✔ ENTER · Aceptar</span>
                                <span>↑↓ Navegar</span>
                                <span>ESC · Cancelar</span>
                            </div>
                        </div>
                    </section>
