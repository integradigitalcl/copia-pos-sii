    private async Task ReprintReportSaleAsync()
    {
        if (SelectedReportSaleDetail is null)
            return;
        var items = SelectedReportSaleDetail.Lines.Select(line =>
            new CartItem(new PosProduct(line.ProductId, line.Code, line.ProductName, string.Empty,
                line.UnitPrice, line.Quantity, "un.", "#2563EB"), line.Quantity)).ToArray();
        var printer = await Bridge.GetConfiguredPrinterNameAsync();
        if (string.IsNullOrWhiteSpace(printer))
        {
            BoletaPdf.Generate(SelectedReportSaleDetail.TicketNumber, items,
                SelectedReportSaleDetail.Total, SelectedReportSaleDetail.Customer);
            ReportNotice = "Sin impresora configurada. Se generó una copia PDF.";
            return;
        }

        var result = await Bridge.PrintTicketAsync(SelectedReportSaleDetail.TicketNumber, items,
            SelectedReportSaleDetail.Total);
        if (!result.Success)
        {
            BoletaPdf.Generate(SelectedReportSaleDetail.TicketNumber, items,
                SelectedReportSaleDetail.Total, SelectedReportSaleDetail.Customer);
            ReportNotice = $"{result.Message}. Se generó una copia PDF.";
            return;
        }
        ReportNotice = result.Message;
    }

