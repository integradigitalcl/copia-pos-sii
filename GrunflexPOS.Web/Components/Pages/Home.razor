                        <input class="checkout-money-input" @bind="DiscountText" @bind:event="oninput" autofocus />
                        <div class="small-modal-actions"><button class="checkout-outline-button" @onclick="CloseDiscount">Cancelar</button><button class="primary-button" @onclick="SaveDiscount">Aplicar</button></div>
                    </section>
                </div>
            }
            @if (Pos.IsOpeningCashDialogOpen)
            {
                <div class="checkout-modal-backdrop opening-cash-backdrop">
                    <section class="small-modal opening-cash-modal" role="dialog" aria-modal="true" aria-labelledby="opening-cash-title">
                        <button class="opening-cash-close" aria-label="Cerrar" @onclick="Pos.CancelOpeningCash">×</button>
                        <span class="opening-cash-caption">Dinero en caja</span>
                        <h2 id="opening-cash-title">¿ Efectivo Inicial en Caja ?</h2>
                        <input class="opening-cash-input" inputmode="decimal" aria-label="Efectivo inicial en caja" value="@Pos.OpeningAmountText" @oninput="SetOpeningAmount" autofocus />
                        <button class="opening-cash-button" @onclick="RegisterOpeningCashAsync">💵 Registrar dinero inicial en caja</button>
                    </section>
                </div>
            }
            @if (Pos.IsClosingCashDialogOpen)
            {
                <div class="checkout-modal-backdrop opening-cash-backdrop">
                    <section class="small-modal opening-cash-modal" role="dialog" aria-modal="true" aria-labelledby="closing-cash-title">
                        <button class="opening-cash-close" aria-label="Cerrar" @onclick="Pos.CancelClosingCash">×</button>
                        <span class="opening-cash-caption">Cierre de caja</span>
