    private async Task ExportSalesCsvAsync()
    {
        ReportExportMenuOpen = false;
        if (SalesReport is null)
            await LoadSalesReportAsync();
        if (SalesReport is null)
            return;
        var lines = new List<string> { "Folio;Fecha;Cajero;Cliente;Pago;Total;Descuento;Artículos;Estado" };
        lines.AddRange(SalesReport.Rows.Select(s =>
            string.Join(";", Csv(s.TicketNumber.ToString(CultureInfo.InvariantCulture)),
                Csv(s.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm", Spanish)),
                Csv(s.UserName), Csv(s.Customer), Csv(s.PaymentMethod),
                s.Total.ToString("0.00", Spanish), s.Discount.ToString("0.00", Spanish),
                s.ItemCount.ToString(CultureInfo.InvariantCulture),
                Csv(s.Cancelled ? "Anulada" : s.PersonalConsumption ? "Consumo" : s.Edited ? "Editada" : "Activa"))));
        await DownloadTextAsync($"ventas_{DateTime.Now:yyyyMMdd_HHmm}.csv",
            string.Join(Environment.NewLine, lines), "text/csv;charset=utf-8");
    }
