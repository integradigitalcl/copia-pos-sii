                                            <div><span>Descuento anterior</span><strong>@Pos.FormatCurrency(SelectedReportSaleDetail.Discount)</strong></div>
                                            <div><span>Diferencia</span><strong class="@(refundAmount > 0 ? "negative" : "")">@Pos.FormatCurrency(refundAmount)</strong></div>
                                            <div class="report-sale-refund"><span>A devolver al cliente</span><strong>@Pos.FormatCurrency(refundAmount)</strong></div>
                                            @if (GetReportEditRemovedUnits() > 0)
