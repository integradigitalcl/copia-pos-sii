@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using System.Text
@using ClosedXML.Excel
@using GrunflexPOS.Web.Services
@using GrunflexPOS.Web.Services.Licensing
@using Microsoft.AspNetCore.Components.Forms
@inject PosSessionState Pos
@inject LocalPosStore ConfigStore
@inject LocalReportsService Reports
@inject ReportsPdfService ReportsPdfService
@inject HardwareBridgeClient Bridge
@inject BoletaPdfService BoletaPdf
@inject TicketTemplateService TicketTemplate
@inject PosLogoService PosLogo
@inject MulticajaClient Multicaja
@inject WebLicenseState License
@inject LicensingCloudClient LicensingCloud
@inject CloudBackupService CloudBackup
@inject PosEmailService Email
@inject InvoiceEmissionService Invoice
@inject IJSRuntime JS

<PageTitle>Grunflex POS</PageTitle>

@if (Pos.IsLoading)
{
    <main class="loading-page"><div class="brand-mark brand-mark-large">G</div><span>Cargando datos locales…</span></main>
}
else if (!string.IsNullOrWhiteSpace(Pos.StartupError))
{
    <main class="login-page">
        <section class="login-card">
            <img class="login-logo" src="assets/logo_login_transparent.png" alt="Grunflex POS" />
            <span class="eyebrow">ERROR DE INICIO</span>
            <h1>No se pudo abrir el POS</h1>
            <p class="login-subtitle">@Pos.StartupError</p>
            <button class="primary-button login-button" @onclick="RetryStartupAsync">Reintentar</button>
            <small class="login-hint">Si instaló como caja principal, verifique que el servicio GrunflexPOSAPI esté en ejecución (puerto 7279).</small>
        </section>
    </main>
}
else if (Pos.LicenseActivationRequired)
{
    <main class="login-page">
        <section class="login-card">
            <img class="login-logo" src="assets/logo_login_transparent.png" alt="Grunflex POS" />
            <span class="eyebrow">ACTIVACIÓN DE LICENCIA</span>
            <h1>Active su licencia GrünFlex</h1>
            <p class="login-subtitle">@Pos.LicenseBlockReason</p>
            <label class="field-label" for="activation-id">Activation ID</label>
            <input id="activation-id" class="text-input" @bind="LicenseActivationId" placeholder="GF-XXXX-XXXX" />
            <button class="primary-button login-button" @onclick="ActivateLicenseOnlineAsync">Obtener licencia desde servidor</button>
            <label class="field-label" for="license-token">Token GFv2</label>
            <textarea id="license-token" class="config-export" rows="4" @bind="LicenseTokenText" placeholder="GFv2...."></textarea>
            <button class="outline-button login-button" @onclick="ActivateLicenseTokenAsync">Activar token pegado</button>
            <button type="button" class="link-button" @onclick="SyncLicenseAsync">Sincronizar licencia con servidor</button>
            @if (!string.IsNullOrWhiteSpace(LicenseNotice)) { <div class="form-error">@LicenseNotice</div> }
            <small class="login-hint">La licencia se guarda localmente y se comparte con el POS instalable en este equipo.</small>
        </section>
    </main>
}
else if (!Pos.IsAuthenticated)
{
    <main class="login-page">
        <section class="login-card">
            <img class="login-logo" src="assets/logo_login_transparent.png" alt="Grunflex POS" />
            <span class="eyebrow">PUNTO DE VENTA LOCAL</span>
            <h1>Bienvenido a Grunflex POS</h1>
            <p class="login-subtitle">Ingresa para comenzar tu jornada de ventas.</p>
            <label class="field-label" for="user">Usuario</label>
            <input id="user" class="text-input" @bind="UserName" @bind:event="oninput" autocomplete="username" placeholder="Usuario" />
            <label class="field-label" for="password">Contraseña</label>
            <input id="password" class="text-input" type="password" @bind="Password" @bind:event="oninput" autocomplete="current-password" placeholder="••••••••" @onkeydown="HandleLoginKey" />
            @if (LoginError) { <div class="form-error">@(string.IsNullOrWhiteSpace(LoginErrorMessage) ? "Credenciales incorrectas. Verifique usuario y contraseña." : LoginErrorMessage)</div> }
            <button class="primary-button login-button" @onclick="LoginAsync">Ingresar al POS <span>→</span></button>
            <button type="button" class="link-button" @onclick="() => ChangePasswordOpen = true">Cambiar contraseña</button>
            <small class="login-hint">Sesión local protegida · SQLite en este equipo</small>
        </section>
    </main>
    @if (ChangePasswordOpen)
    {
        <div class="checkout-modal-backdrop">
            <section class="small-modal" role="dialog" aria-modal="true">
                <h2>Cambiar contraseña</h2>
                <label class="field-label">Usuario</label>
                <input class="text-input" @bind="UserName" autocomplete="username" />
                <label class="field-label">Contraseña actual</label>
                <input class="text-input" type="password" @bind="CurrentPasswordText" autocomplete="current-password" />
                <label class="field-label">Nueva contraseña</label>
                <input class="text-input" type="password" @bind="NewPasswordText" autocomplete="new-password" />
                @if (!string.IsNullOrWhiteSpace(ChangePasswordNotice)) { <div class="form-error">@ChangePasswordNotice</div> }
                <div class="small-modal-actions">
                    <button class="checkout-outline-button" @onclick="CloseChangePassword">Cancelar</button>
                    <button class="primary-button" @onclick="ChangePasswordAsync">Guardar</button>
                </div>
            </section>
        </div>
    }
}
else
{
    <ErrorBoundary @ref="_posErrorBoundary">
        <ChildContent>
    @if (Pos.RequiresPasswordChange)
    {
        <div class="checkout-modal-backdrop">
            <section class="small-modal" role="dialog" aria-modal="true">
                <h2>Cambie su contraseña</h2>
                <p>Por seguridad debe definir una nueva contraseña antes de operar el POS.</p>
                <label class="field-label">Contraseña actual</label>
                <input class="text-input" type="password" @bind="CurrentPasswordText" autocomplete="current-password" />
                <label class="field-label">Nueva contraseña</label>
                <input class="text-input" type="password" @bind="NewPasswordText" autocomplete="new-password" />
                @if (!string.IsNullOrWhiteSpace(ChangePasswordNotice)) { <div class="form-error">@ChangePasswordNotice</div> }
                <div class="small-modal-actions">
                    <button class="checkout-outline-button" @onclick="Pos.Logout">Cerrar sesión</button>
                    <button class="primary-button" @onclick="ForceChangePasswordAsync">Guardar y continuar</button>
                </div>
            </section>
        </div>
    }
    <div class="pos-shell @(Pos.RequiresPasswordChange ? "is-blocked" : string.Empty)">
        <aside class="sidebar">
            <div class="sidebar-brand"><div class="sidebar-logo-frame"><img src="@LogoSource" alt="Grunflex POS" /></div><span>POINT OF SALES</span></div>
            <div class="connection-pill"><span class="status-dot"></span> Sistema operativo</div>
            <nav class="main-nav" aria-label="Navegación principal">
                <span class="nav-label">OPERACIÓN</span>
                <button class='nav-item nav-card sales @(ActiveSection == "Ventas" ? "active" : "")' @onclick='() => SelectSection("Ventas")' disabled="@(!Pos.CanAccessVentas)"><span class="nav-card-icon">▣</span><span class="nav-card-copy"><small>F1</small><strong>Ventas</strong><em>Gestión de ventas y pedidos</em></span><b>›</b></button>
                <button class='nav-item nav-card products @(ActiveSection == "Productos" ? "active" : "")' @onclick='() => SelectSection("Productos")' disabled="@(!Pos.CanAccessProducts)"><span class="nav-card-icon">▤</span><span class="nav-card-copy"><small>F3</small><strong>Productos</strong><em>Catálogo y gestión de productos</em></span><b>›</b></button>
                <button class='nav-item nav-card inventory @(ActiveSection == "Inventario" ? "active" : "")' @onclick='() => SelectSection("Inventario")' disabled="@(!Pos.CanAccessInventory)"><span class="nav-card-icon">▥</span><span class="nav-card-copy"><small>F4</small><strong>Inventario</strong><em>Control de stock y almacenes</em></span><b>›</b></button>
                <span class="nav-label nav-label-spaced">GESTIÓN</span>
                <button class='nav-item nav-card reports @(ActiveSection == "Reportes" ? "active" : "")' @onclick='() => SelectSection("Reportes")' disabled="@(!Pos.CanAccessReports)"><span class="nav-card-icon">◫</span><span class="nav-card-copy"><strong>Reportes</strong><em>Análisis y reportes</em></span><b>›</b></button>
                <button class='nav-item nav-card closing @(ActiveSection == "Corte" ? "active" : "")' @onclick='() => SelectSection("Corte")'><span class="nav-card-icon">◴</span><span class="nav-card-copy"><strong>Corte</strong><em>Órdenes de corte y producción</em></span><b>›</b></button>
                <button class="premium-nav support-nav" @onclick="OpenSupport" disabled="@(!Pos.LicenseOnlineSupport)"><span class="premium-icon">?</span><span><strong>Soporte en línea <mark>♛ PREMIUM</mark></strong><em>@(Pos.LicenseOnlineSupport ? "WhatsApp integrado" : "Requiere licencia")</em></span><b>›</b></button>
            </nav>
            <div class="sidebar-spacer"></div>
            <button class="user-card" @onclick="Pos.Logout">
                <span class="avatar">@Initial</span><span class="user-copy"><strong>@Pos.UserName</strong><small>@Pos.Role · Cerrar sesión</small></span><span class="logout-icon">↪</span>
            </button>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div class="header-register"><span class="shopping-icon">🛍</span><div><strong>@Pos.CashRegister</strong><span><i class="status-dot"></i> @Pos.CashStatus</span></div></div>
                <div class="header-actions">
                    <div class="user-pill"><span class="avatar avatar-small">@Initial</span><span><strong>@DateTime.Now.ToString("HH:mm")</strong><small>@Pos.UserName</small></span></div>
                    <strong class="balance">@Pos.FormatCurrency(Pos.CashBalance)</strong>
                    <span class="network-pill @Pos.MulticajaConnectionCss" title="@Pos.MulticajaStatus">
                        <i class="status-dot @Pos.MulticajaConnectionCss"></i>
                        @Pos.MulticajaConnectionLabel
                    </span>
                    <button class="header-button settings-gear" title="Configuración" aria-label="Configuración" @onclick='() => SelectSection("Configuración")' disabled="@(!Pos.CanManageConfiguration)">⚙</button>
                    <button class="header-button" @onclick="Refresh">↻ Actualizar</button>
                    <button class="close-register" @onclick="ToggleCashRegister">@(Pos.CashStatus == "Abierta" ? "🚪 Cerrar caja" : "✓ Abrir caja")</button>
                </div>
            </header>
            <div class="page-body">
                @if (Pos.LastSaleMessage is not null) { <div class="success-banner">✓ @Pos.LastSaleMessage <button class="receipt-link" @onclick="OpenReceipts">Ver boletas</button><button @onclick="Pos.ClearLastSaleMessage">×</button></div> }
                @if (Pos.ErrorMessage is not null) { <div class="error-banner">⚠ @Pos.ErrorMessage <button @onclick="Pos.ClearError">×</button></div> }

                <div class="pos-section" data-section="Ventas" hidden="@(ActiveSection != "Ventas")">
                    <div class="sales-layout">
                    <section class="ventas-center">
                        <div class="ventas-toolbar">
                            <button class="ventas-toolbar-button" @onclick="OpenProductSearchModalAsync">🔍&nbsp; F10 Buscar</button>
                            <button class="ventas-toolbar-button @(Pos.WholesaleMode ? "accent" : "")" @onclick="ToggleWholesale">F11 Mayoreo</button>
                            <button class="ventas-toolbar-button" @onclick="ShowEntries">F7 Entradas</button>
                            <button class="ventas-toolbar-button" @onclick="ShowExits">F8 Salidas</button>
                            <button class="ventas-toolbar-button" @onclick="Pos.ClearCart">DEL Borrar</button>
                            <button class="ventas-toolbar-button accent" @onclick="AddScannedProduct">➕&nbsp; Enter Agregar</button>
                            <button class="ventas-toolbar-button" @onclick="EditPurchase">✎&nbsp; Editar compra</button>
                            <button class="ventas-toolbar-button" @onclick="OpenCommonProduct">＋ Común</button>
                            @if (Pos.ScaleEnabled)
                            {
                                <button class="ventas-toolbar-button" @onclick="ReadScaleWeightAsync">⚖ Leer báscula</button>
                            }
                            <button class="ventas-toolbar-button" @onclick="ApplyDiscount" disabled="@(!Pos.CanApplyDiscount)">🏷&nbsp; Aplicar descuento</button>
                        </div>
                        <div class="ventas-search-block">
                            <label for="venta-code-input">Código o nombre (escanear / Enter)</label>
                            <div class="ventas-search-box">
                                <img src="assets/escaner.png" alt="" />
                                <input id="venta-code-input" value="@SearchText" @oninput="HandleSearchInput" @onkeydown="HandleSaleKey" autocomplete="off" />
                                <span class="search-dropdown-arrow" aria-hidden="true">⌄</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(SearchText) && FilteredProducts.Any())
                            {
                                <div class="sales-suggestions" role="listbox">
                                    @{ var suggestionIndex = 0; }
                                    @foreach (var product in CurrentSuggestions)
                                    {
                                        <button type="button" role="option" aria-selected="@(SuggestionIndex == suggestionIndex)" class="@(SuggestionIndex == suggestionIndex ? "selected" : "")" @onclick="() => SelectSuggestedProduct(product)">
                                            <span>@product.Code - @product.Name</span>
                                        </button>
                                        suggestionIndex++;
                                    }
                                </div>
                            }
                        </div>
                        <div class="category-chips">
                            @foreach (var category in Categories)
                            {
                                <button type="button" class="category-chip @(SelectedCategory == category ? "active" : "")" @onclick="() => SelectCategory(category)">@category</button>
                            }
                        </div>
                        <div class="ventas-grid">
                            <table class="ventas-table">
                                <thead><tr><th>Código</th><th>Producto</th><th>Cant.</th><th>Desc. %</th><th>P. unit.</th><th>Importe</th><th>Stock</th></tr></thead>
                                <tbody>
                                @foreach (var line in Pos.Cart)
                                {
                                    <tr class="@(Pos.SelectedLine == line ? "selected" : "")" @onclick="() => Pos.SelectLine(line)"><td>@line.Product.Code</td><td><strong>@line.Product.Name</strong></td><td><div class="table-quantity"><button @onclick:stopPropagation="true" @onclick="() => Pos.ChangeQuantity(line, -1)">−</button><span>@line.Quantity</span><button @onclick:stopPropagation="true" @onclick="() => Pos.ChangeQuantity(line, 1)">+</button></div></td><td>@line.DiscountPercentage</td><td>@Pos.FormatCurrency(line.UnitPrice)</td><td>@Pos.FormatCurrency(line.Subtotal)</td><td>@Pos.GetEffectiveStock(line.Product).ToString("0.##")</td></tr>
                                }
                                </tbody>
                            </table>
                            @if (Pos.Cart.Count == 0)
                            {
                                <div class="ventas-empty">
                                    <div class="empty-cart-illustration"><div class="empty-cart-ring"></div><div class="empty-cart-circle">🛒</div></div>
                                    <strong>Aún no hay productos en la venta</strong>
                                    <span>Escanee o agregue productos para comenzar</span>
                                </div>
                            }
                        </div>
                        <div class="ventas-shortcuts"><kbd>ENTER</kbd><i>·</i><kbd>F10</kbd><i>·</i><kbd>DEL</kbd><span>Usa el lector o escribe un código para agregar productos</span></div>
                    </section>
                        <section class="checkout-panel">
                            <div class="checkout-summary-card">
                                <h2>Resumen de la compra</h2>
                                <div class="checkout-row"><span>Artículos</span><strong>@Pos.ItemCount</strong></div>
                                <div class="checkout-row"><span>Subtotal</span><strong>@Pos.FormatCurrency(Pos.Subtotal)</strong></div>
                                <div class="checkout-row"><span>Descuento</span><strong>@Pos.FormatCurrency(Pos.DiscountAmount)</strong></div>
                                <div class="checkout-separator"></div>
                                <span class="total-label">Total a pagar</span><strong class="checkout-total">@Pos.FormatCurrency(Pos.Total)</strong>
                            </div>
                            <div class="checkout-detail-card">
                                <h2>Detalle de productos</h2>
                                <div class="checkout-detail-scroll">
                                    @if (Pos.Cart.Count == 0)
                                    {
                                        <div class="detail-empty">
                                            <img class="detail-watermark" src="assets/ventas_grid_watermark_logo.png" alt="" />
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var line in Pos.Cart)
                                        {
                                            <div class="checkout-line"><div class="line-info"><strong>@line.Product.Name</strong><small>@line.Quantity × @Pos.FormatCurrency(line.UnitPrice) · Desc. @line.DiscountPercentage%</small></div><strong class="line-total">@Pos.FormatCurrency(line.Subtotal)</strong><button class="remove-line" @onclick="() => Pos.RemoveLine(line)">×</button></div>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="checkout-actions">
                            <button class="charge-button" disabled="@(Pos.Cart.Count == 0)" @onclick="Pos.OpenCheckout">🧾&nbsp; F12 — COBRAR</button>
                                <button class="checkout-outline-button" @onclick="ReprintLastTicket">Reimprimir último ticket</button>
                                <button class="checkout-outline-button" @onclick="ShowDaySales">Ventas del día y devoluciones</button>
                            </div>
                        </section>
                    </div>
                </div>
                <div class="pos-section" data-section="Productos" hidden="@(ActiveSection != "Productos")">
                    @ModuleHeading("CATÁLOGO", "Productos", "Crea, modifica y administra el catálogo activo del punto de venta.")
                    <div class="products-workspace">
                        <section class="products-editor">
                            <div class="products-tabs">
                                <button class="@(ProductMode == "Nuevo" ? "active" : "")" @onclick='() => SetProductMode("Nuevo")'>Nuevo</button>
                                <button class="@(ProductMode == "Modificar" ? "active" : "")" @onclick='() => SetProductMode("Modificar")'>Modificar</button>
                                <button class="@(ProductMode == "Eliminar" ? "active" : "")" @onclick='() => SetProductMode("Eliminar")'>Eliminar</button>
                            </div>
                            <div class="products-editor-heading"><div><span class="eyebrow">@(ProductMode == "Nuevo" ? "ALTA" : ProductMode == "Modificar" ? "EDICIÓN" : "BAJA")</span><h2>@ProductMode.ToUpperInvariant() PRODUCTO</h2></div><span class="products-editor-icon">▣</span></div>
                            @if (ProductMode != "Nuevo" && SelectedProduct is null)
                            {
                                <div class="products-selection-hint">Selecciona un producto de la tabla para continuar.</div>
                            }
                            <div class="products-form-grid">
                                <label>Código<input value="@ProductCode" @oninput="SetProductCode" placeholder="Código de barras" /></label>
                                <label>Descripción<input value="@ProductName" @oninput="SetProductName" placeholder="Nombre o descripción del producto" /></label>
                                <label>Costo<input value="@ProductCost" @oninput="SetProductCost" inputmode="decimal" placeholder="0" /></label>
                                <label>Venta<input value="@ProductPrice" @oninput="SetProductPrice" inputmode="decimal" placeholder="0" /></label>
                                <label>Mayoreo<input value="@ProductWholesale" @oninput="SetProductWholesale" inputmode="decimal" placeholder="Opcional" /></label>
                                <label>Stock<input value="@ProductStock" @oninput="SetProductStock" inputmode="decimal" placeholder="0" /></label>
                                <label>Mínimo<input value="@ProductMinStock" @oninput="SetProductMinStock" inputmode="decimal" placeholder="0" /></label>
                                <label>Máximo<input value="@ProductMaxStock" @oninput="SetProductMaxStock" inputmode="decimal" placeholder="0" /></label>
                                <label>Categoría<input value="@ProductCategory" @oninput="SetProductCategory" list="product-categories" placeholder="General" /></label>
                                <label>Departamento<input value="@ProductDepartment" @oninput="SetProductDepartment" list="product-departments" placeholder="General" /></label>
                                <label>Tipo de venta<input value="@ProductSaleType" @oninput="SetProductSaleType" placeholder="Unidad" /></label>
                                <label>Unidad<input value="@ProductUnit" @oninput="SetProductUnit" placeholder="un." /></label>
                            </div>
                            <datalist id="product-categories">@foreach (var category in ProductCategories) { <option value="@category"></option> }</datalist>
                            <datalist id="product-departments">@foreach (var department in ProductDepartments) { <option value="@department"></option> }</datalist>
                            @if (!string.IsNullOrWhiteSpace(ProductNotice)) { <div class="config-notice">@ProductNotice</div> }
                            <div class="products-editor-actions">
                                @if (ProductMode == "Eliminar")
                                {
                                    <button class="danger-button" @onclick="DeactivateProductAsync" disabled="@(SelectedProduct is null)">Eliminar producto</button>
                                }
                                else
                                {
                                    <button class="primary-button" @onclick="SaveProductAsync">@(ProductMode == "Nuevo" ? "Guardar producto" : "Actualizar producto")</button>
                                    <button class="outline-button" @onclick="ClearProductForm">Limpiar</button>
                                }
                            </div>
                        </section>
                        <section class="products-catalog">
                            <div class="products-catalog-toolbar">
                                <div class="products-search"><span>⌕</span><input value="@ProductSearchText" @oninput="HandleProductSearch" placeholder="Buscar por código, nombre o ID" /></div>
                                <button class="outline-button" @onclick="() => ProductFiltersOpen = !ProductFiltersOpen">⚙ Filtros</button>
                            </div>
                            @if (ProductFiltersOpen)
                            {
                                <div class="products-filters">
                                    <label>Categoría<select value="@ProductCategoryFilter" @onchange="SetProductCategoryFilter"><option>Todos</option>@foreach (var category in ProductCategories) { <option value="@category">@category</option> }</select></label>
                                    <label>Departamento<select value="@ProductDepartmentFilter" @onchange="SetProductDepartmentFilter"><option>Todos</option>@foreach (var department in ProductDepartments) { <option value="@department">@department</option> }</select></label>
                                    <label>Stock<select value="@ProductStockFilter" @onchange="SetProductStockFilter"><option value="Todos">Todos</option><option value="Con stock">Con stock</option><option value="Sin stock">Sin stock</option><option value="Bajo mínimo">Bajo mínimo</option></select></label>
                                    <button class="outline-button" @onclick="ClearProductFilters">Limpiar filtros</button>
                                </div>
                            }
                            <div class="products-catalog-summary"><div><span>Productos activos</span><strong>@Pos.Dashboard.ActiveProducts</strong></div><div><span>Unidades en stock</span><strong>@Pos.Dashboard.UnitsInStock.ToString("0.##")</strong></div><div><span>Mostrando</span><strong>@ProductFiltered.Count()</strong></div></div>
                            <div class="table-wrap products-table-wrap"><table class="products-table"><thead><tr><th>ID</th><th>Código</th><th>Nombre</th><th>Costo</th><th>Precio</th><th>Mayoreo</th><th>Stock</th><th>Departamento</th><th></th></tr></thead><tbody>
                                @foreach (var product in ProductPageItems)
                                {
                                    <tr class="@(SelectedProduct?.Id == product.Id ? "selected" : "")" @onclick="() => SelectProduct(product)"><td class="muted">#@product.Id</td><td>@product.Code</td><td><strong>@product.Name</strong><small>@product.Category</small></td><td>@Pos.FormatCurrency(product.Cost)</td><td>@Pos.FormatCurrency(product.Price)</td><td>@Pos.FormatCurrency(product.WholesalePrice)</td><td><span class="stock-value @(product.Stock <= 0 ? "empty" : IsLowStock(product) ? "low" : "")">@product.Stock @product.Unit</span></td><td>@product.Department</td><td><button class="small-action" title="Modificar" @onclick:stopPropagation="true" @onclick='() => SelectProductForMode(product, "Modificar")'>✎</button><button class="small-action danger-action" title="Eliminar" @onclick:stopPropagation="true" @onclick='() => SelectProductForMode(product, "Eliminar")'>×</button></td></tr>
                                }
                            </tbody></table></div>
                            <div class="products-pagination"><span>Página @ProductPage de @ProductTotalPages · @ProductFiltered.Count() productos</span><span><button @onclick="() => ChangeProductPage(ProductPage - 1)" disabled="@(ProductPage <= 1)">‹</button><button @onclick="() => ChangeProductPage(ProductPage + 1)" disabled="@(ProductPage >= ProductTotalPages)">›</button><select value="@ProductPageSize" @onchange="ChangeProductPageSize"><option value="10">10 por página</option><option value="20">20 por página</option><option value="50">50 por página</option><option value="100">100 por página</option></select></span></div>
                        </section>
                    </div>
                </div>
                <div class="pos-section" data-section="Inventario" hidden="@(ActiveSection != "Inventario")">
                    @ModuleHeading("OPERACIÓN", "Inventario", "Administra existencias, movimientos y reportes del inventario.")
                    <div class="inventory-toolbar">
                        <button class="@(InventoryMode == "Agregar" ? "active" : "")" @onclick='() => SetInventoryMode("Agregar")'>＋ Agregar</button>
                        <button class="@(InventoryMode == "Ajustes" ? "active" : "")" @onclick='() => SetInventoryMode("Ajustes")'>⚙ Ajustes</button>
                        <button class="@(InventoryMode == "Bajos" ? "active" : "")" @onclick='() => SetInventoryMode("Bajos")'>⚠ Productos bajos</button>
                        <button class="@(InventoryMode == "Reporte" ? "active" : "")" @onclick='() => SetInventoryMode("Reporte")'>▤ Reporte inventario</button>
                        <button class="@(InventoryMode == "Movimientos" ? "active" : "")" @onclick='() => SetInventoryMode("Movimientos")'>↕ Movimientos</button>
                        <button class="@(InventoryMode == "Kardex" ? "active" : "")" @onclick='() => SetInventoryMode("Kardex")'>▥ Kardex</button>
                        <button @onclick="ExportInventoryAsync">⇩ Exportar Excel</button>
                        <label class="inventory-import-button">⇧ Importar Excel/CSV<InputFile accept=".xlsx,.csv,.txt" OnChange="ImportInventoryAsync" /></label>
                    </div>
                    @if (InventoryMode == "Bajos")
                    {
                        <section class="data-card inventory-action-card">
                            <div class="inventory-action-heading"><div><span class="eyebrow">ALERTAS</span><h2>Productos bajos de stock</h2><p>Se listan productos con existencia igual o menor al mínimo del producto o al umbral global del POS.</p></div></div>
                            <div class="inventory-adjust-grid">
                                <label>Umbral global del POS<input value="@InventoryLowStockThresholdText" @oninput="SetInventoryLowStockThresholdText" inputmode="decimal" placeholder="5" /></label>
                                <button class="primary-button" @onclick="SaveInventoryLowStockThresholdAsync">Guardar umbral</button>
                                <div class="inventory-selected"><span>Productos bajos ahora</span><strong>@InventoryLowStockCount</strong><small>Mín. por producto en Productos · si está en 0, se usa el umbral global (@InventoryLowStockThreshold.ToString("0.##"))</small></div>
                            </div>
                        </section>
                    }
                    @if (InventoryMode == "Agregar" || InventoryMode == "Ajustes")
                    {
                        <section class="data-card inventory-action-card">
                            <div class="inventory-action-heading"><div><span class="eyebrow">INVENTARIO</span><h2>@(InventoryMode == "Ajustes" ? "Ajustar inventario" : "Agregar inventario")</h2><p>Selecciona un producto e indica una cantidad positiva o negativa.</p></div></div>
                            <div class="inventory-adjust-grid">
                                <label>Buscar por código o nombre<input list="inventory-products" value="@InventoryProductQuery" @oninput="HandleInventoryProductInput" placeholder="Código o nombre" /><datalist id="inventory-products">
                                    @foreach (var product in Pos.Products)
                                    {
                                        <option value="@product.Code">@product.Name</option>
                                    }
                                </datalist></label>
                                <div class="inventory-selected"><span>Producto seleccionado</span><strong>@(InventorySelectedProduct?.Name ?? "Ninguno")</strong><small>Stock actual: @(InventorySelectedProduct?.Stock.ToString("0.##") ?? "—")</small></div>
                                <label>Cantidad (+/-)<input @bind="InventoryQuantityText" inputmode="numeric" /></label>
                                <button class="primary-button" @onclick="SaveInventoryAdjustmentAsync">Guardar movimiento</button>
                            </div>
                        </section>
                    }
                    @if (InventoryMode == "Reporte")
                    {
                        <section class="data-card inventory-report-card"><div class="inventory-report-header"><div><span class="eyebrow">REPORTE</span><h2>Reporte de inventario</h2><p>@InventoryFilteredProducts.Count() productos en el filtro actual.</p></div><label>Departamento<select @bind="InventoryDepartment">
                            @foreach (var department in InventoryDepartments)
                            {
                                <option>@department</option>
                            }
                        </select></label></div><div class="inventory-stats"><div><span>Costo total</span><strong>@Pos.FormatCurrency(InventoryFilteredProducts.Sum(x => x.Cost * x.Stock))</strong></div><div><span>Unidades</span><strong>@InventoryFilteredProducts.Sum(x => x.Stock).ToString("0.##")</strong></div><div><span>Productos</span><strong>@InventoryFilteredProducts.Count()</strong></div></div></section>
                    }
                    @if (InventoryMode == "Movimientos" || InventoryMode == "Kardex")
                    {
                        @InventoryHistoryTable()
                    }
                    @if (InventoryMode != "Movimientos" && InventoryMode != "Kardex")
                    {
                        @InventoryListTable()
                    }
                    @if (!string.IsNullOrWhiteSpace(InventoryNotice)) { <div class="config-notice">@InventoryNotice</div> }
                </div>
                <div class="pos-section" data-section="Other" hidden="@(ActiveSection is "Ventas" or "Productos" or "Inventario")">
                @if (ActiveSection == "Reportes")
                {
                    @ModuleHeading("GESTIÓN", "Reportes", "Analiza ventas, métodos de pago, productos y actividad de la caja.")
                    <div class="reports-toolbar">
                        <div class="reports-tabs"><button class="@(ReportView == "Dashboard" ? "active" : "")" @onclick='() => SetReportView("Dashboard")'>Resumen</button><button class="@(ReportView == "Ventas" ? "active" : "")" @onclick='() => SetReportView("Ventas")'>Ventas del día</button></div>
                        <label>Periodo<select value="@ReportPeriod" @onchange="ChangeReportPeriod"><option value="Hoy">Hoy</option><option value="7Dias">Últimos 7 días</option><option value="Mes">Mes actual</option></select></label>
                        @if (ReportPeriod == "Mes")
                        {
                            <label>Mes<select value="@ReportMonth" @onchange="ChangeReportMonth">@foreach (var month in Enumerable.Range(1, 12)) { <option value="@month">@Spanish.DateTimeFormat.GetMonthName(month)</option> }</select></label>
                            <label>Año<select value="@ReportYear" @onchange="ChangeReportYear">@foreach (var year in ReportYears) { <option value="@year">@year</option> }</select></label>
                        }
                        <button class="outline-button" @onclick="LoadReportsAsync">↻ Actualizar</button><button class="outline-button" @onclick="ExportSalesCsvAsync">⇩ CSV</button><button class="primary-button" @onclick="ExportReportPdfAsync">⇩ Exportar PDF</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ReportNotice))
                    {
                        <div class="reports-notice">@ReportNotice</div>
                    }
                    @if (ReportView == "Dashboard" && ReportData is not null)
                    {
                        <div class="reports-kpi-grid">
                            <div class="report-kpi"><span>Ventas del periodo</span><strong>@Pos.FormatCurrency(ReportData.Total)</strong><small>@ReportData.Transactions transacciones</small></div>
                            <div class="report-kpi"><span>Ticket promedio</span><strong>@Pos.FormatCurrency(ReportData.AverageTicket)</strong><small>@ReportData.Units.ToString("0.##") artículos vendidos</small></div>
                            <div class="report-kpi"><span>Comparación anterior</span><strong class="@(ReportData.Variation >= 0 ? "positive" : "negative")">@ReportData.Variation.ToString("0.##")%</strong><small>@Pos.FormatCurrency(ReportData.PreviousTotal) periodo anterior</small></div>
                            <div class="report-kpi"><span>Actividad últimos 30 días</span><strong>@ReportData.ActiveDays30 días</strong><small>@Pos.FormatCurrency(ReportData.Total30) en @ReportData.Transactions30 ventas</small></div>
                        </div>
                        <div class="reports-chart-grid">
                            <section class="data-card report-chart-card"><div class="report-card-heading"><div><span class="eyebrow">TENDENCIA</span><h2>Ventas por día</h2></div><span>Periodo seleccionado</span></div><div class="report-bars">@foreach (var point in ReportData.Days) { var max = Math.Max(1m, ReportData.Days.Max(x => x.Total)); <div class="report-bar-column"><strong>@Pos.FormatCurrency(point.Total)</strong><div class="report-bar-track"><i style="height:@($"{Math.Max(5m, point.Total / max * 100):0.#}%")"></i></div><small>@point.Label.ToString("dd/MM")</small></div> }</div></section>
                            <section class="data-card report-chart-card"><div class="report-card-heading"><div><span class="eyebrow">HOY</span><h2>Ventas por hora</h2></div><span>Actividad horaria</span></div><div class="report-bars hourly">@foreach (var point in ReportData.Hours.Where(x => x.Total > 0 || (x.Label.Hour >= 8 && x.Label.Hour <= 22))) { var max = Math.Max(1m, ReportData.Hours.Max(x => x.Total)); <div class="report-bar-column"><div class="report-bar-track"><i style="height:@($"{Math.Max(5m, point.Total / max * 100):0.#}%")"></i></div><small>@point.Label.ToString("HH")</small></div> }</div></section>
                        </div>
                        <div class="reports-detail-grid">
                            <section class="data-card"><div class="report-card-heading"><div><span class="eyebrow">DESGLOSE</span><h2>Métodos de pago</h2></div></div><div class="report-list">@foreach (var payment in ReportData.Payments) { <div><span>@payment.Method <small>@payment.Transactions operaciones</small></span><strong>@Pos.FormatCurrency(payment.Total)</strong></div> }</div></section>
                            <section class="data-card"><div class="report-card-heading"><div><span class="eyebrow">PRODUCTOS</span><h2>Más vendidos</h2></div></div><div class="report-list">@foreach (var product in ReportData.TopProducts) { <div><span><b>@product.Name</b><small>@product.Quantity.ToString("0.##") unidades - EAN: @product.Code</small></span><strong>@Pos.FormatCurrency(product.Revenue)</strong></div> }</div></section>
                            <section class="data-card report-business-card"><div class="report-card-heading"><div><span class="eyebrow">ESTADO DEL NEGOCIO</span><h2>Actividad reciente</h2></div></div><p>Producto líder: <strong>@ReportData.LeadingProduct</strong></p><p><strong>@ReportData.Units30.ToString("0.##")</strong> unidades vendidas en los últimos 30 días.</p>@if (ReportCashData is not null) { <p>Caja esperada: <strong>@Pos.FormatCurrency(ReportCashData.Expected)</strong></p><p>Diferencia acumulada: <strong class="@(ReportCashData.Difference >= 0 ? "positive" : "negative")">@Pos.FormatCurrency(ReportCashData.Difference)</strong></p> }<p class="report-status-ok">● Operación local disponible</p></section>
                        </div>
                        <section class="data-card report-personal-consumption-card"><div class="report-card-heading"><div><span class="eyebrow">INTERNO</span><h2>Consumo personal</h2></div>@if (ReportData.PersonalConsumption.Count > 0) { <span>@Pos.FormatCurrency(ReportData.PersonalConsumption.Sum(x => x.Total))</span> }</div><div class="report-list">@if (ReportData.PersonalConsumption.Count == 0) { <p class="report-empty">Sin consumo personal en el periodo.</p> } else { @foreach (var item in ReportData.PersonalConsumption) { <div><span><b>@item.ProductName</b><small>@item.Quantity.ToString("0.##") uds · Cajero: @item.Cashier · Ticket #@item.TicketNumber · @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</small></span><strong>@Pos.FormatCurrency(item.Total)</strong></div> } }</div></section>
                    }
                    else if (ReportView == "Ventas" && SalesReport is not null)
                    {
                        <section class="data-card reports-sales-filters"><div class="reports-filter-row"><label>Fecha<input type="date" value="@ReportDateText" @onchange="ChangeReportDate" /></label><label>Cajero<select value="@ReportCashier" @onchange="ChangeReportCashier"><option>Todos</option>@foreach (var cashier in ReportCashiers) { <option value="@cashier">@cashier</option> }</select></label><label class="report-search-field">Buscar<input value="@ReportSearch" @oninput="ChangeReportSearch" placeholder="Folio, cliente o cajero" /></label><label class="report-check"><input type="checkbox" checked="@ReportCreditOnly" @onchange="ChangeReportCredit" /> Solo crédito</label><button class="outline-button" @onclick="LoadSalesReportAsync">Aplicar filtros</button></div></section>
                        <section class="reports-sales-layout"><div class="data-card reports-sales-list"><div class="report-card-heading"><div><span class="eyebrow">HISTORIAL</span><h2>Ventas del periodo</h2></div><span>@SalesReport.TotalCount resultados</span></div><div class="table-wrap"><table><thead><tr><th>Folio</th><th>Artículos</th><th>Fecha</th><th>Cajero</th><th>Pago</th><th>Total</th><th>Estado</th></tr></thead><tbody>@foreach (var sale in SalesReport.Rows) { <tr class="@(SelectedReportSale?.Id == sale.Id ? "selected" : "")" @onclick="() => SelectReportSaleAsync(sale)"><td>#@sale.TicketNumber</td><td>@sale.ItemCount</td><td>@sale.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@sale.UserName</td><td><span class="tag">@sale.PaymentMethod</span></td><td><strong>@Pos.FormatCurrency(sale.Total)</strong></td><td>@(sale.Cancelled ? "Anulada" : sale.PersonalConsumption ? "Consumo" : sale.Edited ? "Editada" : "Activa")</td></tr> }</tbody></table></div><div class="products-pagination"><span>Página @ReportSalesPage de @ReportSalesTotalPages</span><span><button @onclick="() => ChangeReportSalesPage(ReportSalesPage - 1)" disabled="@(ReportSalesPage <= 1)">‹</button><button @onclick="() => ChangeReportSalesPage(ReportSalesPage + 1)" disabled="@(ReportSalesPage >= ReportSalesTotalPages)">›</button></span></div></div>
                            <div class="data-card report-sale-detail">
                                @if (SelectedReportSaleDetail is null)
                                {
                                    <div class="detail-empty"><span>▣</span><strong>Selecciona una venta</strong><small>Consulta sus artículos y acciones disponibles.</small></div>
                                }
                                else
                                {
                                    <div class="report-card-heading"><div><span class="eyebrow">TICKET #@SelectedReportSaleDetail.TicketNumber</span><h2>Detalle de venta</h2></div><span>@SelectedReportSaleDetail.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                                    <div class="report-sale-meta"><span>Cajero<strong>@SelectedReportSaleDetail.UserName</strong></span><span>Cliente<strong>@SelectedReportSaleDetail.Customer</strong></span><span>Pago<strong>@SelectedReportSaleDetail.PaymentMethod</strong></span></div>
                                    @if (SelectedReportSaleDetail.Edited)
                                    {
                                        <div class="report-sale-edit-notice">
                                            <strong>Ticket editado</strong>
                                            @if (SelectedReportSaleDetail.EditedAtUtc is not null && !string.IsNullOrWhiteSpace(SelectedReportSaleDetail.EditedByUserName))
                                            {
                                                <small>Última edición: @SelectedReportSaleDetail.EditedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @SelectedReportSaleDetail.EditedByUserName</small>
                                            }
                                            @foreach (var edit in SelectedReportSaleDetail.Edits)
                                            {
                                                <small>@edit.EditedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @edit.UserName · @edit.Summary</small>
                                            }
                                        </div>
                                    }
                                    <div class="report-line-list">
                                        @foreach (var line in SelectedReportSaleDetail.Lines)
                                        {
                                            <div>
                                                <span><b>@line.ProductName</b><small>@line.Quantity.ToString("0.##") × @Pos.FormatCurrency(line.UnitPrice)</small></span>
                                                @if (ReportSaleEditMode)
                                                {
                                                    <div class="report-edit-qty">
                                                        <button class="small-action" disabled="@(GetReportEditQty(line.Id) <= 0)" @onclick="() => ChangeReportEditQty(line.Id, -1)">−</button>
                                                        <span>@GetReportEditQty(line.Id).ToString("0.##")</span>
                                                        <button class="small-action" disabled="@(GetReportEditQty(line.Id) >= line.Quantity)" @onclick="() => ChangeReportEditQty(line.Id, 1)">+</button>
                                                    </div>
                                                    @if (GetReportEditLineRefund(line) > 0)
                                                    {
                                                        <small class="report-edit-line-refund">−@Pos.FormatCurrency(GetReportEditLineRefund(line))</small>
                                                    }
                                                }
                                                else
                                                {
                                                    <strong>@Pos.FormatCurrency(line.Total)</strong>
                                                    <button class="small-action" title="Devolver una unidad" disabled="@(SelectedReportSaleDetail.Cancelled || !Pos.CanCancelSales)" @onclick="() => RefundReportLineAsync(line)">↩</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="report-sale-total"><span>@(ReportSaleEditMode ? "Nuevo total" : "Total")</span><strong>@Pos.FormatCurrency(ReportSaleEditMode ? GetReportEditTotal() : SelectedReportSaleDetail.Total)</strong></div>
                                    @if (ReportSaleEditMode || SelectedReportSaleDetail.Discount > 0)
                                    {
                                        <div class="report-sale-subtotals">
                                            <div><span>Subtotal</span><strong>@Pos.FormatCurrency(ReportSaleEditMode ? GetReportEditSubtotal() : SelectedReportSaleDetail.Subtotal)</strong></div>
                                            <div><span>Descuento</span><strong>@Pos.FormatCurrency(ReportSaleEditMode ? GetReportEditDiscount() : SelectedReportSaleDetail.Discount)</strong></div>
                                        </div>
                                    }
                                    @if (ReportSaleEditMode)
                                    {
                                        var refundAmount = GetReportEditRefundAmount();
                                        <div class="report-sale-edit-summary">
                                            <div><span>Total anterior</span><strong>@Pos.FormatCurrency(SelectedReportSaleDetail.Total)</strong></div>
                                            <div><span>Descuento anterior</span><strong>@Pos.FormatCurrency(SelectedReportSaleDetail.Discount)</strong></div>
                                            <div><span>Diferencia</span><strong class="@(refundAmount > 0 ? "negative" : "")">@Pos.FormatCurrency(refundAmount)</strong></div>
                                            <div class="report-sale-refund"><span>A devolver al cliente</span><strong>@Pos.FormatCurrency(refundAmount)</strong></div>
                                            @if (GetReportEditRemovedUnits() > 0)
                                            {
                                                <small>@GetReportEditRemovedUnits().ToString("0.##") unidad(es) se devolverán al stock</small>
                                            }
                                            else
                                            {
                                                <small>Reduce cantidades con − para calcular la devolución</small>
                                            }
                                        </div>
                                    }
                                    <div class="report-actions">
                                        @if (ReportSaleEditMode)
                                        {
                                            <button class="primary-button" @onclick="SaveReportSaleEditAsync">Guardar cambios</button>
                                            <button class="outline-button" @onclick="CancelReportSaleEdit">Cancelar edición</button>
                                        }
                                        else
                                        {
                                            <button class="outline-button" disabled="@(SelectedReportSaleDetail.Cancelled || !Pos.CanCancelSales)" @onclick="BeginReportSaleEdit">Editar ticket</button>
                                            <button class="danger-button" disabled="@(SelectedReportSaleDetail.Cancelled || !Pos.CanCancelSales)" @onclick="CancelReportSaleAsync">Anular venta</button>
                                            <button class="outline-button" @onclick="ReprintReportSaleAsync">Reimprimir ticket</button>
                                        }
                                    </div>
                                }
                            </div></section>
                    }
                }
                else if (ActiveSection == "Corte")
                {
                    @ModuleHeading("GESTIÓN", "Corte de caja", "Controla la jornada y prepara el cierre de la caja.")
                    <section class="shift-schedule-card">
                        <div><span class="eyebrow">HORARIO DEL TURNO</span><h2>Programar corte automático</h2><p>El turno se cerrará automáticamente al alcanzar la hora configurada.</p></div>
                        <div class="shift-schedule-fields">
                            <label>Inicio del turno<input type="time" value="@ShiftStartTime" @oninput="SetShiftStartTime" /></label>
                            <label>Cierre del turno<input type="time" value="@ShiftEndTime" @oninput="SetShiftEndTime" /></label>
                            <button class="primary-button" @onclick="SaveShiftScheduleAsync">Guardar horario</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Pos.ShiftScheduleNotice)) { <div class="config-notice">@Pos.ShiftScheduleNotice</div> }
                    </section>
                    <section class="closing-card"><div class="closing-status"><span class="big-status @(Pos.CashStatus == "Abierta" ? "open" : "closed")">●</span><div><span>Estado actual</span><strong>Caja @Pos.CashStatus.ToLowerInvariant()</strong></div></div><div class="closing-total"><span>Saldo acumulado</span><strong>@Pos.FormatCurrency(Pos.CashBalance)</strong></div><button class="primary-button" @onclick="ToggleCashRegister">@(Pos.CashStatus == "Abierta" ? "Cerrar jornada" : "Abrir jornada")</button></section>
                    @if (ReportCashData is not null)
                    {
                        <section class="data-card cash-cut-summary"><div class="report-card-heading"><div><span class="eyebrow">CONCILIACIÓN</span><h2>Resumen del turno seleccionado</h2></div><button class="outline-button" @onclick="LoadReportsAsync">Actualizar</button></div><div class="cash-summary-grid"><span>Inicio<strong>@Pos.FormatCurrency(ReportCashData.Opening)</strong></span><span>Ventas efectivo<strong>@Pos.FormatCurrency(ReportCashData.CashSales)</strong></span><span>Entradas<strong>@Pos.FormatCurrency(ReportCashData.Entries)</strong></span><span>Salidas<strong>@Pos.FormatCurrency(ReportCashData.Exits)</strong></span><span>Anulaciones<strong>@Pos.FormatCurrency(ReportCashData.Cancelled)</strong></span><span>Esperado<strong>@Pos.FormatCurrency(ReportCashData.Expected)</strong></span><span>Diferencia<strong class="@(ReportCashData.Difference >= 0 ? "positive" : "negative")">@Pos.FormatCurrency(ReportCashData.Difference)</strong></span></div><div class="cash-history-list">@foreach (var shift in ReportCashData.History) { <div><span><b>@shift.RegisterName · @shift.UserName</b><small>@shift.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") - @(shift.ClosedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Abierto")</small></span><strong>@Pos.FormatCurrency(shift.ClosingAmount ?? 0)</strong></div> }</div></section>
                    }
                    <section class="data-card"><h2>Últimas operaciones</h2>@SalesTable()</section>
                }
                else if (ActiveSection == "Web")
                {
                    @ModuleHeading("SERVICIOS", "Portal Web", "Accede a los servicios online disponibles para esta caja.")
                    <section class="integration-card"><span class="integration-logo">S</span><div><h2>Servipag</h2><p>El portal se abrirá en una pestaña independiente de Chrome para conservar la seguridad del pago.</p></div><button class="primary-button" @onclick="OpenServipag">Abrir Servipag ↗</button></section>
                }
                else if (ActiveSection == "Soporte")
                {
                    @ModuleHeading("AYUDA", "Soporte en línea", "Solicita asistencia y consulta el estado de tu instalación.")
                    <section class="integration-card"><span class="integration-logo">?</span><div><h2>Soporte GrünFlex</h2><p>Contacta al equipo de soporte por WhatsApp o revisa el estado de tu instalación local.</p></div><span class="setting-ok">Disponible</span></section>
                    <div class="config-actions">
                        <a class="primary-button" href="https://wa.me/56912345678?text=Hola%2C%20necesito%20ayuda%20con%20Grunflex%20POS" target="_blank" rel="noopener">WhatsApp Soporte ↗</a>
                        <button class="outline-button" @onclick="RunConfigurationDiagnosticsAsync">Diagnóstico del sistema</button>
                    </div>
                }
                else
                {
                    @ModuleHeading("SISTEMA", "Configuración", "Conexiones locales y preferencias del punto de venta.")
                    <section class="config-copy-window" aria-label="Panel de configuración del POS instalable">
                        <button type="button" class="config-license-card" @onclick='() => ConfigCardClicked("Licencia")'>
                            <span class="config-license-icon">♛</span>
                            <span><strong>Estado de licencia y sincronización</strong><small>Revisa el estado de tu licencia y la sincronización de datos en la nube.</small></span>
                            <b>›</b>
                        </button>
                        <div class="config-copy-group-title general"><span>⚙</span> GENERAL</div>
                        <div class="config-copy-grid">
                            @ConfigCard("⚙", "Opciones habilitadas", "Configura funciones del sistema", "general", "Opciones")
                            @ConfigCard("▣", "Cajero", "Administra cajeros", "general", "Cajero")
                            @ConfigCard("⌘", "Base de datos", "Gestiona tu base de datos", "general", "BaseDatos")
                            @ConfigCard("▤", "Facturación", "Configure facturación", "general", "Facturacion")
                            @ConfigCard("▥", "Modificar folio", "Administra folios", "general", "Folio")
                            @ConfigCard("▦", "Administrar caja", "Configura tus cajas", "general", "Cajas")
                        </div>
                        <div class="config-copy-group-title personalization"><span>✥</span> PERSONALIZACIÓN</div>
                        <div class="config-copy-grid">
                            @ConfigCard("◎", "Logotipo", "Personaliza tu marca", "personalization", "Logo")
                            @ConfigCard("▣", "Impresora de ticket", "Configura impresoras", "personalization", "Impresora")
                            @ConfigCard("▧", "Boleta", "Personaliza tu ticket de venta", "personalization", "Boleta")
                            @ConfigCard("▤", "Formas de pago", "Administra métodos", "personalization", "Pagos")
                            @ConfigCard("▥", "Corte", "Configura corte de caja", "red", "Corte")
                            @ConfigCard("⌘", "Unidades de medida", "Gestiona unidades", "green", "Unidades")
                            @ConfigCard("▰", "Lector de código", "Configura dispositivos", "orange", "Scanner")
