    private async Task HandlePromoEditSearchKey(KeyboardEventArgs args)
    {
        var suggestions = PromoEditSuggestions.ToList();
        if (args.Key is "ArrowDown" or "ArrowUp")
        {
            if (suggestions.Count == 0)
                return;
            if (PromoEditSuggestionIndex < 0)
                PromoEditSuggestionIndex = 0;
            else if (args.Key == "ArrowDown")
                PromoEditSuggestionIndex = Math.Min(PromoEditSuggestionIndex + 1, suggestions.Count - 1);
            else
                PromoEditSuggestionIndex = Math.Max(PromoEditSuggestionIndex - 1, 0);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (args.Key is not ("Enter" or "NumpadEnter"))
            return;

        if (PromoEditSuggestionIndex >= 0 && PromoEditSuggestionIndex < suggestions.Count)
            LoadPromotionForEdit(suggestions[PromoEditSuggestionIndex]);
        else
        {
            var query = (PromoEditQuery ?? string.Empty).Trim();
            var match = Pos.Products.FirstOrDefault(p => PromotionCatalog.IsPromotion(p) &&
                    p.Code.Equals(query, StringComparison.OrdinalIgnoreCase))
                ?? Pos.Products.FirstOrDefault(p => PromotionCatalog.IsPromotion(p) &&
                    p.Name.Equals(query, StringComparison.OrdinalIgnoreCase))
                ?? Pos.Products.FirstOrDefault(p => PromotionCatalog.IsPromotion(p) &&
                    MatchesProductText(p, query));
            if (match is null)
            {
                ProductNotice = string.IsNullOrWhiteSpace(query)
                    ? "Indica el código o nombre de la promoción."
                    : $"No se encontró la promoción '{query}'.";
                return;
            }
            LoadPromotionForEdit(match);
        }
    }

    private void LoadPromotionForEdit(PosProduct promo)
    {
        if (!PromotionCatalog.IsPromotion(promo))
        {
            ProductNotice = "Selecciona una promoción válida.";
            return;
        }

        PromoEditId = promo.Id;
        PromoEditCode = promo.Code;
        PromoEditQuery = promo.Name;
        PromoEditSuggestionIndex = -1;
        PromoName = promo.Name;
        PromoPrice = promo.Price.ToString("0.##", Spanish);
        PromoProductQuery = string.Empty;
        PromoSuggestionIndex = -1;
        SelectedProduct = promo;

        var components = PromotionCatalog.Parse(promo.PromotionComponentsJson);
        PromoComponents = [];
        foreach (var component in components)
        {
            var live = Pos.Products.FirstOrDefault(p => p.Id == component.ProductId);
            if (live is null)
                continue;
            PromoComponents.Add(new PromoComponentRow(
                live.Id, live.Code, live.Name, component.Quantity, live.Price, live.Stock));
        }

        ProductNotice = $"Promoción cargada: {promo.Name}";
        ProductPage = 1;
        ProductSearchText = promo.Name;
    }

    private async Task SavePromotionAsync()
    {
        if (!Pos.CanAccessProducts)
        {
            ProductNotice = ProductMode == "ModificarPromoción"
                ? "No tienes permiso para modificar promociones."
                : "No tienes permiso para crear promociones.";
            return;
        }
        if (!TryParseProductDecimal(PromoPrice, out var price))
        {
            ProductNotice = "El precio de la promoción debe ser un valor numérico válido.";
            return;
        }

        var components = PromoComponents
            .Select(x => new PromotionComponentInput(x.ProductId, x.Quantity))
            .ToArray();

        ProductWriteResult result;
        if (ProductMode == "ModificarPromoción")
        {
            if (PromoEditId is not int editId || editId <= 0)
            {
                ProductNotice = "Busca y selecciona una promoción para modificar.";
                return;
            }
            result = await ConfigStore.UpdatePromotionAsync(
                editId, PromoName, price, wholesalePrice: 0m, components, Pos.UserName);
            ProductNotice = result.Message;
        }
        else
        {
            var promoCode = $"PROMO-{DateTime.Now:yyyyMMddHHmmss}-00";
            result = await ConfigStore.CreatePromotionAsync(
                promoCode, PromoName, price, wholesalePrice: 0m, components, Pos.UserName);
            ProductNotice = result.Success
                ? $"{result.Message} Código: {promoCode}"
                : result.Message;
        }

        if (!result.Success)
            return;

        await Pos.ReloadProductsAfterMutationAsync();
        if (ProductMode == "ModificarPromoción" && result.ProductId > 0)
        {
            var updated = Pos.Products.FirstOrDefault(p => p.Id == result.ProductId);
            if (updated is not null)
                LoadPromotionForEdit(updated);
            else
                ClearPromotionForm();
        }
        else
        {
            ClearPromotionForm();
            SelectedProduct = Pos.Products.FirstOrDefault(p => p.Id == result.ProductId);
        }
    }

    private void SelectProduct(PosProduct product)
    {
        SelectedProduct = product;
        if (ProductMode == "ModificarPromoción")
        {
            if (PromotionCatalog.IsPromotion(product))
