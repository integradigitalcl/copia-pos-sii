    private void ApplyGmailPreset()
    {
        var email = ConfigEmail.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(email))
        {
            EmailStatus = "Primero ingrese su correo electrónico.";
            return;
        }

        if (!email.Contains("@gmail.com", StringComparison.Ordinal))
        {
            EmailStatus = "El preset Gmail solo aplica a cuentas @gmail.com.";
            return;
        }

        ConfigSmtpHost = "smtp.gmail.com";
        ConfigSmtpPort = "587";
        ConfigSmtpSsl = true;
        EmailStatus = "Preset Gmail aplicado. Use una clave de aplicación como contraseña.";
    }

    private async Task TestEmailConfigurationAsync()
    {
        EmailStatus = string.Empty;
        if (!ConfigEmailEnabled)
        {
            EmailStatus = "Active las notificaciones por correo antes de probar.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ConfigEmail.Trim()))
        {
            EmailStatus = "Ingrese el correo electrónico.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ConfigEmailPassword))
        {
            EmailStatus = "Ingrese la contraseña o clave de aplicación.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ConfigSmtpHost.Trim()))
        {
            EmailStatus = "Ingrese el servidor SMTP.";
            return;
        }

        await ConfigStore.SetSettingsAsync(new Dictionary<string, string>
        {
            ["correo_activo"] = "true",
            ["correo_email"] = ConfigEmail.Trim(),
            ["correo_clave"] = ConfigEmailPassword,
            ["correo_smtp_host"] = ConfigSmtpHost.Trim(),
            ["correo_smtp_puerto"] = NormalizeNumber(ConfigSmtpPort, "587"),
            ["correo_smtp_ssl"] = ConfigSmtpSsl.ToString().ToLowerInvariant(),
            ["correo_host"] = ConfigSmtpHost.Trim(),
            ["correo_puerto"] = NormalizeNumber(ConfigSmtpPort, "587"),
            ["correo_ssl"] = ConfigSmtpSsl.ToString().ToLowerInvariant()
        });

        var result = await Email.SendTestAsync();
        EmailStatus = result.Message;
    }

