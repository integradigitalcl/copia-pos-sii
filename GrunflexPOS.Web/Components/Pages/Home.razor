                        {
                            <div class="boleta-preview-meta">Cliente: Público en general</div>
                        }
                        <input class="boleta-line-input boleta-line-footer" @bind="ConfigTicket.Line12" />
                        <input class="boleta-line-input boleta-line-footer" @bind="ConfigTicket.Line13" />
                    </div>
                    <div class="boleta-margin-row">
                        <span>Líneas abajo</span>
                        <input type="number" min="0" max="20" @bind="ConfigTicket.BottomBlankLines" />
                        <span>líneas</span>
                    </div>
                    <p class="boleta-token-hint">En las líneas de totales puedes usar <strong>{TOTAL}</strong> y <strong>{ARTICULOS}</strong> como marcadores dinámicos.</p>
                </div>
                <div class="boleta-settings-pane">
                    <div class="boleta-settings-group">
                        <h3>Formato de impresión</h3>
                        <div class="config-form-grid">
                            <label>Fuente
                                <select @bind="ConfigTicket.FontFamily">
                                    <option>Courier New</option>
                                    <option>Consolas</option>
                                    <option>Lucida Console</option>
                                    <option>Arial</option>
                                </select>
