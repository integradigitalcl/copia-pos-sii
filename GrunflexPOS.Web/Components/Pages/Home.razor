    private async Task DownloadConfigurationAsync()
    {
        if (string.IsNullOrWhiteSpace(ConfigDatabaseExport))
            await ExportConfigurationAsync();
        var encoded = Convert.ToBase64String(Encoding.UTF8.GetBytes(ConfigDatabaseExport));
        await JS.InvokeVoidAsync("eval", $"const a=document.createElement('a');a.href='data:application/json;base64,{encoded}';a.download='grunflex-configuracion.json';a.click();");
    }

