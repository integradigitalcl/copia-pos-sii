    private async Task CancelReportSaleAsync()
    {
        if (SelectedReportSaleDetail is null)
            return;
        if (!Pos.CanCancelSales)
        {
            ReportNotice = "No tienes permiso para anular ventas.";
            return;
        }
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Anular la venta #{SelectedReportSaleDetail.TicketNumber}? El stock será restaurado.");
        if (!confirmed)
            return;
        var syncToCentral = ShouldSyncReportSaleToMulticaja();
        if (syncToCentral && Pos.TryGetMulticajaContext(out var cajaId, out var sessionId, out var userId))
        {
            var central = await Multicaja.VoidSaleAsync(cajaId, sessionId, userId, (int)SelectedReportSaleDetail.TicketNumber);
            if (!central.Success && !central.Queued)
            {
                if (!IsMulticajaScopeError(central.Message))
                {
                    ReportNotice = central.Message;
                    return;
                }
                syncToCentral = false;
            }
            else if (central.Queued)
            {
                ReportNotice = central.Message;
            }
        }
        var result = await Reports.CancelSaleAsync(SelectedReportSaleDetail.Id, Pos.UserName);
        ReportNotice = result.Message + (syncToCentral ? string.Empty : LocalOnlyCentralNotice);
        if (result.Success)
        {
            await LoadReportsAsync();
            await Pos.RefreshAsync();
            await SelectReportSaleAsync(SelectedReportSale!);
        }
    }

