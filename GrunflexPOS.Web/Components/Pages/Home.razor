    private async Task NavigatePromoSuggestionsWithArrowsAsync(string key)
    {
        if (string.IsNullOrWhiteSpace(PromoProductQuery))
        {
            PromoSuggestionIndex = -1;
            return;
        }

        var suggestions = PromoProductSuggestions.ToList();
        if (suggestions.Count == 0)
        {
            PromoSuggestionIndex = -1;
            return;
        }

        if (PromoSuggestionIndex < 0)
            PromoSuggestionIndex = 0;
        else if (key == "ArrowDown")
            PromoSuggestionIndex = Math.Min(PromoSuggestionIndex + 1, suggestions.Count - 1);
        else if (key == "ArrowUp")
            PromoSuggestionIndex = Math.Max(PromoSuggestionIndex - 1, 0);

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("grunflexKeyboard.scrollPromoSuggestion", PromoSuggestionIndex);
        }
        catch (JSException)
