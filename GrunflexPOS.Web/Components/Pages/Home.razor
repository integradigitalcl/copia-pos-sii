    private bool MatchesSaleSearch(PosProduct product)
    {
        var category = string.IsNullOrWhiteSpace(product.Category) ? "General" : product.Category;
        if (SelectedCategory != "Todos" &&
            !category.Equals(SelectedCategory, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(SearchText))
            return true;

        return (product.Name ?? string.Empty).Contains(SearchText, StringComparison.OrdinalIgnoreCase)
               || (product.Code ?? string.Empty).Contains(SearchText, StringComparison.OrdinalIgnoreCase);
    }
    private IEnumerable<PosProduct> ProductFiltered => Pos.Products.Where(product =>
        (ProductCategoryFilter == "Todos" || product.Category == ProductCategoryFilter) &&
        (ProductDepartmentFilter == "Todos" || product.Department == ProductDepartmentFilter) &&
        (ProductStockFilter == "Todos" ||
         (ProductStockFilter == "Con stock" && product.Stock > 0) ||
         (ProductStockFilter == "Sin stock" && product.Stock <= 0) ||
         (ProductStockFilter == "Bajo mínimo" && IsLowStock(product))) &&
        (string.IsNullOrWhiteSpace(ProductSearchText) ||
         product.Name.Contains(ProductSearchText, StringComparison.OrdinalIgnoreCase) ||
         product.Code.Contains(ProductSearchText, StringComparison.OrdinalIgnoreCase) ||
         product.Id.ToString(CultureInfo.InvariantCulture).Contains(ProductSearchText, StringComparison.OrdinalIgnoreCase)));
