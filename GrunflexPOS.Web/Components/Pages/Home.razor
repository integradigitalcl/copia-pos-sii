@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using System.Text
@using ClosedXML.Excel
@using GrunflexPOS.Web.Services
@using GrunflexPOS.Web.Services.Licensing
@using Microsoft.AspNetCore.Components.Forms
@inject PosSessionState Pos
@inject LocalPosStore ConfigStore
@inject LocalReportsService Reports
@inject ReportsPdfService ReportsPdfService
@inject HardwareBridgeClient Bridge
@inject BoletaPdfService BoletaPdf
@inject TicketTemplateService TicketTemplate
@inject PosLogoService PosLogo
@inject MulticajaClient Multicaja
@inject WebLicenseState License
@inject LicensingCloudClient LicensingCloud
@inject CloudBackupService CloudBackup
@inject PosEmailService Email
@inject InvoiceEmissionService Invoice
@inject IJSRuntime JS

<PageTitle>Grunflex POS</PageTitle>

@if (Pos.IsLoading)
{
    <main class="loading-page"><div class="brand-mark brand-mark-large">G</div><span>Cargando datos locales…</span></main>
}
else if (!string.IsNullOrWhiteSpace(Pos.StartupError))
{
    <main class="login-page">
        <section class="login-card">
            <img class="login-logo" src="assets/logo_login_transparent.png" alt="Grunflex POS" />
            <span class="eyebrow">ERROR DE INICIO</span>
            <h1>No se pudo abrir el POS</h1>
            <p class="login-subtitle">@Pos.StartupError</p>
            <button class="primary-button login-button" @onclick="RetryStartupAsync">Reintentar</button>
            <small class="login-hint">Si instaló como caja principal, verifique que el servicio GrunflexPOSAPI esté en ejecución (puerto 7279).</small>
        </section>
    </main>
}
else if (Pos.LicenseActivationRequired)
{
    <main class="login-page">
        <section class="login-card">
            <img class="login-logo" src="assets/logo_login_transparent.png" alt="Grunflex POS" />
            <span class="eyebrow">ACTIVACIÓN DE LICENCIA</span>
            <h1>Active su licencia GrünFlex</h1>
            <p class="login-subtitle">@Pos.LicenseBlockReason</p>
            <label class="field-label" for="activation-id">Activation ID</label>
            <input id="activation-id" class="text-input" @bind="LicenseActivationId" placeholder="GF-XXXX-XXXX" />
            <button class="primary-button login-button" @onclick="ActivateLicenseOnlineAsync">Obtener licencia desde servidor</button>
            <label class="field-label" for="license-token">Token GFv2</label>
            <textarea id="license-token" class="config-export" rows="4" @bind="LicenseTokenText" placeholder="GFv2...."></textarea>
            <button class="outline-button login-button" @onclick="ActivateLicenseTokenAsync">Activar token pegado</button>
            <button type="button" class="link-button" @onclick="SyncLicenseAsync">Sincronizar licencia con servidor</button>
            @if (!string.IsNullOrWhiteSpace(LicenseNotice)) { <div class="form-error">@LicenseNotice</div> }
            <small class="login-hint">La licencia se guarda localmente y se comparte con el POS instalable en este equipo.</small>
        </section>
    </main>
}
else if (!Pos.IsAuthenticated)
{
    <main class="login-page">
        <section class="login-card">
            <img class="login-logo" src="assets/logo_login_transparent.png" alt="Grunflex POS" />
            <span class="eyebrow">PUNTO DE VENTA LOCAL</span>
            <h1>Bienvenido a Grunflex POS</h1>
            <p class="login-subtitle">Ingresa para comenzar tu jornada de ventas.</p>
            <label class="field-label" for="user">Usuario</label>
            <input id="user" class="text-input" @bind="UserName" @bind:event="oninput" autocomplete="username" placeholder="Usuario" />
            <label class="field-label" for="password">Contraseña</label>
            <input id="password" class="text-input" type="password" @bind="Password" @bind:event="oninput" autocomplete="current-password" placeholder="••••••••" @onkeydown="HandleLoginKey" />
            @if (LoginError) { <div class="form-error">@(string.IsNullOrWhiteSpace(LoginErrorMessage) ? "Credenciales incorrectas. Verifique usuario y contraseña." : LoginErrorMessage)</div> }
            <button class="primary-button login-button" @onclick="LoginAsync">Ingresar al POS <span>→</span></button>
            <button type="button" class="link-button" @onclick="() => ChangePasswordOpen = true">Cambiar contraseña</button>
            <small class="login-hint">Sesión local protegida · SQLite en este equipo</small>
        </section>
    </main>
    @if (ChangePasswordOpen)
    {
        <div class="checkout-modal-backdrop">
            <section class="small-modal" role="dialog" aria-modal="true">
                <h2>Cambiar contraseña</h2>
                <label class="field-label">Usuario</label>
                <input class="text-input" @bind="UserName" autocomplete="username" />
                <label class="field-label">Contraseña actual</label>
                <input class="text-input" type="password" @bind="CurrentPasswordText" autocomplete="current-password" />
                <label class="field-label">Nueva contraseña</label>
                <input class="text-input" type="password" @bind="NewPasswordText" autocomplete="new-password" @onkeydown="HandleChangePasswordKey" />
                @if (!string.IsNullOrWhiteSpace(ChangePasswordNotice)) { <div class="form-error">@ChangePasswordNotice</div> }
                <div class="small-modal-actions">
                    <button class="checkout-outline-button" @onclick="CloseChangePassword">Cancelar</button>
                    <button class="primary-button" @onclick="ChangePasswordAsync">Guardar</button>
                </div>
            </section>
        </div>
    }
}
else
{
    <ErrorBoundary @ref="_posErrorBoundary">
        <ChildContent>
    @if (Pos.RequiresPasswordChange)
    {
        <div class="checkout-modal-backdrop">
            <section class="small-modal" role="dialog" aria-modal="true">
                <h2>Cambie su contraseña</h2>
                <p>Por seguridad debe definir una nueva contraseña antes de operar el POS.</p>
                <label class="field-label">Contraseña actual</label>
                <input class="text-input" type="password" @bind="CurrentPasswordText" autocomplete="current-password" />
                <label class="field-label">Nueva contraseña</label>
                <input class="text-input" type="password" @bind="NewPasswordText" autocomplete="new-password" @onkeydown="HandleForceChangePasswordKey" />
                @if (!string.IsNullOrWhiteSpace(ChangePasswordNotice)) { <div class="form-error">@ChangePasswordNotice</div> }
                <div class="small-modal-actions">
                    <button class="checkout-outline-button" @onclick="Pos.Logout">Cerrar sesión</button>
                    <button class="primary-button" @onclick="ForceChangePasswordAsync">Guardar y continuar</button>
                </div>
            </section>
        </div>
    }
    <div class="pos-shell @(Pos.RequiresPasswordChange ? "is-blocked" : string.Empty)">
        <aside class="sidebar">
            <KineticLines Position="top-left" Variant="dark" Opacity="0.55" Class="sidebar-kinetic-top" />
            <div class="sidebar-brand"><div class="sidebar-logo-frame"><img src="@LogoSource" alt="Grunflex POS" /></div><span>POINT OF SALES</span></div>
            <div class="connection-pill"><span class="status-dot"></span> Sistema operativo</div>
            <nav class="main-nav" aria-label="Navegación principal">
                <span class="nav-label">OPERACIÓN</span>
                <button class='nav-item nav-card sales @(ActiveSection == "Ventas" ? "active" : "")' @onclick='() => SelectSection("Ventas")' disabled="@(!Pos.CanAccessVentas)"><span class="nav-card-icon">▣</span><span class="nav-card-copy"><small>F1</small><strong>Ventas</strong><em>Gestión de ventas y pedidos</em></span><b>›</b></button>
                <button class='nav-item nav-card products @(ActiveSection == "Productos" ? "active" : "")' @onclick='() => SelectSection("Productos")' disabled="@(!Pos.CanAccessProducts)"><span class="nav-card-icon">▤</span><span class="nav-card-copy"><small>F3</small><strong>Productos</strong><em>Catálogo y gestión de productos</em></span><b>›</b></button>
                <button class='nav-item nav-card inventory @(ActiveSection == "Inventario" ? "active" : "")' @onclick='() => SelectSection("Inventario")' disabled="@(!Pos.CanAccessInventory)"><span class="nav-card-icon">▥</span><span class="nav-card-copy"><small>F4</small><strong>Inventario</strong><em>Control de stock y almacenes</em></span><b>›</b></button>
                <span class="nav-label nav-label-spaced">GESTIÓN</span>
                <button class='nav-item nav-card reports @(ActiveSection == "Reportes" ? "active" : "")' @onclick='() => SelectSection("Reportes")' disabled="@(!Pos.CanAccessReports)"><span class="nav-card-icon">◫</span><span class="nav-card-copy"><strong>Reportes</strong><em>Análisis y reportes</em></span><b>›</b></button>
                <button class='nav-item nav-card closing @(ActiveSection == "Corte" ? "active" : "")' @onclick='() => SelectSection("Corte")'><span class="nav-card-icon">◴</span><span class="nav-card-copy"><strong>Corte</strong><em>Órdenes de corte y producción</em></span><b>›</b></button>
                <button class="premium-nav support-nav" @onclick="OpenSupport" disabled="@(!Pos.LicenseOnlineSupport)"><span class="premium-icon" aria-hidden="true">🎧</span><span><strong>Soporte en línea <mark>PREMIUM</mark></strong><em>@(Pos.LicenseOnlineSupport ? "WhatsApp integrado" : "Requiere licencia")</em></span><b>›</b></button>
            </nav>
            <div class="sidebar-spacer">
                <svg class="sidebar-art" viewBox="0 0 300 170" aria-hidden="true" focusable="false">
                    @* Mosaico multicolor (izq) *@
                    <g>
                        <rect x="6" y="118" width="18" height="18" rx="3" fill="#4cc9f0" opacity="0.95"/>
                        <rect x="28" y="118" width="18" height="18" rx="3" fill="#3a86ff" opacity="0.9"/>
                        <rect x="50" y="118" width="18" height="18" rx="3" fill="#5b6cff" opacity="0.85"/>
                        <rect x="72" y="118" width="18" height="18" rx="3" fill="#7b5cff" opacity="0.75"/>
                        <rect x="6" y="96" width="18" height="18" rx="3" fill="#2ec4b6" opacity="0.9"/>
                        <rect x="28" y="96" width="18" height="18" rx="3" fill="#4361ee" opacity="0.85"/>
                        <rect x="50" y="96" width="18" height="18" rx="3" fill="#6c63ff" opacity="0.8"/>
                        <rect x="6" y="74" width="18" height="18" rx="3" fill="#48cae4" opacity="0.75"/>
                        <rect x="28" y="74" width="18" height="18" rx="3" fill="#5a67d8" opacity="0.7"/>
                        <rect x="6" y="52" width="18" height="18" rx="3" fill="#3d5a80" opacity="0.55"/>
                        <rect x="94" y="130" width="14" height="14" rx="2.5" fill="#ff9f1c" opacity="0.95"/>
                        <rect x="118" y="108" width="12" height="12" rx="2" fill="#1d4e63" opacity="0.55"/>
                        <rect x="140" y="128" width="12" height="12" rx="2" fill="#163d4f" opacity="0.5"/>
                        <rect x="102" y="86" width="11" height="11" rx="2" fill="#1a4558" opacity="0.45"/>
                    </g>
                    @* Cubo isométrico wireframe *@
                    <g fill="none" stroke="#7eb6c9" stroke-width="1.4" opacity="0.55" stroke-linejoin="round">
                        <path d="M176 78 L206 62 L236 78 L206 94 Z"/>
                        <path d="M176 78 L176 108 L206 124 L206 94 Z"/>
                        <path d="M236 78 L236 108 L206 124 L206 94 Z"/>
                    </g>
                    @* X de cuadrados (der) *@
                    <g fill="#2a6a82" opacity="0.55">
                        <rect x="252" y="70" width="11" height="11" rx="2"/>
                        <rect x="268" y="70" width="11" height="11" rx="2"/>
                        <rect x="260" y="84" width="11" height="11" rx="2"/>
                        <rect x="252" y="98" width="11" height="11" rx="2"/>
                        <rect x="268" y="98" width="11" height="11" rx="2"/>
                    </g>
                </svg>
            </div>
            <button class="user-card" @onclick="Pos.Logout">
                <span class="avatar">@Initial</span><span class="user-copy"><strong>@Pos.UserName</strong><small>@Pos.Role · Cerrar sesión</small></span><span class="logout-icon">↪</span>
            </button>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div class="header-register"><span class="shopping-icon">🛍</span><div><strong>@Pos.CashRegister</strong><span><i class="status-dot"></i> @Pos.CashStatus</span></div></div>
                <div class="header-actions">
                    <div class="user-pill"><span class="avatar avatar-small">@Initial</span><span><strong>@DateTime.Now.ToString("HH:mm")</strong><small>@Pos.UserName</small></span></div>
                    @if (Pos.ShowHeaderCashBalance)
                    {
                        <strong class="balance financial-value">@Pos.FormatCurrency(Pos.CashBalance)</strong>
                    }
                    <span class="network-pill @Pos.MulticajaConnectionCss" title="@Pos.MulticajaStatus">
                        <i class="status-dot @Pos.MulticajaConnectionCss"></i>
                        @Pos.MulticajaConnectionLabel
                    </span>
                    <div class="notification-bell-wrapper">
                        <button class="header-button notification-bell" title="Productos con bajo stock" @onclick="ToggleNotificationPanel">🔔@if (LowStockProducts.Any()) { <span class="notification-badge">@LowStockProducts.Count()</span> }</button>
                        @if (NotificationPanelOpen)
                        {
                            <div class="notification-panel">
                                <div class="notification-panel-header"><strong>⚠ Productos bajo stock</strong><button class="small-action" @onclick="() => NotificationPanelOpen = false">✕</button></div>
                                @if (LowStockProducts.Any())
                                {
                                    <div class="notification-panel-list">
                                        @foreach (var p in LowStockProducts.Take(50))
                                        {
                                            <div class="notification-item"><span>@p.Name</span><strong class="@(p.Stock <= 0 ? "empty" : "low")">@p.Stock.ToString("0.##") @p.Unit</strong></div>
                                        }
                                    </div>
                                    <small class="notification-panel-footer">@LowStockProducts.Count() producto(s) con menos de 10 unidades</small>
                                }
                                else
                                {
                                    <div class="notification-panel-empty">✓ Todos los productos tienen stock suficiente.</div>
                                }
                            </div>
                        }
                    </div>
                    <button class="header-button settings-gear" title="Configuración" aria-label="Configuración" @onclick='() => SelectSection("Configuración")' disabled="@(!Pos.CanManageConfiguration)">⚙</button>
                    <button class="header-button" @onclick="Refresh" disabled="@IsRefreshing" title="Actualizar datos sin cerrar sesión">@(IsRefreshing ? "…" : "↻") Actualizar</button>
                    <button class="close-register button--danger" @onclick="ToggleCashRegister">@(Pos.CashStatus == "Abierta" ? "🚪 Cerrar caja" : "✓ Abrir caja")</button>
                </div>
            </header>
            <div class="page-body">
                @if (Pos.LastSaleMessage is not null) { <div class="success-banner">✓ @Pos.LastSaleMessage <button class="receipt-link" @onclick="OpenReceipts">Ver boletas</button><button @onclick="Pos.ClearLastSaleMessage">×</button></div> }
                @if (Pos.ErrorMessage is not null) { <div class="error-banner">⚠ @Pos.ErrorMessage <button @onclick="Pos.ClearError">×</button></div> }

                <div class="pos-section" data-section="Ventas" hidden="@(ActiveSection != "Ventas")">
                    <div class="sales-layout">
                    <section class="ventas-center">
                        <div class="ventas-toolbar">
                            <button class="ventas-toolbar-button button--secondary button--shortcut" @onclick="OpenProductSearchModalAsync">F10 Buscar</button>
                            <button class="ventas-toolbar-button button--secondary button--shortcut @(Pos.WholesaleMode ? "accent button--primary" : "")" @onclick="ToggleWholesale">F11 Mayoreo</button>
                            <button class="ventas-toolbar-button button--secondary button--shortcut" @onclick="ShowEntries">F7 Entradas</button>
                            <button class="ventas-toolbar-button button--secondary button--shortcut" @onclick="ShowExits">F8 Salidas</button>
                            <button class="ventas-toolbar-button button--secondary button--shortcut" @onclick="Pos.ClearCart">DEL Borrar</button>
                            <button class="ventas-toolbar-button accent button--primary button--shortcut" @onclick="AddScannedProduct">+ Enter Agregar</button>
                            <button class="ventas-toolbar-button button--secondary" @onclick="EditPurchase">Editar</button>
                            <button class="ventas-toolbar-button button--secondary" @onclick="OpenCommonProduct">+ Común</button>
                            @if (Pos.ScaleEnabled)
                            {
                                <button class="ventas-toolbar-button button--secondary" @onclick="ReadScaleWeightAsync">Báscula</button>
                            }
                            <button class="ventas-toolbar-button button--secondary" @onclick="ApplyDiscount" disabled="@(!Pos.CanApplyDiscount)">Descuento</button>
                        </div>
                        <div class="ventas-search-block">
                            <label for="venta-code-input">Código o nombre (escanear / Enter)</label>
                            <div class="ventas-search-box">
                                <img src="assets/escaner.png" alt="" />
                                <input id="venta-code-input" @oninput="HandleSearchInput" @onkeydown="HandleSaleKey" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
                                <span class="search-dropdown-arrow" aria-hidden="true">⌄</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(SearchText) && FilteredProducts.Any())
                            {
                                <div class="sales-suggestions" role="listbox">
                                    @{ var suggestionIndex = 0; }
                                    @foreach (var product in CurrentSuggestions)
                                    {
                                        <button type="button" role="option" data-suggestion-index="@suggestionIndex" data-product-id="@product.Id" aria-selected="@(SuggestionIndex == suggestionIndex)" class="@(SuggestionIndex == suggestionIndex ? "selected" : "")" @onclick="() => SelectSuggestedProduct(product)">
                                            <span>@product.Code - @product.Name</span>
                                        </button>
                                        suggestionIndex++;
                                    }
                                </div>
                            }
                        </div>
                        <div class="category-chips">
                            @foreach (var category in Categories)
                            {
                                <button type="button" class="category-chip @(SelectedCategory == category ? "active" : "")" @onclick="() => SelectCategory(category)">@category</button>
                            }
                        </div>
                        <div class="ventas-grid">
                            <table class="ventas-table">
                                <thead><tr><th>CÓDIGO</th><th>PRODUCTO</th><th>CANT.</th><th>DESC. %</th><th>P. UNIT.</th><th>IMPORTE</th><th>STOCK</th></tr></thead>
                                <tbody>
                                @foreach (var line in Pos.Cart)
                                {
                                    <tr class="@(Pos.SelectedLine == line ? "selected" : "")" @onclick="() => Pos.SelectLine(line)"><td>@line.Product.Code</td><td><strong>@line.Product.Name</strong>@if (PromotionCatalog.IsPromotion(line.Product)) { <small class="promo-tag">Promoción</small> }</td><td><div class="table-quantity"><button @onclick:stopPropagation="true" @onclick="() => Pos.ChangeQuantity(line, -1)">−</button><span>@line.Quantity</span><button @onclick:stopPropagation="true" @onclick="() => Pos.ChangeQuantity(line, 1)">+</button></div></td><td>@line.DiscountPercentage</td><td>@Pos.FormatCurrency(line.UnitPrice)</td><td>@Pos.FormatCurrency(line.Subtotal)</td><td>@Pos.GetDisplayedCartStock(line).ToString("0.##")</td></tr>
                                    @foreach (var detail in Pos.GetPromotionCartDetails(line))
                                    {
                                        <tr class="promo-component-row" @onclick="() => Pos.SelectLine(line)">
                                            <td class="muted">@detail.Code</td>
                                            <td><small>↳ @detail.Name</small></td>
                                            <td><small>@(detail.QuantityPerPromo.ToString("0.##")) × @line.Quantity</small></td>
                                            <td></td>
                                            <td><small>@Pos.FormatCurrency(detail.Price)</small></td>
                                            <td></td>
                                            <td><small>@detail.Stock.ToString("0.##")</small></td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                            @if (Pos.Cart.Count == 0)
                            {
                                <div class="ventas-empty">
                                    <svg class="empty-pixels empty-pixels--tl" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                                        @* Mosaico pixel top-left (más pequeño) *@
                                        <g fill="#b7c6e0">
                                            <rect x="0" y="0" width="14" height="14" rx="2" opacity="0.55"/>
                                            <rect x="18" y="0" width="14" height="14" rx="2" opacity="0.42"/>
                                            <rect x="36" y="0" width="14" height="14" rx="2" opacity="0.32"/>
                                            <rect x="54" y="0" width="14" height="14" rx="2" opacity="0.22"/>
                                            <rect x="72" y="0" width="14" height="14" rx="2" opacity="0.14"/>
                                            <rect x="0" y="18" width="14" height="14" rx="2" opacity="0.48"/>
                                            <rect x="18" y="18" width="14" height="14" rx="2" opacity="0.36"/>
                                            <rect x="36" y="18" width="14" height="14" rx="2" opacity="0.24"/>
                                            <rect x="54" y="18" width="14" height="14" rx="2" opacity="0.16"/>
                                            <rect x="0" y="36" width="14" height="14" rx="2" opacity="0.38"/>
                                            <rect x="18" y="36" width="14" height="14" rx="2" opacity="0.26"/>
                                            <rect x="36" y="36" width="14" height="14" rx="2" opacity="0.16"/>
                                            <rect x="0" y="54" width="14" height="14" rx="2" opacity="0.26"/>
                                            <rect x="18" y="54" width="14" height="14" rx="2" opacity="0.15"/>
                                            <rect x="0" y="72" width="14" height="14" rx="2" opacity="0.14"/>
                                        </g>
                                    </svg>
                                    <svg class="empty-pixels empty-pixels--br" viewBox="0 0 168 168" aria-hidden="true" focusable="false">
                                        @* Mosaico pixel bottom-right (más grande, espejo) *@
                                        <g fill="#b7c6e0" transform="translate(168,168) scale(-1)">
                                            <rect x="0" y="0" width="16" height="16" rx="2.5" opacity="0.58"/>
                                            <rect x="20" y="0" width="16" height="16" rx="2.5" opacity="0.48"/>
                                            <rect x="40" y="0" width="16" height="16" rx="2.5" opacity="0.38"/>
                                            <rect x="60" y="0" width="16" height="16" rx="2.5" opacity="0.30"/>
                                            <rect x="80" y="0" width="16" height="16" rx="2.5" opacity="0.22"/>
                                            <rect x="100" y="0" width="16" height="16" rx="2.5" opacity="0.15"/>
                                            <rect x="120" y="0" width="16" height="16" rx="2.5" opacity="0.10"/>
                                            <rect x="0" y="20" width="16" height="16" rx="2.5" opacity="0.50"/>
                                            <rect x="20" y="20" width="16" height="16" rx="2.5" opacity="0.40"/>
                                            <rect x="40" y="20" width="16" height="16" rx="2.5" opacity="0.30"/>
                                            <rect x="60" y="20" width="16" height="16" rx="2.5" opacity="0.22"/>
                                            <rect x="80" y="20" width="16" height="16" rx="2.5" opacity="0.15"/>
                                            <rect x="100" y="20" width="16" height="16" rx="2.5" opacity="0.10"/>
                                            <rect x="0" y="40" width="16" height="16" rx="2.5" opacity="0.40"/>
                                            <rect x="20" y="40" width="16" height="16" rx="2.5" opacity="0.30"/>
                                            <rect x="40" y="40" width="16" height="16" rx="2.5" opacity="0.22"/>
                                            <rect x="60" y="40" width="16" height="16" rx="2.5" opacity="0.15"/>
                                            <rect x="80" y="40" width="16" height="16" rx="2.5" opacity="0.10"/>
                                            <rect x="0" y="60" width="16" height="16" rx="2.5" opacity="0.30"/>
                                            <rect x="20" y="60" width="16" height="16" rx="2.5" opacity="0.22"/>
                                            <rect x="40" y="60" width="16" height="16" rx="2.5" opacity="0.15"/>
                                            <rect x="60" y="60" width="16" height="16" rx="2.5" opacity="0.10"/>
                                            <rect x="0" y="80" width="16" height="16" rx="2.5" opacity="0.22"/>
                                            <rect x="20" y="80" width="16" height="16" rx="2.5" opacity="0.14"/>
                                            <rect x="40" y="80" width="16" height="16" rx="2.5" opacity="0.09"/>
                                            <rect x="0" y="100" width="16" height="16" rx="2.5" opacity="0.14"/>
                                            <rect x="20" y="100" width="16" height="16" rx="2.5" opacity="0.09"/>
