<Window x:Class="GrunflexPOS2.Views.CrearUsuarioInicialWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Crear administrador — Grunflex POS"

        MinHeight="520"

        MinWidth="380"

        Height="640"

        Width="460"

        WindowStartupLocation="CenterScreen"

        ResizeMode="CanResizeWithGrip"

        SizeToContent="Manual"

        Background="#0F172A">



    <Grid Margin="16,12">

        <Border Background="White"

                CornerRadius="16"

                Padding="0"

                MaxWidth="420"

                HorizontalAlignment="Center"

                VerticalAlignment="Center">

            <Border.Effect>

                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000"/>

            </Border.Effect>



            <ScrollViewer VerticalScrollBarVisibility="Auto"

                          HorizontalScrollBarVisibility="Disabled"

                          Padding="0">

                <StackPanel Margin="32,28">

                    <TextBlock Text="Primer usuario administrador"

                               FontSize="22"

                               FontWeight="Bold"

                               Foreground="#0F172A"

                               TextWrapping="Wrap"

                               TextAlignment="Center"/>



                    <TextBlock Margin="0,8,0,20"

                               FontSize="13"

                               Foreground="#64748B"

                               TextWrapping="Wrap"

                               TextAlignment="Center"

                               Text="Defina el usuario y contraseña que usará para iniciar sesión en este equipo."/>



                    <TextBlock Text="Nombre para mostrar" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="2,0,0,6"/>

                    <TextBox x:Name="TxtNombre"

                             Style="{StaticResource ModernTextBox}"

                             Margin="0,0,0,12"/>



                    <TextBlock Text="Usuario" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="2,0,0,6"/>

                    <TextBox x:Name="TxtUsuario"

                             Style="{StaticResource ModernTextBox}"

                             Margin="0,0,0,12"/>



                    <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="2,0,0,6"/>

                    <PasswordBox x:Name="TxtPassword"

                                 Style="{StaticResource LoginPasswordBox}"

                                 Margin="0,0,0,12"/>



                    <TextBlock Text="Confirmar contraseña" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="2,0,0,6"/>

                    <PasswordBox x:Name="TxtPasswordConfirm"

                                 Style="{StaticResource LoginPasswordBox}"

                                 Margin="0,0,0,12"/>



                    <TextBlock x:Name="TxtError"

                               Visibility="Collapsed"

                               Margin="0,0,0,10"

                               Foreground="#DC2626"

                               FontSize="12"

                               TextWrapping="Wrap"/>



                    <Button Content="Crear y continuar"

                            Style="{StaticResource GreenButton}"

                            Height="48"

                            Margin="0,4,0,0"

                            Click="BtnCrear_Click"/>



                    <TextBlock Margin="0,14,0,4"

                               FontSize="11"

                               Foreground="#94A3B8"

                               HorizontalAlignment="Center"

                               Text="© Grunflex"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>

