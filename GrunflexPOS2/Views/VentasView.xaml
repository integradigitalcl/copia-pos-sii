<UserControl x:Class="GrunflexPOS2.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="VentasView_OnLoaded"
             SizeChanged="VentasView_SizeChanged"
             IsVisibleChanged="VentasView_OnIsVisibleChanged"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Margin="0,0,0,4" MinHeight="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de acciones -->
        <ScrollViewer Grid.Row="0"
                      Margin="0,0,0,8"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="🔍  F10 Buscar"
                        Style="{StaticResource PosToolbarOutlineButton}"
                        Click="Buscar_Click"/>
                <Button Content="F11 Mayoreo"
                        Style="{StaticResource PosToolbarOutlineButton}"
                        Click="Mayoreo_Click"/>
                <Button Content="F7 Entradas"
                        Style="{StaticResource PosToolbarOutlineButton}"
                        Click="Entradas_Click"/>
                <Button Content="F8 Salidas"
                        Style="{StaticResource PosToolbarOutlineButton}"
                        Click="Salidas_Click"/>
                <Button Content="DEL Borrar"
                        Style="{StaticResource PosToolbarOutlineButton}"
                        Click="BorrarSeleccion_Click"/>
                <Button Content="➕  Enter Agregar"
                        Style="{StaticResource PosToolbarAccentButton}"
                        Click="AgregarActual_Click"/>
                <Button Content="✏  Editar compra"
                        Style="{StaticResource PosToolbarOutlineButton}"
                        Margin="8,0,0,8"
                        Click="ToolbarEditarCompra_Click"/>
                <Button x:Name="BtnToolbarDescuento"
                        Content="🏷  Aplicar descuento"
                        Style="{StaticResource PosToolbarOutlineButton}"
                        Margin="8,0,0,8"
                        Click="ToolbarAplicarDescuento_Click"/>
            </WrapPanel>
        </ScrollViewer>

        <!-- Búsqueda (mockup: etiqueta + campo con icono) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Código o nombre (escanear / Enter)"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="2,0,0,6"/>

            <Border Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Assets/icons/escaner.png"
                           Width="26"
                           Height="26"
                           Margin="12,8,8,8"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <ComboBox x:Name="CodigoComboBox"
                              Grid.Column="1"
                              FontSize="16"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              Focusable="True"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="4,10,32,10"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Tabla + estado vacío -->
        <Border Grid.Row="2"
                CornerRadius="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Background="White"
                ClipToBounds="True"
                MinHeight="220">
            <Grid MinHeight="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="VentasGrid"
                          Grid.Row="0"
                          ColumnHeaderStyle="{StaticResource VentasDataGridColumnHeaderStyle}"
                          AutoGenerateColumns="False"
                          Background="White"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#F8FAFC"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          SelectionUnit="FullRow"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          MinHeight="72"
                          RowHeight="36"
                          ColumnHeaderHeight="36"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          KeyDown="VentasGrid_KeyDown"
                          MouseLeave="VentasGrid_MouseLeave"
                          LoadingRow="VentasGrid_LoadingRow">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding CodigoBarras}"
                                            Width="1.15*"
                                            MinWidth="88"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Producto"
                                            Binding="{Binding Producto}"
                                            Width="2.4*"
                                            MinWidth="100"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cant."
                                            Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                            Width="0.55*"
                                            MinWidth="44"/>
                        <DataGridTextColumn Header="Desc. %"
                                            Binding="{Binding DescuentoPorcentaje, UpdateSourceTrigger=PropertyChanged}"
                                            Width="0.55*"
                                            MinWidth="44"/>
                        <DataGridTextColumn Header="P. unit."
                                            Binding="{Binding Precio, StringFormat=C, UpdateSourceTrigger=PropertyChanged}"
                                            Width="0.95*"
                                            MinWidth="72"/>
                        <DataGridTextColumn Header="Importe"
                                            Binding="{Binding Importe, StringFormat=C}"
                                            Width="0.95*"
                                            MinWidth="76"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding Existencia}"
                                            Width="0.5*"
                                            MinWidth="44"
                                            IsReadOnly="True"/>
                    </DataGrid.Columns>

                </DataGrid>

                <Grid x:Name="GridEstadoVacio"
                      Grid.Row="1"
                      IsHitTestVisible="False">
                    <Image Source="/Assets/ventas_grid_watermark_logo.png"
                           Opacity="0.05"
                           Stretch="Uniform"
                           MaxWidth="360"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <Border x:Name="PanelVacioCarrito"
                            Background="#F8FAFC"
                            CornerRadius="0,0,12,12"
                            IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="24">
                            <Grid Width="160"
                                  Height="160"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,12">
                                <Ellipse x:Name="EllipseDashCarritoVacio"
                                         Width="160"
                                         Height="160"
                                         Stroke="#93C5FD"
                                         StrokeThickness="2"
                                         StrokeDashArray="4 4"
                                         Fill="Transparent"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(Shape.StrokeDashOffset)"
                                                                     From="0"
                                                                     To="16"
                                                                     Duration="0:0:2.4"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="112"
                                         Height="112"
                                         Fill="#E0F2FE"
                                         Opacity="0.85"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="🛒"
                                           FontSize="44"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Aún no hay productos en la venta"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Escanee o agregue productos para comenzar"
                                       FontSize="13"
                                       Foreground="{DynamicResource PrimaryHoverBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="2,8,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   MinHeight="22"
                   Text="{Binding MensajeEstado}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#374151"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                            <Setter Property="Foreground" Value="#DC2626"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Border Background="#F1F5F9"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="4,0">
                <TextBlock Text="ENTER" FontSize="11" Foreground="#64748B"/>
            </Border>
            <TextBlock Text="·" FontSize="11" Foreground="#CBD5E1" Margin="2,0" VerticalAlignment="Center"/>
            <Border Background="#F1F5F9"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="4,0">
                <TextBlock Text="F10" FontSize="11" Foreground="#64748B"/>
            </Border>
            <TextBlock Text="·" FontSize="11" Foreground="#CBD5E1" Margin="2,0" VerticalAlignment="Center"/>
            <Border Background="#F1F5F9"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="4,0">
                <TextBlock Text="DEL" FontSize="11" Foreground="#64748B"/>
            </Border>
            <TextBlock Text="·" FontSize="11" Foreground="#CBD5E1" Margin="2,0" VerticalAlignment="Center"/>
            <Border Background="#F1F5F9"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="4,0">
                <TextBlock Text="F12" FontSize="11" Foreground="#64748B"/>
            </Border>
        </StackPanel>

    </Grid>
</UserControl>
