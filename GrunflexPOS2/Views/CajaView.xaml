<Window x:Class="GrunflexPOS2.Views.CajaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- ================= BARRA SUPERIOR ================= -->
        <Border Grid.Row="0"
                Background="White"
                MouseLeftButtonDown="BarraSuperior_MouseLeftButtonDown">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- TÍTULO -->
                <TextBlock Text="GRUNFLEX POS"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="25,0"/>

                <!-- 🔥 NUEVA ZONA DE ESTADO PROFESIONAL -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0">

                    <!-- BADGE CAJA -->
                    <Border x:Name="BadgeCaja"
                            Background="#16A34A"
                            CornerRadius="20"
                            Padding="12,6"
                            Margin="0,0,10,0">

                        <TextBlock x:Name="IndicadorCajaText"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- BADGE RED -->
                    <Border x:Name="BadgeRed"
                            Background="#16A34A"
                            CornerRadius="20"
                            Padding="10,6"
                            Margin="0,0,10,0">

                        <TextBlock x:Name="EstadoRedText"
                                   Text="Red OK"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- BOTÓN CERRAR CAJA -->
                    <Button x:Name="BtnCerrarCaja"
                            Content="Cerrar Caja"
                            Padding="14,6"
                            FontSize="12"
                            Background="#DC2626"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCerrarCaja_Click"/>
                </StackPanel>

                <!-- BOTONES SISTEMA -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="—" Width="50" Height="80"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Minimizar_Click"/>

                    <Button Content="▢" Width="50" Height="80"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Maximizar_Click"/>

                    <Button Content="X" Width="50" Height="80"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Cerrar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= CONTENIDO ================= -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO -->
            <Border Grid.Column="0" Background="White">
                <StackPanel Margin="0,30,0,0">

                    <Button Content="F1 - Ventas"
                            Style="{StaticResource ModernButton}"
                            Click="Ventas_Click"/>

                    <Button Content="F3 - Productos"
                            Style="{StaticResource ModernButton}"
                            Click="Productos_Click"/>

                    <Button Content="F4 - Inventario"
                            Style="{StaticResource ModernButton}"
                            Click="Inventario_Click"/>

                    <Button Content="Reportes"
                            Style="{StaticResource ModernButton}"
                            Click="Reportes_Click"/>

                    <Button Content="Corte"
                            Style="{StaticResource ModernButton}"
                            Click="Corte_Click"/>

                    <Button Content="Web"
                            Style="{StaticResource GreenButton}"
                            Click="Web_Click"/>

                    <Button Content="Compras y Facturas"
                            Style="{StaticResource ModernButton}"
                            Click="Compras_Click"/>

                    <Button Content="Configuración"
                            Style="{StaticResource ModernButton}"
                            Click="Configuracion_Click"/>

                </StackPanel>
            </Border>

            <!-- AREA CENTRAL -->
            <ContentControl x:Name="MainContent"
                            Grid.Column="1"
                            Margin="30"/>

            <!-- PANEL DERECHO (INTACTO) -->
            <Border Grid.Column="2"
                    Background="White"
                    Margin="1,0,0,0">

                <Grid Margin="40">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BOTONES SUPERIORES -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Editar compra"
                                Height="40"
                                Margin="0,0,5,0"
                                Style="{StaticResource ModernButton}"/>

                        <Button Grid.Column="1"
                                Content="Aplicar descuento"
                                Height="40"
                                Margin="5,0,0,0"
                                Style="{StaticResource ModernButton}"/>
                    </Grid>

                    <!-- CUADRO RESUMEN -->
                    <Border Grid.Row="1"
                            Background="#F3F4F6"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,25">

                        <StackPanel>

                            <TextBlock Text="Resumen de la compra"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Artículos:"/>
                                <TextBlock x:Name="ResumenArticulos"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Text="0"/>
                            </Grid>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal:"/>
                                <TextBlock x:Name="ResumenSubtotal"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Text="$ 0"/>
                            </Grid>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Descuento:"/>
                                <TextBlock x:Name="ResumenDescuento"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Text="$ 0"/>
                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- TOTAL Y BOTONES -->
                    <StackPanel Grid.Row="2">

                        <TextBlock Text="TOTAL"
                                   FontSize="18"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="TotalText"
                                   Text="$ 0"
                                   FontSize="44"
                                   FontWeight="Bold"
                                   Margin="0,0,0,25"/>

                        <Button Content="F12 - COBRAR"
                                Height="65"
                                FontSize="20"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,0,15"
                                Click="Cobrar_Click"/>

                        <Button Content="Reimprimir Último Ticket"
                                Height="45"
                                Style="{StaticResource ModernButton}"
                                Margin="0,5"
                                Click="ReimprimirUltimo_Click"/>

                        <Button Content="Ventas del día y Devoluciones"
                                Height="45"
                                Style="{StaticResource ModernButton}"
                                Margin="0,5"
                                Click="VentasDelDia_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>
</Window>