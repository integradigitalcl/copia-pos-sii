<Window x:Class="GrunflexPOS2.Views.CajaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GrunflexPOS2.Views"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="CajaView_SizeChanged">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Alertas (licencia / respaldo) -->
        <Border x:Name="BorderAlertaCaja"
                Grid.Row="0"
                Background="#FEF3C7"
                BorderBrush="#F59E0B"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="Collapsed">
            <TextBlock x:Name="TxtAlertaCaja"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#92400E"/>
        </Border>

        <!-- Barra superior: en pantallas pequeñas (<1280px) los chips de usuario, saldo,
             red y los botones de ventana suelen quedar fuera. Envolvemos en un
             ScrollViewer horizontal para que sea siempre alcanzable con un swipe/click. -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                MouseLeftButtonDown="BarraSuperior_MouseLeftButtonDown">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <Grid MinHeight="52" MinWidth="680">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Estado caja (izquierda) -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="🛍"
                               FontSize="22"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>

                    <Ellipse x:Name="DotHeaderCaja"
                             Width="10"
                             Height="10"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource GreenBrush}"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderNumeroCaja"
                                   Text="Caja 1"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtHeaderEstadoCaja"
                                       Text="Abierta"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GreenBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Reloj, saldo, red, cerrar -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Background="{StaticResource HeaderUserPillBrush}"
                            CornerRadius="22"
                            Padding="8,8,18,8"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="#1E293B"
                                    VerticalAlignment="Center">
                                <TextBlock Text="👤"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HoraActualText"
                                           Text="00:00"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock x:Name="TxtCajero"
                                           Text="admin"
                                           FontSize="12"
                                           Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="DineroCajaText"
                                   Text="$0"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!--  Badge multicaja: indica visualmente el rol y destino real.
                          En la principal queda "🔗 Hosting N caja(s)" (verde).
                          En adicionales queda "🔗 192.168.1.16" (verde si conecta, rojo si no).
                          Sirve para que el operador SEPA desde dónde sale la conexión sin
                          tener que abrir Diagnóstico ni el archivo de config. -->
                    <Border x:Name="BadgeMulticaja"
                            Background="#DCFCE7"
                            CornerRadius="12"
                            Padding="14,10"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            BorderBrush="#86EFAC"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtBadgeMulticaja"
                                   Text="🔗 ..."
                                   Foreground="#166534"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="BadgeRed"
                            Background="#F3F4F6"
                            CornerRadius="12"
                            Padding="14,10"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtBadgeWifi"
                                       Text="📶"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource GreenBrush}"/>
                            <TextBlock x:Name="EstadoRedText"
                                       Text="Red OK"
                                       Foreground="#065F46"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnActualizarDatos"
                            Content="↻ Actualizar"
                            Padding="12,8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="BtnActualizarDatos_Click"
                            ToolTip="Caja adicional: sincroniza cajeros y catálogo desde el servidor. También refresca listas abiertas (ventas/productos/inventario)."/>

                    <Button x:Name="BtnCerrarCaja"
                            Content="🚪  Cerrar Caja"
                            Height="44"
                            MinWidth="120"
                            Padding="18,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="#EF4444"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="BtnCerrarCaja_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="12"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnAbrirCaja"
                            Content="Abrir Caja"
                            Height="44"
                            MinWidth="120"
                            Padding="18,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="#16A34A"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            Click="BtnAbrirCaja_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="12"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Controles ventana -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="—"
                            Width="46"
                            Height="44"
                            Background="Transparent"
                            Foreground="#6B7280"
                            BorderThickness="0"
                            Click="Minimizar_Click"/>
                    <Button Content="▢"
                            Width="46"
                            Height="44"
                            Background="Transparent"
                            Foreground="#6B7280"
                            BorderThickness="0"
                            Click="Maximizar_Click"/>
                    <Button Content="✕"
                            Width="46"
                            Height="44"
                            Background="Transparent"
                            Foreground="#6B7280"
                            BorderThickness="0"
                            Click="Cerrar_Click"/>
                </StackPanel>

            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Contenido principal: proporciones fluidas según ancho de pantalla -->
        <Grid x:Name="GridColumnasPrincipal" Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*" MinWidth="220" MaxWidth="320"/>
                <ColumnDefinition Width="53*" MinWidth="220"/>
                <ColumnDefinition Width="30*" MinWidth="200" MaxWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar navy -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarNavyBrush}"
                    BorderBrush="#1E293B"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,22,18,20">

                        <StackPanel Margin="0,0,0,20">
                            <Border Background="#FFFFFF"
                                    CornerRadius="10"
                                    Padding="10,12"
                                    Margin="0,0,0,10">
                                <Image x:Name="ImgLogoTop"
                                       Source="/Assets/logo_login.png"
                                       Stretch="Uniform"
                                       MaxHeight="112"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock x:Name="TxtTituloTop"
                                       Text="Point of Sales"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <Button x:Name="BtnNavVentas"
                                Style="{StaticResource SidebarNavGlassButton}"
                                Click="Ventas_Click">
                            <Border x:Name="BdNavVentasShell"
                                    Style="{StaticResource SidebarNavGlassShell}"
                                    Background="#101828"
                                    BorderBrush="#243047">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BdNavVentasIcon"
                                            Grid.Column="0"
                                            Style="{StaticResource SidebarNavGlassIcon}"
                                            Background="#172554"
                                            BorderBrush="#2563EB">
                                        <TextBlock x:Name="TbNavVentasIcon"
                                                   Style="{StaticResource SidebarNavGlassIconGlyph}"
                                                   Text="&#xE7BF;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Style="{StaticResource SidebarNavGlassText}">
                                        <TextBlock x:Name="TbNavVentasShortcut"
                                                   Style="{StaticResource SidebarNavGlassShortcut}"
                                                   Text="F1"
                                                   Foreground="#60A5FA"/>
                                        <TextBlock x:Name="TbNavVentasLabel"
                                                   Style="{StaticResource SidebarNavGlassLabel}"
                                                   Text="Ventas"
                                                   Foreground="White"/>
                                        <TextBlock x:Name="TbNavVentasDesc"
                                                   Style="{StaticResource SidebarNavGlassDesc}"
                                                   Text="Gesti&#243;n de ventas y pedidos"/>
                                    </StackPanel>
                                    <Border x:Name="BdNavVentasChevron"
                                            Grid.Column="2"
                                            Style="{StaticResource SidebarNavGlassChevron}"
                                            Background="#1E3A8A">
                                        <TextBlock Style="{StaticResource SidebarNavGlassChevronGlyph}"
                                                   Text="&#xE76C;"
                                                   Foreground="#93C5FD"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <Button x:Name="BtnNavProductos"
                                Style="{StaticResource SidebarNavGlassButton}"
                                Click="Productos_Click">
                            <Border x:Name="BdNavProductosShell"
                                    Style="{StaticResource SidebarNavGlassShell}"
                                    Background="#101828"
                                    BorderBrush="#243047">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BdNavProductosIcon"
                                            Grid.Column="0"
                                            Style="{StaticResource SidebarNavGlassIcon}"
                                            Background="#052E1B"
                                            BorderBrush="#059669">
                                        <TextBlock x:Name="TbNavProductosIcon"
                                                   Style="{StaticResource SidebarNavGlassIconGlyph}"
                                                   Text="&#xE7C3;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Style="{StaticResource SidebarNavGlassText}">
                                        <TextBlock x:Name="TbNavProductosShortcut"
                                                   Style="{StaticResource SidebarNavGlassShortcut}"
                                                   Text="F3"
                                                   Foreground="#34D399"/>
                                        <TextBlock x:Name="TbNavProductosLabel"
                                                   Style="{StaticResource SidebarNavGlassLabel}"
                                                   Text="Productos"
                                                   Foreground="#E2E8F0"/>
                                        <TextBlock x:Name="TbNavProductosDesc"
                                                   Style="{StaticResource SidebarNavGlassDesc}"
                                                   Text="Cat&#225;logo y gesti&#243;n de productos"/>
                                    </StackPanel>
                                    <Border x:Name="BdNavProductosChevron"
                                            Grid.Column="2"
                                            Style="{StaticResource SidebarNavGlassChevron}"
                                            Background="#064E3B">
                                        <TextBlock Style="{StaticResource SidebarNavGlassChevronGlyph}"
                                                   Text="&#xE76C;"
                                                   Foreground="#6EE7B7"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <Button x:Name="BtnNavInventario"
                                Style="{StaticResource SidebarNavGlassButton}"
                                Click="Inventario_Click">
                            <Border x:Name="BdNavInventarioShell"
                                    Style="{StaticResource SidebarNavGlassShell}"
                                    Background="#101828"
                                    BorderBrush="#243047">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BdNavInventarioIcon"
                                            Grid.Column="0"
                                            Style="{StaticResource SidebarNavGlassIcon}"
                                            Background="#451A03"
                                            BorderBrush="#D97706">
                                        <TextBlock x:Name="TbNavInventarioIcon"
                                                   Style="{StaticResource SidebarNavGlassIconGlyph}"
                                                   Text="&#xE8CB;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Style="{StaticResource SidebarNavGlassText}">
                                        <TextBlock x:Name="TbNavInventarioShortcut"
                                                   Style="{StaticResource SidebarNavGlassShortcut}"
                                                   Text="F4"
                                                   Foreground="#FBBF24"/>
                                        <TextBlock x:Name="TbNavInventarioLabel"
                                                   Style="{StaticResource SidebarNavGlassLabel}"
                                                   Text="Inventario"
                                                   Foreground="#E2E8F0"/>
                                        <TextBlock x:Name="TbNavInventarioDesc"
                                                   Style="{StaticResource SidebarNavGlassDesc}"
                                                   Text="Control de stock y almacenes"/>
                                    </StackPanel>
                                    <Border x:Name="BdNavInventarioChevron"
                                            Grid.Column="2"
                                            Style="{StaticResource SidebarNavGlassChevron}"
                                            Background="#78350F">
                                        <TextBlock Style="{StaticResource SidebarNavGlassChevronGlyph}"
                                                   Text="&#xE76C;"
                                                   Foreground="#FCD34D"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <Button x:Name="BtnNavReportes"
                                Style="{StaticResource SidebarNavGlassButton}"
                                Click="Dashboard_Click">
                            <Border x:Name="BdNavReportesShell"
                                    Style="{StaticResource SidebarNavGlassShell}"
                                    Background="#101828"
                                    BorderBrush="#243047">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BdNavReportesIcon"
                                            Grid.Column="0"
                                            Style="{StaticResource SidebarNavGlassIcon}"
                                            Background="#1E1B4B"
                                            BorderBrush="#6366F1">
                                        <TextBlock x:Name="TbNavReportesIcon"
                                                   Style="{StaticResource SidebarNavGlassIconGlyph}"
                                                   Text="&#xE9D9;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Style="{StaticResource SidebarNavGlassText}">
                                        <TextBlock x:Name="TbNavReportesShortcut"
                                                   Style="{StaticResource SidebarNavGlassShortcut}"
                                                   Text=""
                                                   Foreground="#A5B4FC"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="TbNavReportesLabel"
                                                   Style="{StaticResource SidebarNavGlassLabel}"
                                                   Text="Reportes"
                                                   Foreground="#E2E8F0"/>
                                        <TextBlock x:Name="TbNavReportesDesc"
                                                   Style="{StaticResource SidebarNavGlassDesc}"
                                                   Text="An&#225;lisis y reportes"/>
                                    </StackPanel>
                                    <Border x:Name="BdNavReportesChevron"
                                            Grid.Column="2"
                                            Style="{StaticResource SidebarNavGlassChevron}"
                                            Background="#312E81">
                                        <TextBlock Style="{StaticResource SidebarNavGlassChevronGlyph}"
                                                   Text="&#xE76C;"
                                                   Foreground="#C7D2FE"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <Button x:Name="BtnNavCorte"
                                Style="{StaticResource SidebarNavGlassButton}"
                                Click="Corte_Click">
                            <Border x:Name="BdNavCorteShell"
                                    Style="{StaticResource SidebarNavGlassShell}"
                                    Background="#101828"
                                    BorderBrush="#243047">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BdNavCorteIcon"
                                            Grid.Column="0"
                                            Style="{StaticResource SidebarNavGlassIcon}"
                                            Background="#500724"
                                            BorderBrush="#DB2777">
                                        <TextBlock x:Name="TbNavCorteIcon"
                                                   Style="{StaticResource SidebarNavGlassIconGlyph}"
                                                   Text="&#xE8A6;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Style="{StaticResource SidebarNavGlassText}">
                                        <TextBlock x:Name="TbNavCorteShortcut"
                                                   Style="{StaticResource SidebarNavGlassShortcut}"
                                                   Text=""
                                                   Foreground="#F9A8D4"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="TbNavCorteLabel"
                                                   Style="{StaticResource SidebarNavGlassLabel}"
                                                   Text="Corte"
                                                   Foreground="#E2E8F0"/>
                                        <TextBlock x:Name="TbNavCorteDesc"
                                                   Style="{StaticResource SidebarNavGlassDesc}"
                                                   Text="&#211;rdenes de corte y producci&#243;n"/>
                                    </StackPanel>
                                    <Border x:Name="BdNavCorteChevron"
                                            Grid.Column="2"
                                            Style="{StaticResource SidebarNavGlassChevron}"
                                            Background="#831843">
                                        <TextBlock Style="{StaticResource SidebarNavGlassChevronGlyph}"
                                                   Text="&#xE76C;"
                                                   Foreground="#FBCFE8"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <Separator Margin="0,8,0,8" Background="#334155"/>

                        <Button x:Name="BtnNavWeb"
                                Style="{StaticResource PremiumSidebarCard}"
                                Click="Web_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource PremiumSidebarIconBox}"
                                        Margin="0,0,12,0">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE774;"
                                               FontSize="20"
                                               Foreground="#C4B5FD"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Web"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="#F8FAFC"
                                                   VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource PremiumSidebarBadge}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x1F451;"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="PREMIUM"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="WebPremiumText"
                                               Text="Requiere licencia"
                                               FontSize="11"
                                               Foreground="#C4B5FD"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE76C;"
                                           FontSize="14"
                                           Foreground="#A78BFA"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnNavSoporte"
                                Style="{StaticResource PremiumSidebarCard}"
                                Click="Soporte_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource PremiumSidebarIconBox}"
                                        Margin="0,0,12,0">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE717;"
                                               FontSize="20"
                                               Foreground="#C4B5FD"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Soporte en l&#237;nea"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="#F8FAFC"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource PremiumSidebarBadge}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x1F451;"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="PREMIUM"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="SoportePremiumText"
                                               Text="Requiere licencia"
                                               FontSize="11"
                                               Foreground="#C4B5FD"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE76C;"
                                           FontSize="14"
                                           Foreground="#A78BFA"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnNavConfig"
                                Style="{StaticResource SidebarNavGlassButton}"
                                Margin="0,4,0,0"
                                Click="Configuracion_Click">
                            <Border x:Name="BdNavConfigShell"
                                    CornerRadius="14"
                                    BorderThickness="1"
                                    Padding="10"
                                    Background="#101828"
                                    BorderBrush="#243047">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BdNavConfigIcon"
                                            Grid.Column="0"
                                            Width="46"
                                            Height="46"
                                            CornerRadius="13"
                                            Background="#1E293B"
                                            BorderBrush="#64748B"
                                            BorderThickness="1">
                                        <TextBlock x:Name="TbNavConfigIcon"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE713;"
                                                   FontSize="20"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TbNavConfigShortcut"
                                                   Text="F10"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TbNavConfigLabel"
                                                   Text="Configuraci&#243;n"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#E2E8F0"/>
                                        <TextBlock x:Name="TbNavConfigDesc"
                                                   Text="Ajustes del sistema"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="BdNavConfigChevron"
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            Background="#334155"
                                            VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE76C;"
                                                   FontSize="12"
                                                   Foreground="#CBD5E1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <views:YouTubeSidebarWidget x:Name="YouTubeWidget"
                                                      OpenFullScreenRequested="YouTubeWidget_OpenFullScreenRequested"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Área central -->
            <ContentControl x:Name="MainContent"
                            Grid.Column="1"
                            Margin="16,16,16,16"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

            <!-- Panel cobro -->
            <Border x:Name="PanelCobro"
                    Grid.Column="2"
                    Background="{StaticResource BackgroundBrush}"
                    Padding="14,16,14,12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tarjeta: resumen + total -->
                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,18"
                            Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Direction="270"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="Resumen de la compra"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,16"/>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Artículos"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="ResumenArticulos"
                                           Grid.Column="1"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="ResumenSubtotal"
                                           Grid.Column="1"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Descuento"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="ResumenDescuento"
                                           Grid.Column="1"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,16,0,14" Background="#F3F4F6"/>

                            <TextBlock Text="Total a pagar"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TotalText"
                                       Text="$ 0"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta: detalle líneas -->
                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,14"
                            Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Detalle de productos"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="240">
                                <StackPanel x:Name="ResumenDetallePanel"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="BtnCobrar"
                                Content="🧾  F12 — COBRAR"
                                Height="56"
                                FontSize="17"
                                FontWeight="Bold"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,0,10"
                                Click="Cobrar_Click"/>

                        <Button Content="Reimprimir último ticket"
                                Height="44"
                                Style="{StaticResource PosToolbarOutlineButton}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                Click="ReimprimirUltimo_Click"/>

                        <Button x:Name="BtnVentasDelDia"
                                Content="Ventas del día y devoluciones"
                                Height="44"
                                Style="{StaticResource PosToolbarOutlineButton}"
                                HorizontalAlignment="Stretch"
                                Click="VentasDelDia_Click"/>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>
