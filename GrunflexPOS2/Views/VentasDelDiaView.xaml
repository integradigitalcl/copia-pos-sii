<Window x:Class="GrunflexPOS2.Views.VentasDelDiaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Ventas"
        Height="760"
        Width="1280"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E5E7EB"/>

        <!-- Lista tickets: fila seleccionada azul -->
        <Style x:Key="TicketListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBd"
                                Background="White"
                                BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10">
                            <Grid>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="RowBd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TicketListBox" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource TicketListBoxItem}"/>
        </Style>

        <Style x:Key="BtnGreen" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnCloseRed" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnOutlineSm" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.32*" MinWidth="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Izquierda: buscar + lista -->
            <Border Grid.Column="0"
                    Background="Transparent">
                <StackPanel>
                    <!-- Cabecera azul -->
                    <Border CornerRadius="12"
                            Padding="16,14"
                            Margin="0,0,0,12"
                            Background="{DynamicResource PrimaryGradientBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE8FD;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="22"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HISTORIAL DE VENTAS"
                                               FontSize="14"
                               FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="Busca por folio o nombre del ticket"
                                               FontSize="11"
                                               Foreground="#BFDBFE"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="White"
                                    CornerRadius="8"
                                    Padding="10,8">
                                <Grid>
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,8,0"/>
                    <TextBox x:Name="TxtBuscar"
                                             Margin="26,0,0,0"
                                             BorderThickness="0"
                                             VerticalContentAlignment="Center"
                             GotFocus="TxtBuscar_GotFocus"
                             LostFocus="TxtBuscar_LostFocus"
                             TextChanged="TxtBuscar_TextChanged"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,10,10,8">
                        <StackPanel>
                            <!-- Cabecera columnas -->
                            <Grid Margin="10,4,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Folio" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="Arts." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Hora" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Grid.Column="3" Text="Total" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                            </Grid>

                            <ListBox x:Name="ListaVentas"
                                     Style="{StaticResource TicketListBox}"
                                     MaxHeight="440"
                                     SelectionChanged="ListaVentas_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="#A7F3D0"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding NumeroTicket}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TotalArticulos}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="#E0E7FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Hora}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="#E0E7FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Total, StringFormat=C}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="4"
                                                       Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,4">
                                <Button x:Name="BtnListaPrev"
                                        Width="32"
                                        Height="30"
                                        Padding="0"
                                        Content="&#xE76B;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Click="BtnListaPrev_Click"
                                        Style="{StaticResource BtnOutlineSm}"/>
                                <TextBlock x:Name="TxtListaPagina"
                                           Margin="12,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"/>
                                <Button x:Name="BtnListaSig"
                                        Width="32"
                                        Height="30"
                                        Padding="0"
                                        Content="&#xE76C;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Margin="12,0,0,0"
                                        Click="BtnListaSig_Click"
                                        Style="{StaticResource BtnOutlineSm}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Derecha: detalle -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                        <!-- Cabecera gradiente -->
                        <Border CornerRadius="12,12,0,0"
                                Padding="18,16"
                                Background="{DynamicResource BrandHeaderGradientBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtTituloTicket"
                                               Text="TICKET N° —"
                                               FontSize="22"
                               FontWeight="Bold"
                                               Foreground="White"
                                               TextWrapping="Wrap"/>
                                    <UniformGrid Columns="2" Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,10">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="#E0E7FF" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtInfoFolio" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,10">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#E0E7FF" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtInfoCajero" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,10">
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="#E0E7FF" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtInfoCliente" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,10">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#E0E7FF" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtInfoFecha" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="100"
                                        Height="88"
                                        CornerRadius="10"
                                        Background="#33FFFFFF"
                                        VerticalAlignment="Top"
                                        Margin="8,0,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="&#xE719;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="36"
                                                   Foreground="#C7D2FE"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Venta"
                                                   FontSize="10"
                                                   Foreground="#C7D2FE"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Margin="16,16,16,12">
                            <TextBlock Text="Artículos"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,10"/>

                            <ListBox x:Name="ListaDetalle"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Padding="{TemplateBinding Padding}"
                                                            Background="Transparent">
                                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F9FAFB"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32"
                                                    Height="32"
                                                    CornerRadius="16"
                                                    Background="#EFF6FF"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Cantidad}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                            </Border>
                                            <Border Grid.Column="1"
                                                    Width="40"
                                                    Height="40"
                                                    CornerRadius="6"
                                                    Background="#F3F4F6"
                                                    Margin="10,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="&#xE74C;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="18"
                                                           Foreground="#9CA3AF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Producto}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Importe, StringFormat=C}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Background="#EFF6FF"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,12,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtResumenArticulos"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="TOTAL"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtTotalVenta"
                                                   FontSize="22"
                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtMetodoPago"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,12,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Left">
                                <Button x:Name="BtnDevolverArticulo"
                                        Style="{StaticResource BtnGreen}"
                                        Click="DevolverArticulo_Click">
                        <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                    Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Devolver artículo seleccionado" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Imprimir copia"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource BtnOutlineSm}"
                                        Click="ImprimirCopia_Click"/>
                                <Button x:Name="BtnCancelarVenta"
                                        Content="Cancelar venta"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource BtnOutlineSm}"
                                    Click="CancelarVenta_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Pie filtros -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,14,0,0"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Del día:"
                           VerticalAlignment="Center"
                               Margin="0,0,8,8"
                               Foreground="{StaticResource TextSecondary}"/>
                <DatePicker x:Name="DpFecha"
                                Width="170"
                                Margin="0,0,18,8"
                            SelectedDateChanged="Filtro_Changed"/>
                <TextBlock Text="Caja:"
                           VerticalAlignment="Center"
                               Margin="0,0,8,8"
                               Foreground="{StaticResource TextSecondary}"/>
                <ComboBox x:Name="CmbCaja"
                              Width="140"
                              Margin="0,0,18,8"
                          SelectionChanged="Filtro_Changed"/>
                <TextBlock Text="Cajero:"
                           VerticalAlignment="Center"
                               Margin="0,0,8,8"
                               Foreground="{StaticResource TextSecondary}"/>
                <ComboBox x:Name="CmbCajero"
                              Width="160"
                              Margin="0,0,18,8"
                          SelectionChanged="Filtro_Changed"/>
                <CheckBox x:Name="ChkVentasCredito"
                          Content="Ventas a crédito"
                          VerticalAlignment="Center"
                              Margin="0,0,18,8"
                          Checked="Filtro_Changed"
                          Unchecked="Filtro_Changed"/>
                </WrapPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Style="{StaticResource BtnCloseRed}"
                        Click="Cerrar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Cerrar ventana" VerticalAlignment="Center"/>
            </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
