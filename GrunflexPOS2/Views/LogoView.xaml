<UserControl x:Class="GrunflexPOS2.Views.LogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="MiniTopButton" TargetType="Button" BasedOn="{StaticResource TopFlatButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">

        <StackPanel>

            <!-- 🔵 BARRA -->
            <Border Background="{StaticResource PrimaryGradientBrush}"
                    Height="40"
                    CornerRadius="3">

                <TextBlock Text="CONFIGURACIÓN"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="10,0"/>
            </Border>

            <!-- BOTÓN -->
            <Button Content="🏠 Mostrar todas las opciones"
                    Margin="0,10,0,20"
                    Width="220"
                    Style="{StaticResource MiniTopButton}"/>

            <!-- TÍTULO -->
            <TextBlock Text="LOGOTIPO DEL PROGRAMA"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,0,10"/>

            <!-- DESCRIPCIÓN -->
            <TextBlock Text="Puedes cambiar el logotipo del sistema Grunflex POS (visible en la barra superior) seleccionando una imagen:"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- INPUT -->
            <TextBlock Text="Imagen de Logotipo"
                       Margin="0,0,0,5"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <!-- TEXTBOX -->
                <TextBox x:Name="TxtRuta"
                         Height="25"
                         VerticalAlignment="Center"
                         IsReadOnly="True"/>

                <!-- BOTÓN EXPLORAR -->
                <Button Grid.Column="1"
                        Content="📁"
                        Margin="5,0,0,0"
                        Click="BtnBuscar_Click"/>
            </Grid>

            <Border Margin="0,12,0,0"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    Background="White"
                    Padding="10"
                    Width="380"
                    Height="90"
                    CornerRadius="8">
                <Image x:Name="ImgPreview"
                       Width="Auto"
                       Height="Auto"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Guardar logotipo"
                        Width="160"
                        Margin="0,0,8,0"
                        Click="BtnGuardar_Click"
                        Style="{StaticResource MiniTopButton}"/>
                <Button Content="Quitar logotipo"
                        Width="150"
                        Click="BtnQuitar_Click"
                        Style="{StaticResource MiniTopButton}"/>
            </StackPanel>

            <!-- NOTA -->
            <TextBlock Text="(De 300 a 600 píxeles de ancho por 63 píxeles de alto)"
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0,10,0,0"/>

        </StackPanel>

    </Grid>
</UserControl>