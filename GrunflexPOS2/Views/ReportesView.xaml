<UserControl x:Class="GrunflexPOS2.Views.ReportesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4F6F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="320"/>
            <!-- 🔥 antes 260 -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- TITULO -->
        <TextBlock Text="Resumen de Ventas"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="20"
                   VerticalAlignment="Center"/>

        <!-- MÉTRICAS -->
        <Grid Grid.Row="1" Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="8" Margin="10">
                <StackPanel Margin="15">
                    <TextBlock Text="Ventas Hoy"/>
                    <TextBlock x:Name="VentasHoyText" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Margin="10" Grid.Column="1">
                <StackPanel Margin="15">
                    <TextBlock Text="Cantidad Ventas"/>
                    <TextBlock x:Name="CantidadVentasText" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Margin="10" Grid.Column="2">
                <StackPanel Margin="15">
                    <TextBlock Text="Ventas Totales"/>
                    <TextBlock x:Name="VentasTotalesText" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Margin="10" Grid.Column="3">
                <StackPanel Margin="15">
                    <TextBlock Text="Promedio Venta"/>
                    <TextBlock x:Name="PromedioVentaText" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- GRÁFICO -->
        <Border Grid.Row="2"
                Margin="20"
                Background="White"
                CornerRadius="8"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Ventas últimos 7 días"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <!-- 🔥 Canvas más alto -->
                <Canvas x:Name="GraficoVentas" Height="240"/>

            </StackPanel>

        </Border>

        <!-- TABLAS DE REPORTES -->
        <Grid Grid.Row="3" Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Métodos de pago -->
            <GroupBox Header="Ventas por método de pago" Margin="10">
                <DataGrid x:Name="GridMetodosPago"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"/>
            </GroupBox>

            <!-- Cajas -->
            <GroupBox Header="Ventas por caja" Grid.Column="2" Margin="10">
                <DataGrid x:Name="GridCajas"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"/>
            </GroupBox>

        </Grid>

        <!-- BOTÓN IMPRIMIR -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20">

            <Button Content="Imprimir Reporte"
                    Width="180"
                    Height="40"
                    Click="ImprimirReporte_Click"/>

        </StackPanel>

    </Grid>

</UserControl>