<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="GrunflexPOS2.Views.ProductosView"
             Background="#F9FAFB"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="ProductosView_OnLoaded"
             SizeChanged="ProductosView_SizeChanged"
             d:DesignWidth="920">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ProdBorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ProdHintBrush" Color="#9CA3AF"/>

        <Style x:Key="ProdTabInactiveStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProdTabActiveStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProdFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="ProdTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="{StaticResource ProdBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProdPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pb"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pb" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProdGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="0"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="280" MaxWidth="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: pestañas + formulario -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="20,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.06" Direction="270"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Pestañas -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button x:Name="BtnTabNuevo"
                                    Content="Nuevo"
                                    Style="{StaticResource ProdTabActiveStyle}"
                                    Tag="0"
                                    Click="TabProducto_Click"/>
                            <Button x:Name="BtnTabModificar"
                                    Content="Modificar"
                                    Style="{StaticResource ProdTabInactiveStyle}"
                                    Tag="1"
                                    Click="TabProducto_Click"/>
                            <Button x:Name="BtnTabEliminar"
                                    Content="Eliminar"
                                    Style="{StaticResource ProdTabInactiveStyle}"
                                    Tag="2"
                                    Click="TabProducto_Click"/>
                        </StackPanel>

                        <!-- Título -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="NUEVO PRODUCTO"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8B7;"
                                       FontSize="20"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>

                        <!-- Código -->
                        <TextBlock Text="Código" Style="{StaticResource ProdFieldLabelStyle}"/>
                        <Grid Margin="0,0,0,14">
                            <TextBox x:Name="TxtCodigo"
                                     Style="{StaticResource ProdTextBoxStyle}"
                                     TextChanged="CampoProducto_TextChanged"/>
                            <TextBlock x:Name="HintCodigo"
                                       Text="Ingresa el código del producto"
                                       Foreground="{StaticResource ProdHintBrush}"
                                       FontSize="14"
                                       IsHitTestVisible="False"
                                       Margin="14,0,12,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Descripción -->
                        <TextBlock Text="Descripción" Style="{StaticResource ProdFieldLabelStyle}"/>
                        <Grid Margin="0,0,0,14">
                            <TextBox x:Name="TxtDescripcion"
                                     Style="{StaticResource ProdTextBoxStyle}"
                                     TextChanged="CampoProducto_TextChanged"/>
                            <TextBlock x:Name="HintDescripcion"
                                       Text="Nombre o descripción del producto"
                                       Foreground="{StaticResource ProdHintBrush}"
                                       FontSize="14"
                                       IsHitTestVisible="False"
                                       Margin="14,0,12,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Costo -->
                        <TextBlock Text="Costo" Style="{StaticResource ProdFieldLabelStyle}"/>
                        <Grid Margin="0,0,0,14">
                            <TextBox x:Name="TxtCosto"
                                     Style="{StaticResource ProdTextBoxStyle}"
                                     TextChanged="CampoProducto_TextChanged"/>
                            <TextBlock x:Name="HintCosto"
                                       Text="Costo de compra"
                                       Foreground="{StaticResource ProdHintBrush}"
                                       FontSize="14"
                                       IsHitTestVisible="False"
                                       Margin="14,0,12,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Venta -->
                        <TextBlock Text="Venta" Style="{StaticResource ProdFieldLabelStyle}"/>
                        <Grid Margin="0,0,0,14">
                            <TextBox x:Name="TxtVenta"
                                     Style="{StaticResource ProdTextBoxStyle}"
                                     TextChanged="CampoProducto_TextChanged"/>
                            <TextBlock x:Name="HintVenta"
                                       Text="Precio de venta"
                                       Foreground="{StaticResource ProdHintBrush}"
                                       FontSize="14"
                                       IsHitTestVisible="False"
                                       Margin="14,0,12,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Stock -->
                        <TextBlock Text="Stock" Style="{StaticResource ProdFieldLabelStyle}"/>
                        <Grid Margin="0,0,0,20">
                            <TextBox x:Name="TxtStock"
                                     Style="{StaticResource ProdTextBoxStyle}"
                                     TextChanged="CampoProducto_TextChanged"/>
                            <TextBlock x:Name="HintStock"
                                       Text="Cantidad en inventario"
                                       Foreground="{StaticResource ProdHintBrush}"
                                       FontSize="14"
                                       IsHitTestVisible="False"
                                       Margin="14,0,12,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Button HorizontalAlignment="Stretch"
                                Style="{StaticResource ProdPrimaryButtonStyle}"
                                Click="BtnGuardar_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE74E;"
                                           FontSize="18"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Guardar Producto" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Panel derecho: búsqueda + tabla -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.06" Direction="270"/>
                </Border.Effect>

                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barra herramientas -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4,2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBox x:Name="TxtBuscar"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="32,8,12,8"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtBuscar_TextChanged"/>
                                <TextBlock Text="🔍"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           FontSize="14"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Padding="16,10"
                                Background="#F3F4F6"
                                Foreground="#374151"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnFiltros_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE71C;"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Filtros" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid x:Name="GridProductos"
                              Grid.Row="1"
                              VerticalAlignment="Stretch"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F3F4F6"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="White"
                              AlternatingRowBackground="#F9FAFB"
                              AlternationCount="2"
                              CanUserResizeColumns="True"
                              ColumnHeaderStyle="{StaticResource ProdGridHeaderStyle}"
                              SelectionChanged="GridProductos_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="72"/>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="2*"
                                                MinWidth="140"/>
                            <DataGridTextColumn Header="Precio"
                                                Binding="{Binding Precio, StringFormat=C}"
                                                Width="110"/>
                            <DataGridTemplateColumn Header="Stock" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Stock}"
                                                   Padding="8,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Paginación simplificada -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="6"
                                    Padding="12,6"
                                    Margin="0,0,8,0">
                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <TextBlock Text="Página 1" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="CmbPorPagina"
                                  Width="120"
                                  VerticalAlignment="Center"
                                  SelectedIndex="0"
                                  SelectionChanged="CmbPorPagina_SelectionChanged">
                            <ComboBoxItem Content="20 por página"/>
                            <ComboBoxItem Content="50 por página"/>
                            <ComboBoxItem Content="100 por página"/>
                        </ComboBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
