<Window x:Class="GrunflexPOS2.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grunflex POS - Login"
        Height="520"
        Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F2F2F2">
        <Border Width="300"
                Background="White"
                Padding="20"
                CornerRadius="8"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <!-- LOGO -->

                <!-- USUARIO -->
                <TextBlock Text="Usuario"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtUsuario"
                         Height="30"
                         Margin="0,0,0,15"/>

                <!-- PASSWORD -->
                <TextBlock Text="Contraseña"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <PasswordBox x:Name="TxtPassword"
                             Height="30"
                             Margin="0,0,0,15"/>

                <!-- 🔑 NUMERO DE CAJA -->
                <TextBlock Text="Número de Caja"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtNumeroCaja"
                         Height="30"
                         Margin="0,0,0,15"
                         Text="1"/>

                <!-- 💰 MONTO INICIAL -->
                <TextBlock Text="Monto Inicial"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtMontoInicial"
                         Height="30"
                         Margin="0,0,0,20"
                         Text="0"/>

                <!-- BOTÓN LOGIN -->
                <Button Content="INGRESAR"
                        Height="35"
                        Background="#1E88E5"
                        Foreground="White"
                        FontWeight="Bold"
                        IsDefault="True"
                        Click="BtnLogin_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>