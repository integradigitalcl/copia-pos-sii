<UserControl x:Class="GrunflexPOS2.Views.LectorCodigoView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="White">

    <StackPanel Margin="20">
        <TextBlock Text="LECTOR DE CODIGO DE BARRAS"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="#003B8D"
                   Margin="0,0,0,14"/>
        <Border x:Name="BadgeEstadoLector"
                Background="#991B1B"
                CornerRadius="4"
                Padding="10,6"
                HorizontalAlignment="Left"
                Margin="0,0,0,10">
            <TextBlock x:Name="TxtEstadoLector"
                       Text="Lector serial desconectado"
                       Foreground="White"
                       FontWeight="SemiBold"/>
        </Border>

        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   FontSize="14"
                   Text="Si cuentas con un lector en modo teclado (USB, sin puerto COM), no actives el serial: conéctelo y escanee con el cursor en el campo «Código o nombre» en Ventas. Si no reacciona, haga clic una vez en ese campo o salga del grid de líneas con el mouse; el foco vuelve solo al código."/>

        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   FontSize="14"
                   Text="Si por otro lado, cuentas con un lector de código de barras con conexión a puerto serial (RS232) puedes activarlo en la siguiente casilla:"/>

        <CheckBox x:Name="ChkLectorSerial"
                  Content="Utilizo un lector de código de barras serial"
                  FontSize="14"
                  Checked="ChkLectorSerial_Checked"
                  Unchecked="ChkLectorSerial_Unchecked"/>

        <Border x:Name="PanelSerial"
                Margin="16,10,0,0"
                Padding="14"
                BorderBrush="#CFCFCF"
                BorderThickness="1"
                Visibility="Collapsed"
                MaxWidth="640">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Puerto" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbPuerto" Grid.Column="1" MinWidth="140" SelectionChanged="SerialConfig_Changed"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="(Port)" Foreground="Gray" VerticalAlignment="Center"/>
                        <Button x:Name="BtnActualizarPuertos"
                                Content="Actualizar"
                                Margin="10,0,0,0"
                                Padding="10,2"
                                Click="BtnActualizarPuertos_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bits por segundo" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbBaudRate" Grid.Column="1" MinWidth="140" SelectionChanged="SerialConfig_Changed"/>
                    <TextBlock Text="(Bits per second / Baudrate)" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bits de datos" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbDataBits" Grid.Column="1" MinWidth="140" SelectionChanged="SerialConfig_Changed"/>
                    <TextBlock Text="(Data bits)" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Paridad" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbParity" Grid.Column="1" MinWidth="140" SelectionChanged="SerialConfig_Changed"/>
                    <TextBlock Text="(Parity)" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bits de parada" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbStopBits" Grid.Column="1" MinWidth="140" SelectionChanged="SerialConfig_Changed"/>
                    <TextBlock Text="(Stop bits)" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Control de flujo" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbHandshake" Grid.Column="1" MinWidth="140" SelectionChanged="SerialConfig_Changed"/>
                    <TextBlock Text="(Flow control)" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </Grid>

                <Button x:Name="BtnProbar"
                        Width="300"
                        Height="36"
                        Content="🛠 Probar configuración del lector"
                        Click="BtnProbar_Click"/>
                <TextBlock x:Name="TxtInfoPuertos"
                           Margin="0,8,0,0"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>