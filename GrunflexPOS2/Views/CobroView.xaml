<Window x:Class="GrunflexPOS2.Views.CobroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Venta de Productos - Cobrar"
        Height="450"
        Width="850"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- IZQUIERDA -->
        <StackPanel Grid.Column="0">

            <TextBlock Text="COBRAR"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1F4E79" />

            <TextBlock x:Name="TxtTotalCobro"
                       Text="$0"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#1F4E79"
                       Margin="0,10,0,20"/>

            <!-- BOTONES MÉTODO (ACHICADOS) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="BtnEfectivo"
                        Content="Efectivo"
                        Width="105"
                        Height="34"
                        FontSize="13"
                        Margin="0,0,8,0"
                        Click="MetodoPago_Click"/>

                <Button x:Name="BtnTarjeta"
                        Content="Tarjeta"
                        Width="105"
                        Height="34"
                        FontSize="13"
                        Margin="0,0,8,0"
                        Click="MetodoPago_Click"/>

                <Button x:Name="BtnMixto"
                        Content="Mixto"
                        Width="105"
                        Height="34"
                        FontSize="13"
                        Margin="0,0,8,0"
                        Click="MetodoPago_Click"/>

                <Button x:Name="BtnTransferencia"
                        Content="Transferencia"
                        Width="120"
                        Height="34"
                        FontSize="13"
                        Click="MetodoPago_Click"/>
            </StackPanel>

            <!-- PANEL EFECTIVO -->
            <StackPanel x:Name="PanelEfectivo" Visibility="Collapsed">
                <TextBlock Text="Efectivo:"/>
                <TextBox x:Name="TxtEfectivo"
                         Height="30"
                         Width="240"
                         TextChanged="TxtEfectivo_TextChanged"/>
            </StackPanel>

            <!-- PANEL TARJETA / TRANSFERENCIA -->
            <StackPanel x:Name="PanelTarjeta" Visibility="Collapsed">
                <TextBlock Text="Tarjeta / Transferencia:"/>
                <TextBox x:Name="TxtTarjeta"
                         Height="30"
                         Width="240"/>
            </StackPanel>

            <!-- PANEL MIXTO -->
            <StackPanel x:Name="PanelMixto" Visibility="Collapsed">
                <TextBlock Text="Efectivo:"/>
                <TextBox x:Name="TxtMixtoEfectivo"
                         Height="30"
                         Width="240"
                         Margin="0,0,0,10"
                         TextChanged="TxtMixto_TextChanged"/>

                <TextBlock Text="Tarjeta / Transferencia:"/>
                <TextBox x:Name="TxtMixtoTarjeta"
                         Height="30"
                         Width="240"/>
            </StackPanel>

            <TextBlock Text="Cambio:"
                       Margin="0,20,0,0"/>
            <TextBlock x:Name="TxtCambio"
                       Text="$0"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="Green"/>
        </StackPanel>

        <!-- DERECHA -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top">

            <Button Content="F1 - Cobrar e imprimir"
                    Height="50"
                    Margin="0,0,0,10"
                    Click="BtnCobrarImprimir_Click"/>

            <Button Content="F2 - Cobrar sin imprimir"
                    Height="50"
                    Margin="0,0,0,10"
                    Click="BtnCobrarSinImprimir_Click"/>

            <Button Content="ESC - Cancelar"
                    Height="50"
                    Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>