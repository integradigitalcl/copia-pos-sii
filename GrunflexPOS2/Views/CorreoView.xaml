<UserControl x:Class="GrunflexPOS2.Views.CorreoView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="MiniTopButton" TargetType="Button" BasedOn="{StaticResource TopFlatButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="20">

        <Border Background="{StaticResource PrimaryGradientBrush}" Height="40" CornerRadius="3" Margin="0,0,0,12">
            <TextBlock Text="CONFIGURACIÓN" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
        </Border>

        <!-- TÍTULO -->
        <TextBlock Text="NOTIFICACIONES POR CORREO ELECTRÓNICO"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}"
                   Margin="0,0,0,15"/>

        <!-- DESCRIPCIÓN -->
        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,15"
                   Text="Si lo deseas, podrás configurar una cuenta de correo electrónico para que Grunflex POS pueda enviar diversas notificaciones como reportes por correo electrónico, facturas, cortes de turno, etc."/>

        <!-- CHECK -->
        <CheckBox x:Name="chkCorreo"
                  Content="Deseo que Grunflex POS pueda mandar notificaciones por correo electrónico."
                  FontSize="14"
                  Margin="0,0,0,15"
                  Checked="chkCorreo_Checked"
                  Unchecked="chkCorreo_Unchecked"/>

        <!-- FORM -->
        <StackPanel x:Name="panelCorreo"
                    Margin="20,0,0,0"
                    IsEnabled="False">

            <TextBlock Text="Usando los datos de acceso de la siguiente cuenta de correo electrónico:"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Tu dirección de correo electrónico"/>
            <TextBox x:Name="txtCorreo"
                     Width="300"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Clave de acceso a tu correo"/>
            <PasswordBox x:Name="txtClave"
                         Width="300"
                         Margin="0,5,0,10"/>

            <!-- 🔥 NUEVO: SMTP HOST -->
            <TextBlock Text="Servidor SMTP"/>
            <TextBox x:Name="txtHost"
                     Width="300"
                     Margin="0,5,0,10"
                     Text="smtp.gmail.com"/>

            <!-- 🔥 NUEVO: PUERTO -->
            <TextBlock Text="Puerto SMTP"/>
            <TextBox x:Name="txtPuerto"
                     Width="300"
                     Margin="0,5,0,10"
                     Text="587"/>

            <!-- 🔥 NUEVO: SSL -->
            <CheckBox x:Name="chkSSL"
                      Content="Usar conexión segura (SSL)"
                      IsChecked="True"
                      Margin="0,5,0,15"/>

            <Button Content="Probar envío de correo electrónico"
                    Width="250"
                    Click="BtnProbarCorreo_Click"
                    Style="{StaticResource MiniTopButton}"/>

        </StackPanel>

    </StackPanel>
</UserControl>