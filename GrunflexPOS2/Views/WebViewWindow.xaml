<Window x:Class="GrunflexPOS2.Views.WebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Navegador Grunflex"
        Height="750"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        ResizeMode="CanResize">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- ================= TOP BAR MODERNA ================= -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="15,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ATRÁS -->
                <Button Grid.Column="0"
                        Content="◀"
                        Width="40"
                        Height="35"
                        Margin="0,0,5,0"
                        Click="Back_Click"
                        Style="{StaticResource ModernButton}"/>

                <!-- ADELANTE -->
                <Button Grid.Column="1"
                        Content="▶"
                        Width="40"
                        Height="35"
                        Margin="0,0,5,0"
                        Click="Forward_Click"
                        Style="{StaticResource ModernButton}"/>

                <!-- REFRESH -->
                <Button Grid.Column="2"
                        Content="⟳"
                        Width="40"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="Refresh_Click"
                        Style="{StaticResource ModernButton}"/>

                <!-- URL -->
                <Border Grid.Column="3"
                        Background="#F3F4F6"
                        CornerRadius="20"
                        Padding="10,5"
                        VerticalAlignment="Center">

                    <TextBox x:Name="TxtUrl"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             KeyDown="TxtUrl_KeyDown"/>
                </Border>

                <!-- CERRAR -->
                <Button Grid.Column="4"
                        Content="✕"
                        Width="40"
                        Height="35"
                        Margin="10,0,0,0"
                        Click="Close_Click"
                        Background="#EF4444"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- ================= WEBVIEW ================= -->
        <Border Grid.Row="1"
                Margin="10"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <wv2:WebView2 x:Name="WebBrowser"/>
        </Border>

    </Grid>
</Window>
