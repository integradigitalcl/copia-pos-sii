<Window x:Class="GrunflexPOS2.Views.GrunflexMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="520">

    <Border Padding="20" Background="Transparent">
        <Border CornerRadius="14"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Color="#000000"
                                  Opacity="0.14"/>
            </Border.Effect>

            <Grid MinWidth="340">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,22,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconCircle"
                            Width="52"
                            Height="52"
                            CornerRadius="26"
                            Margin="0,0,14,0"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitle"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtMessage"
                                   FontSize="14"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   LineHeight="20"/>
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="1"
                           Fill="#E5E7EB"
                           Height="1"
                           Margin="0,20,0,0"/>

                <StackPanel x:Name="PanelButtons"
                            Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="20,16,20,18"/>
            </Grid>
        </Border>
    </Border>
</Window>
