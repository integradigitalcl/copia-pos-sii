<Window x:Class="GrunflexPOS2.Views.TerminalBootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grunflex POS — Preparando terminal"
        Height="280"
        Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        Loaded="Window_Loaded">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Preparando caja adicional"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>
            <TextBlock x:Name="TxtStatus"
                       Text="Iniciando…"
                       TextWrapping="Wrap"
                       Foreground="#CBD5E1"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MinHeight="48"/>
            <ProgressBar IsIndeterminate="True"
                         Height="6"
                         Margin="0,24,0,0"
                         Foreground="#3B82F6"/>
        </StackPanel>
    </Grid>
</Window>
