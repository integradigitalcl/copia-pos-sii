<UserControl x:Class="GrunflexPOS2.Views.FolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="MiniTopButton" TargetType="Button" BasedOn="{StaticResource TopFlatButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">

        <StackPanel>

            <!-- 🔵 BARRA -->
            <Border Background="{StaticResource PrimaryGradientBrush}"
                    Height="40"
                    CornerRadius="3">

                <TextBlock Text="CONFIGURACIÓN"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="10,0"/>
            </Border>

            <!-- BOTÓN -->
            <Button Content="🏠 Mostrar todas las opciones"
                    Margin="0,10,0,20"
                    Width="220"
                    Style="{StaticResource MiniTopButton}"/>

            <!-- TÍTULO -->
            <TextBlock Text="FOLIO DE TICKETS"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,0,15"/>

            <!-- DESCRIPCIÓN -->
            <TextBlock Text="Puedes configurar aquí el manejo de los folios de las ventas del sistema Grunflex POS."
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- INPUT -->
            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Nombre:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBox Width="200"
                         Height="25"
                         Text="Folio:85"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>