<Window x:Class="GrunflexPOS2.Views.TicketPdfSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticket"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="440"
        MaxWidth="640">

    <Border Padding="24"
            Background="Transparent">
        <Border CornerRadius="14"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Color="#000000"
                                  Opacity="0.12"/>
            </Border.Effect>
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabecera + cerrar -->
                <Grid Grid.Row="0" Margin="0,0,0,0">
                    <Grid Margin="28,24,48,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="64"
                              Height="64"
                              VerticalAlignment="Top"
                              Margin="0,0,16,0">
                            <Ellipse Fill="#D1FAE5"/>
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="#059669"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Margin="0,4,0,0">
                            <TextBlock x:Name="TxtTitulo"
                                       Text="Ticket reimpreso correctamente"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtSubtitulo"
                                       Text="El ticket se ha guardado en la siguiente ubicación:"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Button Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,12,12,0"
                            Click="Cerrar_Click"
                            ToolTip="Cerrar"
                            Cursor="Hand"
                            Style="{x:Null}"
                            Panel.ZIndex="2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="#DBEAFE"
                                        CornerRadius="6">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="#1D4ED8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#BFDBFE"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Ruta -->
                <Border Grid.Row="1"
                        Margin="28,20,28,0"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#1D4ED8"
                                   VerticalAlignment="Top"
                                   Margin="0,2,10,0"/>
                        <TextBlock x:Name="TxtRuta"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#111827"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Rectangle Grid.Row="2"
                           Fill="#E5E7EB"
                           Height="1"
                           Margin="0,20,0,0"
                           VerticalAlignment="Bottom"/>

                <!-- Aceptar -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="20,16,20,20">
                    <Button MinWidth="140"
                            Height="40"
                            Click="Aceptar_Click"
                            IsDefault="True"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="#1D4ED8"
                                        CornerRadius="8"
                                        Padding="16,0">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="20"
                                                Height="20"
                                                CornerRadius="10"
                                                Background="White"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE73E;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       Foreground="#1D4ED8"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Aceptar"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
