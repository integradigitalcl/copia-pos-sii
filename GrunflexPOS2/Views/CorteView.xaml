<UserControl x:Class="GrunflexPOS2.Views.CorteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E5E7EB"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BtnOutline" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
        <StackPanel Margin="20,16">

            <!-- Cabecera -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE825;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="Corte de caja"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="&#xE787;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtFecha"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BtnImprimirExportar"
                        Grid.Column="1"
                        Style="{StaticResource BtnOutline}"
                        VerticalAlignment="Top"
                        Click="BtnImprimirExportar_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Imprimir" Click="ImprimirCorte_Click"/>
                            <MenuItem Header="Exportar PDF" Click="ExportarCortePdf_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE749;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Imprimir / Exportar" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- KPI: WrapPanel para apilar tarjetas en pantallas estrechas -->
            <WrapPanel Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Width="320" MinWidth="220" Margin="0,0,8,8" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Path VerticalAlignment="Bottom" Stretch="Fill" Height="44" Opacity="0.35"
                              Data="M0,80 Q90,25 200,50 T400,28 L400,80 L0,80 Z"
                              Fill="#DBEAFE"/>
                        <StackPanel Margin="16,16,16,18">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#EFF6FF" Margin="0,0,0,10">
                                <TextBlock Text="&#xE719;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="VENTAS TOTALES"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
/>
                            <TextBlock x:Name="TxtVentasTotales"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Total de ventas del día"
                                       FontSize="12"
                                       Foreground="#9CA3AF"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Width="320" MinWidth="220" Margin="0,0,8,8" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Path VerticalAlignment="Bottom" Stretch="Fill" Height="44" Opacity="0.35"
                              Data="M0,72 Q100,35 220,48 T400,30 L400,80 L0,80 Z"
                              Fill="#D1FAE5"/>
                        <StackPanel Margin="16,16,16,18">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#ECFDF5" Margin="0,0,0,10">
                                <TextBlock Text="&#xE8CC;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="#059669"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="DINERO ESPERADO"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
/>
                            <TextBlock x:Name="TxtEsperado"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#047857"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Total esperado en caja"
                                       FontSize="12"
                                       Foreground="#9CA3AF"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Width="320" MinWidth="220" Margin="0,0,8,8" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Path VerticalAlignment="Bottom" Stretch="Fill" Height="44" Opacity="0.28"
                              Data="M0,75 Q80,28 210,45 T400,32 L400,80 L0,80 Z"
                              Fill="#EDE9FE"/>
                        <StackPanel Margin="16,16,16,18">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#F5F3FF" Margin="0,0,0,10">
                                <TextBlock Text="&#xE9D9;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="#7C3AED"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="GANANCIA"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
/>
                            <TextBlock x:Name="TxtGanancia"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Ganancia del día"
                                       FontSize="12"
                                       Foreground="#9CA3AF"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </WrapPanel>

            <!-- Dinero contado -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE8CC;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="DINERO CONTADO"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" MinWidth="140"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="White"
                                BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14"
                                Margin="0,0,16,0">
                            <TextBox x:Name="TxtDineroContado"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="#059669"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtDineroContado_TextChanged"/>
                        </Border>

                        <Rectangle Grid.Column="1"
                                   Width="1"
                                   Fill="{StaticResource BorderSoft}"
                                   Margin="0,6"
                                   VerticalAlignment="Stretch"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="DIFERENCIA"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
/>
                            <TextBlock x:Name="TxtDiferencia"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Detalle: columnas apilables en pantallas estrechas -->
            <WrapPanel Orientation="Horizontal">
                <StackPanel Width="420" MinWidth="280" Margin="0,0,8,8">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE8CB;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="DINERO EN CAJA"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
/>
                            </StackPanel>

                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Fondo inicial" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtMontoInicial" Grid.Column="2" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8CC;" FontFamily="Segoe MDL2 Assets" Foreground="#059669" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Ventas en efectivo" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEfectivo" Grid.Column="2" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Entradas" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEntradas" Grid.Column="2" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Salidas" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSalidas" Grid.Column="2" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Foreground="#EA580C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Devoluciones" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDevoluciones" Grid.Column="2" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <Border Background="#EFF6FF" CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <TextBlock Text="TOTAL EN CAJA" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTotalEnCaja"
                                               HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               FontSize="15"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="INFORMACIÓN"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCaja" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtCajero" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                            <Border Background="#EFF6FF" CornerRadius="10" Padding="16" MinHeight="80">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="&#xE825;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="36"
                                               Foreground="#93C5FD"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Caja registradora"
                                               FontSize="11"
                                               Foreground="#9CA3AF"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Columna derecha -->
                <StackPanel Width="420" MinWidth="280" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE8C7;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="VENTAS POR MÉTODO"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
/>
                            </StackPanel>

                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Débito" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDebito" Grid.Column="2" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="#059669" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Crédito" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCredito" Grid.Column="2" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Transferencia" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTransferencia" Grid.Column="2" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Anulaciones" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAnulaciones" Grid.Column="2" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <Border Background="#EFF6FF" CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <TextBlock Text="TOTAL" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTotalMetodos"
                                               HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               FontSize="15"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="&#xE9D9;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="RESUMEN OPERATIVO"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
/>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Ventas realizadas" Grid.Row="0" FontSize="14" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtTotalVentasRealizadas" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <TextBlock Text="Artículos vendidos" Grid.Row="1" FontSize="14" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtTotalArticulos" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <TextBlock Text="Consumo personal (movimientos)" Grid.Row="2" FontSize="14" Foreground="#57534E" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtConsumoMovimientos" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Foreground="#57534E" Margin="0,0,0,10"/>

                                <TextBlock Text="Consumo personal (unidades)" Grid.Row="3" FontSize="14" Foreground="#57534E" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtConsumoUnidades" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Foreground="#57534E" Margin="0,0,0,10"/>

                                <TextBlock Text="Impuestos" Grid.Row="4" FontSize="14"/>
                                <TextBlock x:Name="TxtImpuestos" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Background="#ECFDF5" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="GANANCIA NETA" FontWeight="SemiBold" FontSize="13" Foreground="#047857" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGananciaNeta"
                                               HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               FontSize="15"
                                               Foreground="#047857"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </WrapPanel>

            <!-- Cerrar turno -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Content="Cerrar turno"
                        MinWidth="180"
                        Height="44"
                        Style="{StaticResource BtnDanger}"
                        Click="CerrarCaja_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
