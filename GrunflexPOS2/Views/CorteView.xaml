<UserControl x:Class="GrunflexPOS2.Views.CorteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="60">

            <!-- HEADER -->
            <StackPanel Margin="0,0,0,25">
                <TextBlock Text="CORTE DE CAJA"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"/>
                <TextBlock x:Name="TxtFecha"
                           FontSize="15"
                           Foreground="Gray"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Separator Margin="0,0,0,40"/>

            <!-- MÉTRICAS PRINCIPALES -->
            <Grid Margin="0,0,0,50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="VENTAS TOTALES"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtVentasTotales"
                               FontSize="30"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="DINERO ESPERADO"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtEsperado"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1B5E20"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="GANANCIA"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtGanancia"
                               FontSize="30"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <Separator Margin="0,0,0,40"/>

            <!-- DINERO CONTADO -->
            <StackPanel Margin="0,0,0,50">

                <TextBlock Text="DINERO CONTADO"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtDineroContado"
                             FontSize="20"
                             Height="44"
                             VerticalContentAlignment="Center"
                             Padding="12"
                             TextChanged="TxtDineroContado_TextChanged"/>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right">

                        <TextBlock Text="DIFERENCIA"
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="TxtDiferencia"
                                   FontSize="26"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Separator Margin="0,0,0,40"/>

            <!-- CUERPO -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- IZQUIERDA -->
                <StackPanel Margin="0,0,60,0">

                    <TextBlock Text="DINERO EN CAJA"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Fondo inicial" Grid.Row="0" FontSize="15"/>
                        <TextBlock x:Name="TxtMontoInicial"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Ventas en efectivo" Grid.Row="1" FontSize="15"/>
                        <TextBlock x:Name="TxtEfectivo"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Entradas" Grid.Row="2" FontSize="15"/>
                        <TextBlock x:Name="TxtEntradas"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Salidas" Grid.Row="3" FontSize="15"/>
                        <TextBlock x:Name="TxtSalidas"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Devoluciones" Grid.Row="4" FontSize="15"/>
                        <TextBlock x:Name="TxtDevoluciones"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="INFORMACIÓN"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"
                               Margin="0,35,0,15"/>

                    <TextBlock x:Name="TxtCaja" FontSize="15"/>
                    <TextBlock x:Name="TxtCajero" FontSize="15"/>

                </StackPanel>

                <!-- DERECHA -->
                <StackPanel Grid.Column="1">

                    <TextBlock Text="VENTAS POR MÉTODO"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Débito" Grid.Row="0" FontSize="15"/>
                        <TextBlock x:Name="TxtDebito"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Crédito" Grid.Row="1" FontSize="15"/>
                        <TextBlock x:Name="TxtCredito"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Transferencia" Grid.Row="2" FontSize="15"/>
                        <TextBlock x:Name="TxtTransferencia"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Anulaciones" Grid.Row="3" FontSize="15"/>
                        <TextBlock x:Name="TxtAnulaciones"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="RESUMEN OPERATIVO"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"
                               Margin="0,35,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Ventas realizadas" Grid.Row="0" FontSize="15"/>
                        <TextBlock x:Name="TxtTotalVentasRealizadas"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Artículos vendidos" Grid.Row="1" FontSize="15"/>
                        <TextBlock x:Name="TxtTotalArticulos"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Impuestos" Grid.Row="2" FontSize="15"/>
                        <TextBlock x:Name="TxtImpuestos"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                </StackPanel>
            </Grid>

            <Separator Margin="0,50,0,30"/>

            <!-- BOTONES -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Imprimir"
                        Width="120"
                        Height="42"
                        Margin="0,0,20,0"/>

                <Button Content="Cerrar turno"
                        Width="170"
                        Height="42"
                        Background="#C62828"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="CerrarCaja_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>