<UserControl x:Class="GrunflexPOS2.Views.LicenciaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="LicTitleBrush" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="LicDescBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="LicPurpleBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="LicGreenBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="LicCardBorderBrush" Color="#E2E8F0"/>

        <Style x:Key="LicCardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LicCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.07" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LicSectionPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="LicFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="LicFieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="LicPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ConfigAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LicOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource ConfigAccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ConfigAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LicPurpleButton" TargetType="Button" BasedOn="{StaticResource LicPrimaryButton}">
            <Setter Property="Background" Value="{StaticResource LicPurpleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="#F5F7FB" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28" MaxWidth="1180">

            <!-- Cabecera -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#DCFCE7" Margin="0,0,14,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE82E;"
                                   FontSize="22"
                                   Foreground="{StaticResource LicGreenBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Licencia y sincronizaci&#243;n"
                                   FontSize="24"
                       FontWeight="Bold"
                                   Foreground="{StaticResource LicTitleBrush}"/>
                        <TextBlock Text="Estado local, &#250;ltima validaci&#243;n y sincronizaci&#243;n con la API de licencias."
                                   Foreground="{StaticResource LicDescBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BtnActualizar"
                        Grid.Column="1"
                        Style="{StaticResource LicOutlineButton}"
                        VerticalAlignment="Top"
                        Click="BtnSync_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE72C;"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Actualizar estado" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="BannerGrace"
                    Background="#FEF3C7"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7BA;"
                               FontSize="16"
                               Foreground="#D97706"
                               Margin="0,0,10,0"
                               VerticalAlignment="Top"/>
                <TextBlock x:Name="TxtBannerGrace"
                           TextWrapping="Wrap"
                           Foreground="#92400E"
                           FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Fila superior: Equipo y API | Estado general -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource LicCardBorder}">
                    <StackPanel>
                        <Border Style="{StaticResource LicSectionPill}" Background="#EFF6FF">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE968;"
                                           FontSize="12"
                                           Foreground="{DynamicResource ConfigAccentBrush}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="EQUIPO Y API"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ConfigAccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="12"
                                           Foreground="{DynamicResource ConfigAccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="API base" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtApiUrl" Style="{StaticResource LicFieldValue}"
                                       Foreground="{DynamicResource ConfigAccentBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE770;" FontSize="12"
                                           Foreground="#64748B" Margin="0,0,6,0"/>
                                <TextBlock Text="Equipo" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtMachine" Style="{StaticResource LicFieldValue}"/>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE192;" FontSize="12"
                                           Foreground="#64748B" Margin="0,0,6,0"/>
                                <TextBlock Text="ActivationId" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtActivation" Style="{StaticResource LicFieldValue}"/>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE964;" FontSize="12"
                                           Foreground="{DynamicResource ConfigAccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Cajas del plan" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCajasPlan" Style="{StaticResource LicFieldValue}"
                                       Foreground="{DynamicResource ConfigAccentBrush}"/>
                            <TextBlock x:Name="TxtCajasUso"
                                       FontSize="12"
                                       Foreground="{StaticResource LicDescBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="BorderEstadoGeneral" Grid.Column="2" Style="{StaticResource LicCardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="BorderEstadoGeneralIcon"
                                Grid.Column="0"
                                Width="52"
                                Height="52"
                                CornerRadius="26"
                                Background="#DCFCE7"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                            <TextBlock x:Name="TbEstadoGeneralIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE73E;"
                                       FontSize="22"
                                       Foreground="{StaticResource LicGreenBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Style="{StaticResource LicSectionPill}" Background="#F0FDF4" Margin="0,0,0,10">
                                <TextBlock Text="ESTADO GENERAL"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource LicGreenBrush}"/>
                            </Border>
                            <TextBlock x:Name="TxtEstadoGeneralTitulo"
                                       Text="Todo en orden"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtEstadoGeneralSub"
                                       Text="La licencia local est&#225; activa y sincronizada correctamente con la API."
                                       FontSize="13"
                                       Foreground="{StaticResource LicDescBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Width="72"
                                Height="72"
                                CornerRadius="36"
                                Background="#F0FDF4"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE82E;"
                                       FontSize="34"
                                       Foreground="{StaticResource LicGreenBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Estado local -->
            <Border Style="{StaticResource LicCardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Border Style="{StaticResource LicSectionPill}" Background="#F5F3FF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8D7;"
                                       FontSize="12"
                                       Foreground="{StaticResource LicPurpleBrush}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="ESTADO LOCAL (TOKEN)"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource LicPurpleBrush}"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="12"
                                           Foreground="{StaticResource LicGreenBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Licencia local" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtLicensed" Style="{StaticResource LicFieldValue}" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="12"
                                           Foreground="{DynamicResource ConfigAccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Vencimiento (payload)" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtExpiresLocal" Style="{StaticResource LicFieldValue}"
                                       Foreground="{DynamicResource ConfigAccentBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="12"
                                           Foreground="{StaticResource LicPurpleBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="M&#243;dulos habilitados" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtModules" Style="{StaticResource LicFieldValue}" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE916;" FontSize="12"
                                           Foreground="{StaticResource LicPurpleBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="&#218;ltima validaci&#243;n local" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtLastValidated" Style="{StaticResource LicFieldValue}"
                                       Foreground="{DynamicResource ConfigAccentBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="12"
                                           Foreground="{DynamicResource ConfigAccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="&#218;ltima sincronizaci&#243;n con API" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtLastCloud" Style="{StaticResource LicFieldValue}" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE701;" FontSize="12"
                                           Foreground="#D97706" Margin="0,0,6,0"/>
                                <TextBlock Text="Tolerancia offline" Style="{StaticResource LicFieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGrace" Style="{StaticResource LicFieldValue}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Servidor -->
            <Border Style="{StaticResource LicCardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="56"
                            Height="56"
                            CornerRadius="14"
                            Background="#F5F3FF"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xF78B;"
                                   FontSize="24"
                                   Foreground="{StaticResource LicPurpleBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Style="{StaticResource LicSectionPill}" Background="#F5F3FF" Margin="0,0,0,8">
                            <TextBlock Text="SERVIDOR (CONSULTA)"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource LicPurpleBrush}"/>
                        </Border>
                    <TextBlock x:Name="TxtServerStatus"
                                   Text="Pulse &#171;Consultar estado&#187; para leer el registro en la API (sin cambiar el token local)."
                               TextWrapping="Wrap"
                               FontSize="13"
                                   Foreground="{StaticResource LicDescBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource LicPurpleButton}"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Click="BtnStatus_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE72C;"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Consultar estado" VerticalAlignment="Center"/>
                </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Aviso tolerancia offline -->
            <Border Background="#FFF7ED"
                    BorderBrush="#FDBA74"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="#FFEDD5"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE7BA;"
                                   FontSize="18"
                                   Foreground="#EA580C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SOBRE LA TOLERANCIA OFFLINE"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C2410C"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Si el POS no puede comunicarse con la API, seguir&#225; funcionando hasta agotar la tolerancia configurada."
                                   FontSize="13"
                                   Foreground="#9A3412"
                                   TextWrapping="Wrap"/>
            </StackPanel>

                    <TextBlock Grid.Column="2"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xE753;"
                               FontSize="28"
                               Foreground="#FB923C"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <Button Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    Padding="0"
                    Click="BtnCopy_Click">
                <TextBlock Text="Copiar diagn&#243;stico al portapapeles"
                           FontSize="12"
                           Foreground="{StaticResource LicDescBrush}"
                           TextDecorations="Underline"/>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
