<UserControl x:Class="GrunflexPOS2.Views.UnidadesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="MiniTopButton" TargetType="Button" BasedOn="{StaticResource TopFlatButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">

        <StackPanel>

            <!-- HEADER -->
            <Border Background="{StaticResource PrimaryGradientBrush}" Height="40" CornerRadius="3">
                <TextBlock Text="CONFIGURACIÓN"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="10,0"/>
            </Border>

            <Button Content="🏠 Mostrar todas las opciones"
                    Margin="0,10,0,20"
                    Width="220"
                    Style="{StaticResource MiniTopButton}"/>

            <!-- TÍTULO -->
            <TextBlock Text="UNIDADES DE MEDIDA"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Elige las unidades de medida que usas en tu negocio"
                       Margin="0,0,0,15"
                       Foreground="Gray"/>

            <!-- LISTA -->
            <Border BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Width="250"
                    Background="White"
                    CornerRadius="6">

                <StackPanel>

                    <CheckBox Content="H / MIN"/>
                    <CheckBox Content="KG / G" IsChecked="True"/>
                    <CheckBox Content="L / ML"/>
                    <CheckBox Content="M / CM"/>
                    <CheckBox Content="NO APLICA"/>
                    <CheckBox Content="PZA"/>

                </StackPanel>

            </Border>

            <!-- INFO -->
            <TextBlock Text="Al usar más de 2 unidades de medida se mostrará un nuevo campo al crear o modificar productos"
                       Margin="0,20,0,10"
                       TextWrapping="Wrap"
                       Foreground="Gray"/>

            <!-- EJEMPLO -->
            <StackPanel Margin="0,10,0,0">

                <TextBlock Text="Unidad seleccionada:"/>
                <ComboBox Width="150">
                    <ComboBoxItem Content="PZA"/>
                    <ComboBoxItem Content="KG"/>
                    <ComboBoxItem Content="L"/>
                </ComboBox>

            </StackPanel>

        </StackPanel>

    </Grid>
</UserControl>