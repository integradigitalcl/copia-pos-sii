<UserControl x:Class="GrunflexPOS2.Views.ImpresoraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="MiniTopButton" TargetType="Button" BasedOn="{StaticResource TopFlatButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Background="{StaticResource PrimaryGradientBrush}" Height="40" CornerRadius="3">
                <TextBlock Text="CONFIGURACIÓN" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
            </Border>

            <TextBlock Text="IMPRESORA DE TICKETS" FontSize="38" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,6"/>
            <TextBlock Text="Selecciona impresora:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbImpresora" Height="30" Margin="0,0,0,12" SelectionChanged="CmbImpresora_SelectionChanged"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <StackPanel Width="210">
                    <TextBlock Text="Fuente"/>
                    <ComboBox x:Name="CmbFuente" Height="24" SelectionChanged="Config_Changed">
                        <ComboBoxItem Content="Courier New"/>
                        <ComboBoxItem Content="Arial"/>
                        <ComboBoxItem Content="Consolas"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Width="62" Margin="16,0,0,0">
                    <TextBlock Text="Tamaño"/>
                    <TextBox x:Name="TxtTamano" Height="24" Text="10" TextChanged="Config_Changed"/>
                </StackPanel>
                <StackPanel Width="62" Margin="16,0,0,0">
                    <TextBlock Text="Columnas"/>
                    <TextBox x:Name="TxtColumnas" Height="24" Text="36" TextChanged="Config_Changed"/>
                </StackPanel>
                <StackPanel Width="80" Margin="16,0,0,0">
                    <TextBlock Text="Ancho"/>
                    <ComboBox x:Name="CmbAnchoMm" Height="24" SelectionChanged="Config_Changed">
                        <ComboBoxItem Content="58"/>
                        <ComboBoxItem Content="80"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <CheckBox x:Name="ChkTotalesNormal" Content="Usar fuente normal para totales" Checked="Config_Changed" Unchecked="Config_Changed"/>
            <CheckBox x:Name="ChkNegrita" Content="Texto en negrita" Margin="0,2,0,12" Checked="Config_Changed" Unchecked="Config_Changed"/>
            <Separator Margin="0,0,0,10"/>

            <TextBlock Text="PERSONALIZACIÓN DEL TICKET DE VENTA" FontSize="34" FontWeight="Bold" Foreground="#003B8D" Margin="0,0,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="↕" FontSize="24" Foreground="#0A58CA" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtLineasArriba" Width="46" Height="22" Text="0" TextAlignment="Center" TextChanged="Config_Changed"/>
                        <TextBlock Text="lineas" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="6" MinHeight="505" Background="White" CornerRadius="6">
                        <StackPanel>
                            <Grid Height="84" Margin="0,0,0,6">
                                <Border BorderBrush="#BFBFBF" BorderThickness="1" Background="#FCFCFC"/>
                                <Image x:Name="ImgPreviewLogo" Height="70" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Border BorderBrush="#B3B3B3" BorderThickness="1" Margin="0,0,0,6" Padding="3">
                                <StackPanel>
                                    <TextBox x:Name="TxtPreviewTitulo" Text="Nombre de mi Negocio" FontFamily="Consolas" FontSize="16" FontWeight="Bold" BorderThickness="0" Background="Transparent" Padding="0" Height="24" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                                    <TextBox x:Name="TxtPreviewSubtitulo" Text="Direccion 123 Col. Colonia" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="20" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                                    <TextBox x:Name="TxtPreviewTelefono" Text="(555) 123 4567" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="20" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                                    <TextBox x:Name="TxtPreviewRfc" Text="RFC003128ZBI" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="20" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="TxtPreviewHeaderItems" Text="Cant.  Descripcion               Importe" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="19" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                            <TextBox x:Name="TxtPreviewGuion" Text="========================================" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="19" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                            <TextBox x:Name="TxtPreviewItem1" Text="1     Agua Ciel 600ml            $7.00" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="19" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                            <TextBox x:Name="TxtPreviewItem2" Text="1     Coca Cola Light            $8.00" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="19" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                            <TextBox x:Name="TxtPreviewItem3" Text="1Kg   Tomate                    $10.00" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="19" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                            <TextBox x:Name="TxtPreviewArticulos" Text="No. de Articulos: 4" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="19" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" TextChanged="Config_Changed"/>
                            <TextBox x:Name="TxtPreviewTotal" Text="Total: $33.00" FontFamily="Consolas" FontSize="11" FontWeight="Bold" BorderThickness="0" Background="Transparent" Padding="0" Height="19" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" TextChanged="Config_Changed"/>
                            <Border BorderBrush="#B3B3B3" BorderThickness="1" Margin="0,8,0,0" Padding="3">
                                <StackPanel>
                                    <TextBox x:Name="TxtPreviewFooter" Text="Gracias por su compra" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="20" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                                    <TextBox x:Name="TxtPreviewFooter2" Text="www.eleventa.com" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0" Height="20" VerticalContentAlignment="Center" TextChanged="Config_Changed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                        <Button Content="🔍 Agregar logotipo..." Width="158" Margin="0,0,6,0" Click="BtnAgregarLogo_Click" Style="{StaticResource MiniTopButton}"/>
                        <Button Content="🗑 Quitar logotipo..." Width="158" Click="BtnQuitarLogo_Click" Style="{StaticResource MiniTopButton}"/>
                    </StackPanel>

                    <Button Content="Lineas adicionales ..." Width="130" HorizontalAlignment="Center" Click="BtnGuardarConfig_Click" Style="{StaticResource MiniTopButton}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="↕" FontSize="24" Foreground="#0A58CA" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtLineasAbajo" Width="46" Height="22" Text="5" TextAlignment="Center" TextChanged="Config_Changed"/>
                        <TextBlock Text="lineas" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,2,0,0">
                    <CheckBox x:Name="ChkPrecioUnitario" Content="Incluir Precio Unitario en la impresión del ticket." Checked="Config_Changed" Unchecked="Config_Changed"/>
                    <CheckBox x:Name="ChkDescripcionExtendida" Content="Imprimir descripción completa (Usar varios renglones)." Margin="0,6,0,8" Checked="Config_Changed" Unchecked="Config_Changed"/>
                    <Button Content="🖨 Probar impresión con último ticket ..." Height="40" Margin="0,4,0,20" Click="BtnProbarImpresion_Click" Style="{StaticResource MiniTopButton}"/>

                    <TextBlock Text="Impresión de datos de cliente" FontSize="34" FontWeight="Bold" Foreground="#003B8D" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkDatosCliente" Content="Imprimir en todos los tickets los datos del cliente" Checked="Config_Changed" Unchecked="Config_Changed"/>
                    <Button Content="💾 Guardar configuración" Margin="0,14,0,0" Width="260" Click="BtnGuardarConfig_Click" Style="{StaticResource MiniTopButton}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>