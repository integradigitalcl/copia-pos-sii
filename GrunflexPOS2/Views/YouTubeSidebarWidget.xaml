<UserControl x:Class="GrunflexPOS2.Views.YouTubeSidebarWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             x:Name="Root">

    <Border CornerRadius="14"
            Padding="12"
            Margin="0,16,0,0"
            Background="#0F0F0F"
            BorderBrush="#3F3F3F"
            BorderThickness="1">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="YOUTUBE MUSIC"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>
                <Border Width="22" Height="22" CornerRadius="11" Background="#FF0000"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="&#xE768;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Border CornerRadius="8"
                    Background="#212121"
                    Height="88"
                    Margin="0,0,0,10">
                <Grid VerticalAlignment="Center" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnPrevious"
                            Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            Cursor="Hand" Click="BtnPrevious_Click"/>
                    <Button Grid.Column="1" x:Name="BtnPlayPause"
                            Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                            Background="White" BorderThickness="0" Foreground="Black"
                            Width="40" Height="40" HorizontalAlignment="Center"
                            Cursor="Hand" Click="BtnPlayPause_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" x:Name="BtnNext"
                            Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            Cursor="Hand" Click="BtnNext_Click"/>
                    <Button Grid.Column="3" x:Name="BtnMute"
                            Content="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Background="Transparent" BorderThickness="0" Foreground="#AAAAAA"
                            Cursor="Hand" Click="BtnMute_Click"/>
                </Grid>
            </Border>

            <Border Width="1" Height="1" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
                <wv2:WebView2 x:Name="Player" Width="320" Height="200"/>
            </Border>

            <Button Content="Abrir YouTube Music"
                    Padding="10,6"
                    Background="#FF0000"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,0,6"
                    Click="BtnAbrir_Click"/>
            <Button Content="Pantalla completa"
                    Padding="10,6"
                    Background="#282828"
                    Foreground="White"
                    BorderBrush="#3F3F3F"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="BtnPantallaCompleta_Click"/>
        </StackPanel>
    </Border>
</UserControl>
