<UserControl x:Class="GrunflexPOS2.Views.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:GrunflexPOS2.Views"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1180"
             Background="#F9FAFB"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="InventarioView_Loaded"
             SizeChanged="InventarioView_SizeChanged"
             PreviewKeyDown="InventarioView_PreviewKeyDown">
    <UserControl.Resources>
        <views:ExistenciaForegroundConverter x:Key="ExistenciaFgConverter"/>

        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>

        <Style x:Key="ToolbarSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarPrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolbarSecondaryBtn}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#008F39"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#007A30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SearchBoxBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="0"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,14">
            <Button x:Name="BtnModoAgregar"
                    Style="{StaticResource ToolbarPrimaryBtn}"
                    Margin="0,0,10,8"
                    Click="BtnModoAgregar_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Agregar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Margin="0,0,10,8"
                    Style="{StaticResource ToolbarSecondaryBtn}"
                    Click="BtnImportarExcel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Importar Excel" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnModoAjustes"
                    Margin="0,0,10,8"
                    Style="{StaticResource ToolbarSecondaryBtn}"
                    Click="BtnModoAjustes_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Ajustes" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnModoBajos"
                    Margin="0,0,10,8"
                    Style="{StaticResource ToolbarSecondaryBtn}"
                    Click="BtnModoBajos_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Productos bajos" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnModoReporte"
                    Margin="0,0,10,8"
                    Style="{StaticResource ToolbarSecondaryBtn}"
                    Click="BtnModoReporte_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Reporte Inventario" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnModoMovimientos"
                    Margin="0,0,10,8"
                    Style="{StaticResource ToolbarSecondaryBtn}"
                    Click="BtnModoMovimientos_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Movimientos" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnModoKardex"
                    Margin="0,0,10,8"
                    Style="{StaticResource ToolbarSecondaryBtn}"
                    Click="BtnModoKardex_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Kardex" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Margin="0,0,10,8"
                    Style="{StaticResource ToolbarSecondaryBtn}"
                    Click="BtnExportarLista_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Exportar lista" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <Grid Grid.Row="1" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="300"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel x:Name="PanelAgregarAjuste">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTituloModo"
                                               Text="AGREGAR INVENTARIO"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"/>
                                    <TextBlock Text="Las columnas siguen la misma lógica que Excel. F10 enfoca la búsqueda del listado."
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel Width="220" MinWidth="180" Margin="0,0,12,12">
                                <TextBlock Text="Código" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbBuscarProducto"
                                          Height="40"
                                          IsEditable="True"
                                          StaysOpenOnEdit="True"
                                          SelectionChanged="CmbBuscarProducto_SelectionChanged"
                                          KeyDown="CmbBuscarProducto_KeyDown"/>
                            </StackPanel>

                            <StackPanel Width="260" MinWidth="200" Margin="0,0,12,12">
                                <TextBlock Text="Producto" Style="{StaticResource FieldLabel}"/>
                                <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="10,10" MinHeight="40">
                                    <TextBlock x:Name="LblNombre"
                                               Text="Se seleccionará el producto"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Width="120" MinWidth="100" Margin="0,0,12,12">
                                <TextBlock Text="Stock actual" Style="{StaticResource FieldLabel}"/>
                                <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="10,10" MinHeight="40">
                                    <TextBlock x:Name="LblStock"
                                               Text="—"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Width="180" MinWidth="160" Margin="0,0,12,12">
                                <TextBlock Text="Cantidad (+/-)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Width="36"
                                            Height="40"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource ToolbarSecondaryBtn}"
                                            Padding="0"
                                            Click="BtnCantidadMenos_Click"
                                            ToolTip="Menos">
                                        <TextBlock Text="&#xE949;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <Border Grid.Column="1"
                                            Background="White"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <TextBox x:Name="TxtCantidad"
                                                 Height="40"
                                                 Text="0"
                                                 TextAlignment="Center"
                                                 PreviewTextInput="TxtCantidad_PreviewTextInput"
                                                 TextChanged="TxtCantidad_TextChanged"/>
                                    </Border>
                                    <Button Grid.Column="2"
                                            Width="36"
                                            Height="40"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource ToolbarSecondaryBtn}"
                                            Padding="0"
                                            Click="BtnCantidadMas_Click"
                                            ToolTip="Más">
                                        <TextBlock Text="&#xE948;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="BtnGuardar"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource GreenActionBtn}"
                                    Click="BtnGuardar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Guardar Movimiento" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Reporte inventario -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel x:Name="PanelReporteInventario" Visibility="Collapsed">
                        <TextBlock Text="Reporte de inventario"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbDepartamentoReporte"
                                          Height="40"
                                          SelectionChanged="CmbDepartamentoReporte_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock Text="Costo total inventario" Style="{StaticResource FieldLabel}"/>
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <TextBlock x:Name="LblCostoInventario"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Right"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LblCantidadProductosInv"
                                       FontSize="13"
                                       Foreground="#374151"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Left"
                                Style="{StaticResource ToolbarSecondaryBtn}"
                                Click="BtnExportarReporte_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Exportar PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Movimientos -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel x:Name="PanelMovimientos" Visibility="Collapsed">
                        <TextBlock Text="Movimientos de inventario"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,14"/>

                        <DataGrid x:Name="GridMovimientos"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="34"
                                  AlternatingRowBackground="#FAFBFC"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                  ColumnHeaderHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="140"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding Cajero}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Kardex -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel x:Name="PanelKardex" Visibility="Collapsed">
                        <TextBlock Text="Kardex por producto"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Buscar producto (código o nombre)" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource SearchBoxBorder}">
                                    <TextBox x:Name="TxtKardexProducto"
                                             KeyDown="TxtKardexProducto_KeyDown"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Height="40"
                                    Style="{StaticResource ToolbarPrimaryBtn}"
                                    Click="BtnBuscarKardex_Click"
                                    Content="Buscar"/>
                        </Grid>

                        <DataGrid x:Name="GridKardex"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="34"
                                  AlternatingRowBackground="#FAFBFC"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                  ColumnHeaderHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/>
                                <DataGridTextColumn Header="Referencia" Binding="{Binding Referencia}" Width="160"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding Cajero}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

                <!-- Listado -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorder}"
                        MinHeight="0">
                    <Grid x:Name="PanelListado" MinHeight="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="0"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Listado de inventario"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"/>
                                <TextBlock Text="Existencia en verde (OK), naranja (bajo mínimo), rojo (sin stock)."
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SearchBoxBorder}">
                                <Grid>
                                    <TextBlock Text="Buscar por nombre o código..."
                                               Foreground="#9CA3AF"
                                               Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtBuscarNombre}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtBuscarNombre"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             KeyDown="TxtBuscarNombre_KeyDown"
                                             TextChanged="TxtBuscarNombre_TextChanged"/>
                                </Grid>
                            </Border>

                            <Button Grid.Column="2"
                                    Height="40"
                                    MinWidth="120"
                                    Style="{StaticResource ToolbarSecondaryBtn}"
                                    Click="BtnFiltrosListado_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Filtros" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <DataGrid x:Name="GridInventario"
                                  Grid.Row="2"
                                  VerticalAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="34"
                                  AlternatingRowBackground="#FAFBFC"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                  ColumnHeaderHeight="34"
                                  CanUserResizeColumns="True"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#1F2937"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="130"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="2*" MinWidth="140"/>
                                <DataGridTextColumn Header="P. Costo" Binding="{Binding Costo, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="P. Venta" Binding="{Binding Precio, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="P. Mayoreo" Binding="{Binding PrecioMayoreo, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="Departamento" Binding="{Binding Departamento}" Width="140"/>

                                <DataGridTemplateColumn Header="Existencia" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right">
                                                <TextBlock.Text>
                                                    <Binding Path="Stock"/>
                                                </TextBlock.Text>
                                                <TextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource ExistenciaFgConverter}">
                                                        <Binding Path="Stock"/>
                                                        <Binding Path="InvMinimo"/>
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Inv. Mínimo" Binding="{Binding InvMinimo}" Width="100"/>
                                <DataGridTextColumn Header="Inv. Máximo" Binding="{Binding InvMaximo}" Width="100"/>
                                <DataGridTextColumn Header="Tipo de venta" Binding="{Binding TipoVenta}" Width="110"/>

                                <DataGridTemplateColumn Header="" Width="52">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#xE10C;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Width="34"
                                                    Height="30"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#6B7280"
                                                    Cursor="Hand"
                                                    ToolTip="Acciones"
                                                    Click="BtnAccionesInventario_Click"
                                                    Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Paginación -->
                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtRangoMostrado"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnPagAnterior"
                                        Width="36"
                                        Height="34"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource ToolbarSecondaryBtn}"
                                        Padding="0"
                                        Click="BtnPagAnterior_Click"
                                        ToolTip="Anterior">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <StackPanel x:Name="PanelNumerosPagina" Orientation="Horizontal"/>
                                <Button x:Name="BtnPagSiguiente"
                                        Width="36"
                                        Height="34"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource ToolbarSecondaryBtn}"
                                        Padding="0"
                                        Click="BtnPagSiguiente_Click"
                                        ToolTip="Siguiente">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Mostrar" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <ComboBox x:Name="CmbItemsPorPagina"
                                          Width="110"
                                          Height="34"
                                          SelectionChanged="CmbItemsPorPagina_SelectionChanged">
                                    <ComboBoxItem Content="10 por página" Tag="10"/>
                                    <ComboBoxItem Content="20 por página" Tag="20" IsSelected="True"/>
                                    <ComboBoxItem Content="50 por página" Tag="50"/>
                                    <ComboBoxItem Content="100 por página" Tag="100"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</UserControl>
