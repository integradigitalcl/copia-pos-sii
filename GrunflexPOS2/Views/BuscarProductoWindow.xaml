<Window x:Class="GrunflexPOS2.Views.BuscarProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Búsqueda de Productos"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="BÚSQUEDA DE PRODUCTOS"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Buscador -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtBuscar"
                     Height="35"
                     VerticalContentAlignment="Center"
                     Padding="10"/>

            <Button Grid.Column="1"
                    Content="F10 - Buscar"
                    Height="35"
                    Margin="10,0,0,0"
                    Click="BtnBuscar_Click"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="dgProductos"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Descripción del producto"
                                    Binding="{Binding Nombre}"
                                    Width="*"/>

                <DataGridTextColumn Header="Precio de Venta"
                                    Binding="{Binding Precio}"
                                    Width="150"/>

                <DataGridTextColumn Header="Departamento"
                                    Binding="{Binding Departamento}"
                                    Width="150"/>

                <DataGridTextColumn Header="Inventario"
                                    Binding="{Binding Stock}"
                                    Width="120"/>
            </DataGrid.Columns>

        </DataGrid>

        <!-- Botones -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="ENTER - Aceptar"
                    Width="150"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="BtnSeleccionar_Click"/>

            <Button Content="ESC - Cancelar"
                    Width="150"
                    Height="40"
                    Click="BtnCancelar_Click"/>
        </StackPanel>

    </Grid>
</Window>
