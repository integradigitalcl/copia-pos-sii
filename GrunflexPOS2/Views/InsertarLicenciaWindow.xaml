<Window x:Class="GrunflexPOS2.Views.InsertarLicenciaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insertar licencia"
        Width="540"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="MiniTopButton" TargetType="Button" BasedOn="{StaticResource TopFlatButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryGradientBrush}" Height="36" CornerRadius="3">
            <TextBlock Text="CONFIGURACIÓN"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0"/>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,10"
                   Text="Ingrese su licencia premium (formato firmado):"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryBrush}"/>

        <TextBox x:Name="TxtLicencia"
                 Grid.Row="2"
                 Style="{StaticResource ModernTextBox}"
                 Height="40"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,8"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="Aceptar"
                    Width="110"
                    Margin="0,0,8,0"
                    Style="{StaticResource MiniTopButton}"
                    Click="BtnAceptar_Click"/>
            <Button Content="Cancelar"
                    Width="110"
                    Style="{StaticResource MiniTopButton}"
                    Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
