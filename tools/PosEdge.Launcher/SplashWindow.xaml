<Window x:Class="PosEdge.Launcher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grunflex POS"
        Width="480" Height="260"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1a2332"
        ShowInTaskbar="True">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Grunflex POS"
               FontSize="28"
               FontWeight="SemiBold"
               Foreground="White"
               HorizontalAlignment="Center" />
    <TextBlock x:Name="StatusText"
               Grid.Row="1"
               Text="Preparando sistema..."
               FontSize="16"
               Foreground="#c8d4e3"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               Margin="0,16,0,16" />
    <ProgressBar Grid.Row="2"
                 Height="6"
                 IsIndeterminate="True"
                 Foreground="#3d9cf5"
                 Background="#2a3548"
                 BorderThickness="0" />
    <TextBlock Grid.Row="3"
               Text="Por favor espere"
               FontSize="12"
               Foreground="#7a8a9e"
               HorizontalAlignment="Center"
               Margin="0,12,0,0" />
  </Grid>
</Window>
