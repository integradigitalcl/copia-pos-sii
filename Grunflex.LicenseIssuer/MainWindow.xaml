                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Empresa" Foreground="#AFC2DC" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="Grunflex" Foreground="#E2E8F0" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Email de soporte" Foreground="#AFC2DC" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="soporte@grunflex.cl" Foreground="#E2E8F0" FontSize="12"/>
                                    </Grid>

                                    <Button Height="36"
                                            Width="120"
                                            Background="#2563EB"
                                            BorderBrush="#3B82F6"
                                            BorderThickness="1"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Command="{Binding SaveSettingsCommand}"
                                            Content="Guardar cambios"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="8,0,0,0" Background="#0B1A31" CornerRadius="10" BorderBrush="#22324D" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Configuración general" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                    <TextBlock Text="URL base API (opcional)" Foreground="#AFC2DC" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBox Height="36"
                                             Margin="0,0,0,14"
                                             Background="#0F172A"
                                             Foreground="#E2E8F0"
                                             BorderBrush="#22324D"
                                             Padding="8"
                                             ToolTip="Ej. http://127.0.0.1:7279 — tiene prioridad sobre localhost por defecto."
                                             Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Validación en línea" Foreground="#E2E8F0" FontSize="12"/>
                                            <TextBlock Text="Verificar licencias en tiempo real" Foreground="#90A4C3" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Width="44"
                                                      Height="22"
                                                      IsChecked="{Binding OnlineValidation}"
                                                      Background="#2563EB"
                                                      BorderBrush="#3B82F6"
                                                      BorderThickness="1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Notificaciones" Foreground="#E2E8F0" FontSize="12"/>
                                            <TextBlock Text="Recibir alertas del sistema" Foreground="#90A4C3" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Width="44"
                                                      Height="22"
                                                      IsChecked="{Binding SystemNotifications}"
                                                      Background="#2563EB"
                                                      BorderBrush="#3B82F6"
                                                      BorderThickness="1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Respaldos automáticos" Foreground="#E2E8F0" FontSize="12"/>
                                            <TextBlock Text="Realizar respaldos diarios" Foreground="#90A4C3" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Width="44"
                                                      Height="22"
                                                      IsChecked="{Binding AutomaticBackups}"
                                                      Background="#2563EB"
                                                      BorderBrush="#3B82F6"
                                                      BorderThickness="1"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Modo mantenimiento" Foreground="#E2E8F0" FontSize="12"/>
                                            <TextBlock Text="Desactivar temporalmente el sistema" Foreground="#90A4C3" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Width="44"
                                                      Height="22"
                                                      IsChecked="{Binding MaintenanceMode}"
                                                      Background="#1F2937"
                                                      BorderBrush="#334155"
                                                      BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#0B1A31"
                                CornerRadius="10"
                                BorderBrush="#22324D"
                                BorderThickness="1"
                                Padding="14"
                                Visibility="{Binding IsConfigCorreoTab, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Configuración de correo" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Servidor SMTP" Foreground="#AFC2DC" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10"/>
                                <TextBlock Text="Puerto" Foreground="#AFC2DC" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10"/>
                                <TextBlock Text="Correo remitente" Foreground="#AFC2DC" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding SenderEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,12"/>
                                <Button Height="36"
                                        HorizontalAlignment="Left"
                                        MinWidth="160"
                                        Background="#1E293B"
                                        BorderBrush="#334155"
                                        Foreground="#E2E8F0"
                                        Content="Enviar correo de prueba"
                                        Command="{Binding TestSmtpCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Background="#0B1A31"
                                CornerRadius="10"
                                BorderBrush="#22324D"
                                BorderThickness="1"
                                Padding="14"
                                Visibility="{Binding IsConfigSeguridadTab, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Seguridad" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Políticas activas de seguridad del sistema." Foreground="#90A4C3" FontSize="11" Margin="0,0,0,10"/>
                                <CheckBox Content="Forzar cambio de contraseña cada 90 días"
                                          IsChecked="{Binding ForcePasswordRotation}"
                                          Foreground="#E2E8F0"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="Bloquear cuenta tras 5 intentos fallidos"
                                          IsChecked="{Binding LockAfterFailedAttempts}"
                                          Foreground="#E2E8F0"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="Habilitar auditoría de acciones críticas"
                                          IsChecked="{Binding EnableAuditLog}"
                                          Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Background="#0B1A31"
                                CornerRadius="10"
                                BorderBrush="#22324D"
                                BorderThickness="1"
                                Padding="14"
                                Visibility="{Binding IsConfigRespaldosTab, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Respaldos" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Frecuencia" Foreground="#AFC2DC" FontSize="11" Margin="0,0,0,6"/>
                                <ComboBox Height="36"
                                          Background="#0F172A"
                                          Foreground="#E2E8F0"
                                          BorderBrush="#22324D"
                                          BorderThickness="1"
                                          SelectedValue="{Binding BackupFrequency}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Diario" Tag="Diario"/>
                                    <ComboBoxItem Content="Semanal" Tag="Semanal"/>
                                    <ComboBoxItem Content="Mensual" Tag="Mensual"/>
                                </ComboBox>
                                <TextBlock Text="Ruta de respaldo" Foreground="#AFC2DC" FontSize="11" Margin="0,10,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Background="#0B1A31"
                                CornerRadius="10"
                                BorderBrush="#22324D"
                                BorderThickness="1"
                                Padding="14"
                                Visibility="{Binding IsConfigSistemaTab, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid MinHeight="420">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="340" MinWidth="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Sistema" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Text="Zona horaria" Foreground="#AFC2DC" FontSize="11" Margin="0,0,0,6"/>
                                        <ComboBox Height="36"
                                                  Background="#0F172A"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#22324D"
                                                  BorderThickness="1"
                                                  Margin="0,0,0,10"
                                                  SelectedValue="{Binding TimeZone}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="UTC-04:00 (Santiago)" Tag="UTC-04:00 (Santiago)"/>
                                            <ComboBoxItem Content="UTC-05:00 (Bogotá)" Tag="UTC-05:00 (Bogotá)"/>
                                        </ComboBox>
                                        <TextBlock Text="Idioma" Foreground="#AFC2DC" FontSize="11" Margin="0,0,0,6"/>
                                        <ComboBox Height="36"
                                                  Background="#0F172A"
                                                  Foreground="#E2E8F0"
                                                  BorderBrush="#22324D"
                                                  BorderThickness="1"
                                                  SelectedValue="{Binding Language}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Español" Tag="Español"/>
                                            <ComboBoxItem Content="English" Tag="English"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="24,0,0,0"
                                            Background="#08162C"
                                            CornerRadius="10"
                                            BorderBrush="#22324D"
                                            BorderThickness="1"
                                            Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Estado del equipo (esta PC)"
                                                       Foreground="#F8FAFC"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,4,0,16">
                                                <TextBlock Text="Equipo · "
                                                           Foreground="#90A4C3"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding HostMachineName}"
                                                           Foreground="#CBD5E1"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="API Grunflex en localhost"
                                                       Foreground="#AFC2DC"
                                                       FontSize="11"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding ApiHealthSummary}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,18">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ApiHealthOk}" Value="True">
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="CPU"
                                                       Foreground="#E2E8F0"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0"
                                                             Height="10"
                                                             Maximum="100"
                                                             Value="{Binding CpuPercent, Mode=OneWay}"
                                                             Background="#1E293B"
                                                             Foreground="#22C55E"/>
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Text="{Binding CpuPercentLabel}"/>
                                            </Grid>
                                            <Border Height="60"
                                                    Margin="0,0,0,18"
                                                    CornerRadius="6"
                                                    Background="#0F172A"
                                                    BorderBrush="#22324D"
                                                    BorderThickness="1"
                                                    Padding="6,4"
                                                    ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding CpuSparkline}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Bottom"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="6"
                                                                    Margin="0,0,3,0"
                                                                    VerticalAlignment="Bottom"
                                                                    CornerRadius="2"
                                                                    Background="#22C55E"
                                                                    Height="{Binding Mode=OneWay, Converter={StaticResource SparkBar56}}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                            <TextBlock Text="Memoria RAM"
                                                       Foreground="#E2E8F0"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0"
                                                             Height="10"
                                                             Maximum="100"
                                                             Value="{Binding RamPercentUsed, Mode=OneWay}"
                                                             Background="#1E293B"
                                                             Foreground="#3B82F6"/>
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Text="{Binding RamPercentLabel}"/>
                                            </Grid>
                                            <Border Height="60"
                                                    Margin="0,0,0,18"
                                                    CornerRadius="6"
                                                    Background="#0F172A"
                                                    BorderBrush="#22324D"
                                                    BorderThickness="1"
                                                    Padding="6,4"
                                                    ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding RamSparkline}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Bottom"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="6"
                                                                    Margin="0,0,3,0"
                                                                    VerticalAlignment="Bottom"
                                                                    CornerRadius="2"
                                                                    Background="#3B82F6"
                                                                    Height="{Binding Mode=OneWay, Converter={StaticResource SparkBar56}}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                            <TextBlock Text="{Binding SystemDriveCaption}"
                                                       Foreground="#E2E8F0"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0"
                                                             Height="10"
                                                             Maximum="100"
                                                             Value="{Binding DiskPercentUsed, Mode=OneWay}"
                                                             Background="#1E293B"
                                                             Foreground="#A855F7"/>
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Text="{Binding DiskPercentLabel}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="0"
                          Margin="28,24,28,28"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsGenerateLicenseSection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,28">
                    <TextBlock Text="Generar de licencias"
                               Foreground="#FFFFFF"
                               FontSize="32"
                               FontWeight="Bold"/>
                    <TextBlock Text="Cree y configure nuevas licencias para sus clientes"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Grid.Column="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#2563EB" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE77B;"
                                               Foreground="White"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Datos del cliente"
                                           Foreground="#FFFFFF"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Nombre del cliente" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid Margin="0,0,0,16">
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Padding="44,0,14,0"
                                         Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE77B;"
                                           Foreground="{StaticResource AppPlaceholder}"
                                           FontSize="15"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Ej: Juan Pérez"
                                           Foreground="{StaticResource AppPlaceholder}"
                                           Margin="48,0,14,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CustomerName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="Negocio" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Padding="44,0,14,0"
                                         Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xEC06;"
                                           Foreground="{StaticResource AppPlaceholder}"
                                           FontSize="15"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Ej: Minimarket Don Juan"
                                           Foreground="{StaticResource AppPlaceholder}"
                                           Margin="48,0,14,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BusinessName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Grid.Column="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#7C3AED" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Configuración de licencia"
                                           Foreground="#FFFFFF"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Tipo de licencia" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE787;"
                                           Foreground="{StaticResource AppPlaceholder}"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource DarkComboStyle}"
                                          Background="#E5E7EB"
                                          Foreground="#0F172A"
                                          BorderBrush="#94A3B8"
                                          SelectedValue="{Binding LicenseType}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Permanente" Tag="Permanente"/>
                                    <ComboBoxItem Content="Suscripción (mensual/anual)" Tag="Suscripción" IsSelected="True"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Seleccione modalidad de licencia." Style="{StaticResource FieldDescriptionStyle}"/>

                            <TextBlock Text="Número de cajas (dispositivos)" Style="{StaticResource FieldLabelStyle}"/>
                            <DockPanel Margin="0,0,0,4">
                                <Button Content="−" Width="40" Height="40" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource AppBorderInput}" BorderThickness="1" Command="{Binding DecreaseBoxesCommand}"/>
                                <TextBox Width="72" Margin="8,0" Text="{Binding NumberOfBoxes}" IsReadOnly="True" HorizontalContentAlignment="Center" Style="{StaticResource DarkTextBoxStyle}"/>
                                <Button Content="+" Width="40" Height="40" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource AppBorderInput}" BorderThickness="1" Command="{Binding IncreaseBoxesCommand}"/>
                            </DockPanel>
                            <TextBlock Text="Cantidad de cajas que podrá activar esta licencia." Style="{StaticResource FieldDescriptionStyle}"/>

                            <TextBlock Text="Gracia offline (días sin sync)" Style="{StaticResource FieldLabelStyle}"/>
                            <DockPanel Margin="0,0,0,4">
                                <Button Content="−" Width="40" Height="40" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource AppBorderInput}" BorderThickness="1" Command="{Binding DecreaseOfflineGraceCommand}"/>
                                <TextBox Width="72" Margin="8,0" Text="{Binding OfflineGraceDays}" IsReadOnly="True" HorizontalContentAlignment="Center" Style="{StaticResource DarkTextBoxStyle}"/>
                                <Button Content="+" Width="40" Height="40" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource AppBorderInput}" BorderThickness="1" Command="{Binding IncreaseOfflineGraceCommand}"/>
                            </DockPanel>
                            <TextBlock Text="Días que el POS puede operar sin contacto con el servidor antes de bloquearse. 0 = usa el default del POS (appsettings)." Style="{StaticResource FieldDescriptionStyle}"/>

                            <StackPanel Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Fecha de vencimiento" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker Style="{StaticResource DarkDatePickerStyle}"
                                            Background="#E5E7EB"
                                            Foreground="#0F172A"
                                            TextElement.Foreground="#0F172A"
                                            BorderBrush="#94A3B8"
                                            SelectedDate="{Binding ExpirationDate}"/>
                                <TextBlock Text="La licencia será válida hasta esta fecha." Style="{StaticResource FieldDescriptionStyle}"/>
                            </StackPanel>

                            <TextBlock Text="Estado inicial" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Style="{StaticResource DarkComboStyle}"
                                      Background="#E5E7EB"
                                      Foreground="#0F172A"
                                      BorderBrush="#94A3B8"
                                      SelectedValue="{Binding InitialStatus}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Activa" Tag="Activa"/>
                                <ComboBoxItem Content="Suspendida" Tag="Suspendida"/>
                            </ComboBox>
                            <TextBlock Text="Estado con el que se crea la licencia." Style="{StaticResource FieldDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Margin="0"
                            Background="#162442"
                            CornerRadius="12"
                            BorderBrush="#203153"
                            BorderThickness="1"
                            Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#2563EB" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Módulos y características"
                                           Foreground="#FFFFFF"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Seleccione módulos incluidos en la licencia." Foreground="#94A3B8" Margin="0,0,0,14" FontSize="13"/>

                            <Border Background="#0D1830" BorderBrush="#2A3C5E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="◉  OnlineSupport" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="Acceso a soporte técnico en línea." Foreground="#9CA3AF" FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding OnlineSupport}" Style="{StaticResource ModuleToggleStyle}"/>
                                </Grid>
                            </Border>

                            <Border Background="#0D1830" BorderBrush="#2A3C5E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="☁  CloudBackup" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="Respaldo automático en la nube." Foreground="#9CA3AF" FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding CloudBackup}" Style="{StaticResource ModuleToggleStyle}"/>
                                </Grid>
                            </Border>

                            <Border Background="#0D1830" BorderBrush="#2A3C5E" BorderThickness="1" CornerRadius="10" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="⭐  PrioritySupport" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="Soporte prioritario y respuesta rápida." Foreground="#9CA3AF" FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding PrioritySupport}" Style="{StaticResource ModuleToggleStyle}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ID de activación"
                                       Foreground="#FFFFFF"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Identificador único que usará el sistema para esta licencia."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>
                            <Grid>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Padding="14,10,44,10"
                                         IsReadOnly="True"
                                         Foreground="#E2E8F0"
                                         Text="{Binding ActivationId, Mode=OneWay}"/>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE785;"
                                           Foreground="#94A3B8"
                                           FontSize="15"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock Text="Se genera automáticamente al crear la licencia."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Token de licencia generado"
                                       Foreground="#FFFFFF"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource LicenseTokenTextBoxStyle}"
                                         IsReadOnly="True"
                                         Text="{Binding LicenseToken, Mode=OneWay}"
                                         Height="44"/>
                                <Button Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Width="44"
                                        Height="44"
                                        Style="{StaticResource SecondaryActionButton}"
                                        Command="{Binding CopyTokenCommand}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="Use este token para activar la licencia en cliente."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="3" Style="{StaticResource LicenseSummaryCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Resumen de la licencia"
                                   Foreground="#F9FAFB"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="20,18,20,16"/>

                        <Grid Grid.Row="1" Margin="20,0,20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE77B;"
                                               Foreground="#60A5FA"
                                               FontSize="18"
                                               Width="28"
                                               TextAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="Cliente:"/>
                                        <TextBlock Style="{StaticResource SummaryRowValueStyle}" Text="{Binding SummaryCustomer}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE1D2;"
                                               Foreground="#A78BFA"
                                               FontSize="18"
                                               Width="28"
                                               TextAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="Tipo:"/>
                                        <Border Style="{StaticResource SummaryBadgePurple}" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding SummaryLicenseTypeBadge}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE7F8;"
                                               Foreground="#60A5FA"
                                               FontSize="18"
                                               Width="28"
                                               TextAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="Cajas:"/>
                                        <TextBlock Style="{StaticResource SummaryRowValueStyle}" Text="{Binding SummaryBoxes}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE787;"
                                               Foreground="#60A5FA"
                                               FontSize="18"
                                               Width="28"
                                               TextAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="Vencimiento:"/>
                                        <TextBlock Style="{StaticResource SummaryRowValueStyle}" Text="{Binding SummaryExpiration}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE895;"
                                               Foreground="#34D399"
                                               FontSize="18"
                                               Width="28"
                                               TextAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="Gracia offline:"/>
                                        <TextBlock Style="{StaticResource SummaryRowValueStyle}" Text="{Binding SummaryOfflineGrace}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE713;"
                                               Foreground="#34D399"
                                               FontSize="18"
                                               Width="28"
                                               TextAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="Estado:"/>
                                        <Border Style="{StaticResource SummaryBadgeGreen}" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding SummaryStatusBadge}" Foreground="#6EE7B7" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,6,0" Width="28" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE717;" Foreground="#60A5FA" FontSize="14" VerticalAlignment="Top"/>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE734;" Foreground="#60A5FA" FontSize="11" Margin="2,2,0,0" VerticalAlignment="Top"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SummaryRowLabelStyle}" Text="Módulos:"/>
                                        <TextBlock Style="{StaticResource SummaryRowValueStyle}" Text="{Binding SummaryModules}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Button Style="{StaticResource SummarySecondaryButton}"
                                        Command="{Binding ClearCommand}"
                                        Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#E5E7EB"/>
                                        <TextBlock Text="Limpiar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SummaryPrimaryButton}"
                                        Command="{Binding GenerateCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Generar licencia" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#111827"
                                BorderBrush="#1F2937"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,12,12"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE946;"
                                               Foreground="#3B82F6"
                                               FontSize="14"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Foreground="#94A3B8"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Text="La licencia se validará automáticamente cada 24 horas desde el sistema del cliente."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,4,0">
                                    <TextBlock Text="Servidor: " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Conectado" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#34D399" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#34D399" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                                        </Border.Effect>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>

            <Border Grid.Row="0"
                    Margin="28,24,28,28"
                    CornerRadius="12"
                    Background="#0F172A"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    Visibility="{Binding IsPlaceholderSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Módulo en construcción" Foreground="#E2E8F0" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedSection}" Foreground="#60A5FA" FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
