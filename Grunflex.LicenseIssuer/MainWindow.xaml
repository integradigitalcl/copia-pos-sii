<Window x:Class="Grunflex.LicenseIssuer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Grunflex.LicenseIssuer.Converters"
        xmlns:vm="clr-namespace:Grunflex.LicenseIssuer.ViewModels"
        mc:Ignorable="d"
        Title="Grunflex License Issuer"
        Width="1700"
        Height="980"
        MinWidth="1550"
        MinHeight="900"
        WindowStartupLocation="CenterScreen"
        Background="#111827"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <conv:PercentToSparklineBarHeightConverter x:Key="SparkBar56" MaxHeight="56"/>

        <SolidColorBrush x:Key="AppBgMain" Color="#111827"/>
        <SolidColorBrush x:Key="AppBgSidebar" Color="#0A0E1A"/>
        <SolidColorBrush x:Key="AppBgCard" Color="#1A2235"/>
        <SolidColorBrush x:Key="AppBorder" Color="#1E293B"/>
        <SolidColorBrush x:Key="AppBorderInput" Color="#334155"/>
        <SolidColorBrush x:Key="AppPlaceholder" Color="#475569"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="#D1DBEA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2740"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBgCard}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="#CBD5E1"/>
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="#CBD5E1"/>
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="TextElement.Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="#CBD5E1"/>
                    <Setter Property="TextElement.Foreground" Value="#CBD5E1"/>
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#2C3D57"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>

        <Style x:Key="ModuleToggleStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd"
                                Width="24"
                                Height="24"
                                CornerRadius="7"
                                BorderBrush="#365074"
                                BorderThickness="1"
                                Background="#0C1A31">
                            <TextBlock x:Name="Mark"
                                       Text="✔"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E68ED"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A83FF"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryBadgeBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SummaryBadgePurple" TargetType="Border" BasedOn="{StaticResource SummaryBadgeBase}">
            <Setter Property="Background" Value="#5B21B6"/>
            <Setter Property="BorderBrush" Value="#7C3AED"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SummaryBadgeGreen" TargetType="Border" BasedOn="{StaticResource SummaryBadgeBase}">
            <Setter Property="Background" Value="#064E3B"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LicenseSummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SummaryRowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SummaryRowValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SummarySecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="148"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="168"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LicenseTokenTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLicenseToken}" Value="True">
                    <Setter Property="Foreground" Value="#22C55E"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBgMain}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource AppBgSidebar}" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,20">
                    <TextBlock Text="Grunflex Li"
                               Foreground="#FFFFFF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="Grunflex License Issuer"/>
                    <TextBlock Text="Versión 1.0.0"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <Button Click="NavDashboard_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Dashboard">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Dashboard">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Dashboard">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Dashboard">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="NavLicencias_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Licencias">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Licencias">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Licencias">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Licencias">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="NavGenerar_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="GenerarLicencia">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="GenerarLicencia">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Generar licencia">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="GenerarLicencia">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="NavClientes_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Clientes">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Clientes">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Clientes">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Clientes">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="NavActivaciones_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Activaciones">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F8;" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Activaciones">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Activaciones">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Activaciones">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="NavReportes_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Reportes">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Reportes">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Reportes">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Reportes">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Click="NavConfiguracion_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Configuracion">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Configuracion">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Configuración">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSection}" Value="Configuracion">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="16,12,16,12"
                  Visibility="{Binding IsDashboardSection, Converter={StaticResource BoolToVisibility}}">
                <Border CornerRadius="12" Padding="16" Background="#08162C" BorderBrush="#1B2A45" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Dashboard" Foreground="#F8FAFC" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Resumen general del sistema" Foreground="#90A4C3" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0B1A31" CornerRadius="8" BorderBrush="#22324D" BorderThickness="1" Padding="12,7" Height="36" VerticalAlignment="Top" MinWidth="220">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DashboardPeriodLabel}" Foreground="#D7E2F3" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Foreground="#D7E2F3" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10" Padding="12" BorderBrush="#22314A" BorderThickness="1" Background="#0B1A31">
                                <StackPanel>
                                    <TextBlock Text="Licencias activas" Foreground="#9FB3CD" FontSize="11"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DashboardActiveLicenses}" Foreground="#F8FAFC" FontSize="36" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE8D7;" Foreground="#4F8CFF" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DashboardKpiActiveCaption}" Foreground="#7890AF" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="8,0" CornerRadius="10" Padding="12" BorderBrush="#22314A" BorderThickness="1" Background="#0B1A31">
                                <StackPanel>
                                    <TextBlock Text="Licencias vencidas" Foreground="#9FB3CD" FontSize="11"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DashboardExpiredLicenses}" Foreground="#F8FAFC" FontSize="36" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE783;" Foreground="#EF4444" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DashboardKpiExpiredCaption}" Foreground="#7890AF" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Margin="8,0" CornerRadius="10" Padding="12" BorderBrush="#22314A" BorderThickness="1" Background="#0B1A31">
                                <StackPanel>
                                    <TextBlock Text="Activaciones" Foreground="#9FB3CD" FontSize="11"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DashboardActivations}" Foreground="#F8FAFC" FontSize="36" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE8FB;" Foreground="#34D399" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DashboardKpiActivationCaption}" Foreground="#7890AF" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Margin="8,0,0,0" CornerRadius="10" Padding="12" BorderBrush="#22314A" BorderThickness="1" Background="#0B1A31">
                                <StackPanel>
                                    <TextBlock Text="Clientes" Foreground="#9FB3CD" FontSize="11"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DashboardClients}" Foreground="#F8FAFC" FontSize="36" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Foreground="#A855F7" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding DashboardKpiClientsCaption}" Foreground="#7890AF" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10" Padding="12" BorderBrush="#22314A" BorderThickness="1" Background="#0B1A31">
                                <StackPanel>
                                    <TextBlock Text="Altas de licencia (últimos 6 meses)" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,6"/>
                                    <Canvas Height="170">
                                        <Polyline Points="{Binding DashboardSparklinePoints}"
                                                  Stroke="#2563EB"
                                                  StrokeThickness="3"/>
                                        <TextBlock Text="{Binding DashboardSparkAxisText}"
                                                   Foreground="#7F93AF"
                                                   FontSize="10"
                                                   Canvas.Left="16"
                                                   Canvas.Top="146"/>
                                    </Canvas>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="10" Padding="12" BorderBrush="#22314A" BorderThickness="1" Background="#0B1A31">
                                <StackPanel>
                                    <TextBlock Text="Distribución por plan" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="Licencias activas por tipo" Foreground="#7890AF" FontSize="10" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding PlanDistribution}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#64748B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Label}" Value="Básico"><Setter Property="Fill" Value="#3B82F6"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Label}" Value="Medium"><Setter Property="Fill" Value="#10B981"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Label}" Value="Plus"><Setter Property="Fill" Value="#8B5CF6"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Label}" Value="Otros"><Setter Property="Fill" Value="#F59E0B"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#D7E2F3" FontSize="12" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DetailText}" Foreground="#9FB3CD" FontSize="11" HorizontalAlignment="Right"/>
                                                        <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" Margin="0,4,0,0" Background="#1E293B">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar">
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Label}" Value="Básico"><Setter Property="Foreground" Value="#3B82F6"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Label}" Value="Medium"><Setter Property="Foreground" Value="#10B981"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Label}" Value="Plus"><Setter Property="Foreground" Value="#8B5CF6"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Label}" Value="Otros"><Setter Property="Foreground" Value="#F59E0B"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10" Padding="12" BorderBrush="#22314A" BorderThickness="1" Background="#0B1A31">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Actividad reciente" Foreground="#E2E8F0" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="Ver todos" Foreground="#3B82F6" FontSize="11"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding DashboardAuditLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#D3DFF3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="10" Padding="12" BorderBrush="#22314A" BorderThickness="1" Background="#0B1A31">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Alertas" Foreground="#E2E8F0" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="Ver todas" Foreground="#3B82F6" FontSize="11"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding DashboardAlerts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MainViewModel+DashboardAlertItem}">
                                                    <TextBlock Text="{Binding Text}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:MainViewModel+DashboardAlertSeverity.Danger}">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:MainViewModel+DashboardAlertSeverity.Warning}">
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:MainViewModel+DashboardAlertSeverity.Info}">
                                                                        <Setter Property="Foreground" Value="#3B82F6"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="0"
                  Margin="16,12,16,12"
                  Visibility="{Binding IsLicenciasSection, Converter={StaticResource BoolToVisibility}}">
                <Border CornerRadius="12" Padding="16" Background="#08162C" BorderBrush="#1B2A45" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Licencias" Foreground="#F8FAFC" FontSize="31" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LicensesSubtitle}" Foreground="#90A4C3" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="1" Background="#0B1A31" CornerRadius="8" BorderBrush="#22324D" BorderThickness="1" Padding="10,7" Height="36" MinWidth="190" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#95A7C3" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#95A7C3"
                                             FontSize="11"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding LicenseSearch, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Buscar licencia..."
                                               Foreground="#617A99"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LicenseSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <ComboBox Grid.Column="2"
                                      Width="168"
                                      Height="36"
                                      Margin="0,0,10,0"
                                      Background="#0F172A"
                                      Foreground="#E2E8F0"
                                      BorderBrush="#22324D"
                                      Padding="8,6"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{Binding LicenseFilterOptions}"
                                      SelectedItem="{Binding LicenseStatusFilter, Mode=TwoWay}"
                                      ToolTip="Filtrar licencias"/>

                            <Button Grid.Column="3"
                                    Height="36"
                                    MinWidth="96"
                                    Margin="0,0,10,0"
                                    Background="#0B1A31"
                                    BorderBrush="#22324D"
                                    BorderThickness="1"
                                    Foreground="#E2E8F0"
                                    Command="{Binding RefreshLicensesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE149;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Actualizar" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4"
                                    Height="36"
                                    MinWidth="126"
                                    Background="#2563EB"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="12,0"
                                    Click="NavGenerar_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Generar licencia" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="2" CornerRadius="10" BorderBrush="#22324D" BorderThickness="1" Background="#0B1A31">
                            <DataGrid ItemsSource="{Binding Licenses}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowBackground="#0D1B33"
                                      AlternatingRowBackground="#0B1930"
                                      Foreground="#E2E8F0"
                                      HorizontalGridLinesBrush="#1E2B44"
                                      VerticalGridLinesBrush="#1E2B44">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#0E1B33"/>
                                        <Setter Property="Foreground" Value="#9FB3CD"/>
                                        <Setter Property="BorderBrush" Value="#1E2B44"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                        <Setter Property="BorderBrush" Value="#1E2B44"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID Licencia" Binding="{Binding LicenseId}" Width="120"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding Client}" Width="*"/>
                                    <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="80"/>
                                    <DataGridTextColumn Header="Cajas" Binding="{Binding Boxes}" Width="56"/>
                                    <DataGridTemplateColumn Header="Estado" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,2" CornerRadius="8" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#14532D"/>
                                                            <Setter Property="BorderBrush" Value="#166534"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Vencida">
                                                                    <Setter Property="Background" Value="#7F1D1D"/>
                                                                    <Setter Property="BorderBrush" Value="#991B1B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Próxima a vencer">
                                                                    <Setter Property="Background" Value="#78350F"/>
                                                                    <Setter Property="BorderBrush" Value="#92400E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#86EFAC"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Vencida">
                                                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Próxima a vencer">
                                                                        <Setter Property="Foreground" Value="#FCD34D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Vencimiento" Binding="{Binding Expiration}" Width="95"/>
                                    <DataGridTextColumn Header="Creación" Binding="{Binding CreatedAt}" Width="95"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="&#xE8A7;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            ToolTip="Ver token"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#93C5FD"
                                                            Padding="4"
                                                            Command="{Binding DataContext.ViewLicenseTokenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="&#xE70F;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            ToolTip="Copiar token"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#86EFAC"
                                                            Padding="4"
                                                            Command="{Binding DataContext.CopyLicenseRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="&#xE74D;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            ToolTip="Eliminar"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#FCA5A5"
                                                            Padding="4"
                                                            Command="{Binding DataContext.DeleteLicenseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LicensesPagingSummary}" Foreground="#90A4C3" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE72B;"
                                        FontFamily="Segoe MDL2 Assets"
                                        ToolTip="Anterior"
                                        Background="#1E293B"
                                        Foreground="#CBD5E1"
                                        BorderBrush="#334155"
                                        Padding="8,4"
                                        Margin="0,0,8,0"
                                        Command="{Binding PrevLicensePageCommand}"/>
                                <Border Background="#1D4ED8" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Foreground="White" FontSize="11">
                                        <Run Text="{Binding LicensePage, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalLicensePages, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Button Content="&#xE72A;"
                                        FontFamily="Segoe MDL2 Assets"
                                        ToolTip="Siguiente"
                                        Background="#1E293B"
                                        Foreground="#CBD5E1"
                                        BorderBrush="#334155"
                                        Padding="8,4"
                                        Command="{Binding NextLicensePageCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="0"
                  Margin="16,12,16,12"
                  Visibility="{Binding IsClientesSection, Converter={StaticResource BoolToVisibility}}">
                <Border CornerRadius="12" Padding="16" Background="#08162C" BorderBrush="#1B2A45" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Clientes" Foreground="#F8FAFC" FontSize="31" FontWeight="SemiBold"/>
                            <TextBlock Text="Lista de clientes registrados" Foreground="#90A4C3" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="1" Background="#0B1A31" CornerRadius="8" BorderBrush="#22324D" BorderThickness="1" Padding="10,7" Height="36" MinWidth="190" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#95A7C3" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#95A7C3"
                                             FontSize="11"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Buscar cliente..."
                                               Foreground="#617A99"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClientSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Button Grid.Column="2"
                                    Height="36"
                                    MinWidth="126"
                                    Background="#2563EB"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="12,0"
                                    Click="NuevoCliente_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nuevo cliente" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="2" CornerRadius="10" BorderBrush="#22324D" BorderThickness="1" Background="#0B1A31">
                            <DataGrid ItemsSource="{Binding Clients}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowBackground="#0D1B33"
                                      AlternatingRowBackground="#0B1930"
                                      Foreground="#E2E8F0"
                                      HorizontalGridLinesBrush="#1E2B44"
                                      VerticalGridLinesBrush="#1E2B44">
