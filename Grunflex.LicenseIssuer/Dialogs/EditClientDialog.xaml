<Window x:Class="Grunflex.LicenseIssuer.Dialogs.EditClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliente"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#111827"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Nombre" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtName" Height="34" Margin="0,0,0,10" Background="#0F172A" Foreground="#F9FAFB" BorderBrush="#334155" Padding="8"/>

        <TextBlock Text="Negocio" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtBusiness" Height="34" Margin="0,0,0,10" Background="#0F172A" Foreground="#F9FAFB" BorderBrush="#334155" Padding="8"/>

        <TextBlock Text="Email" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtEmail" Height="34" Margin="0,0,0,10" Background="#0F172A" Foreground="#F9FAFB" BorderBrush="#334155" Padding="8"/>

        <TextBlock Text="Teléfono" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtPhone" Height="34" Margin="0,0,0,14" Background="#0F172A" Foreground="#F9FAFB" BorderBrush="#334155" Padding="8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="100" Margin="0,0,8,0" Padding="8,6" Click="Cancel_Click" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155"/>
            <Button Content="Guardar" Width="100" Padding="8,6" Click="Ok_Click" IsDefault="True" Background="#2563EB" Foreground="White" BorderBrush="#3B82F6"/>
        </StackPanel>
    </StackPanel>
</Window>
