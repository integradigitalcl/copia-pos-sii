<Window x:Class="Grunflex.LicenseIssuer.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrada"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#111827"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Lbl" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="Txt"
                 Grid.Row="1"
                 Height="36"
                 Background="#0F172A"
                 Foreground="#F9FAFB"
                 BorderBrush="#334155"
                 Padding="8"
                 Margin="0,0,0,14"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    Width="100"
                    Margin="0,0,8,0"
                    Padding="8,6"
                    Click="Cancel_Click"
                    Background="#1E293B"
                    Foreground="#E2E8F0"
                    BorderBrush="#334155"/>
            <Button Content="Aceptar"
                    Width="100"
                    Padding="8,6"
                    Click="Ok_Click"
                    IsDefault="True"
                    Background="#2563EB"
                    Foreground="White"
                    BorderBrush="#3B82F6"/>
        </StackPanel>
    </Grid>
</Window>
